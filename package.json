{
  "name": "family-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/validate.mjs && node scripts/validate-meal-privacy.mjs",
    "check": "astro check",
    "build": "astro build",
    "audit": "node scripts/audit.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only database --project family-hub-rules \"node --test tests/household-rules.emulator.mjs\"",
    "test:browser": "playwright test",
    "verify": "pnpm run validate && pnpm run check && pnpm run build && pnpm run audit && pnpm run test:unit && pnpm run test:rules && pnpm run test:browser",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "astro": "^5.12.8",
    "firebase": "^12.1.0",
    "typescript": "^5.8.3",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "@playwright/test": "^1.62.1",
    "firebase-tools": "14.16.0"
  }
}
