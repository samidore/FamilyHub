---
interface LibraryEvent { day: string; dayOrder: number; time: string; timeOrder: number; name: string; library: string; location: string; drive: string; age: string; ageGroup: string; description: string; registration: string; badges: string[]; googleMapsUrl: string; officialUrl: string; }
const { event } = Astro.props as { event: LibraryEvent };
const searchable = [event.name, event.library, event.location, event.age, event.ageGroup, event.description, event.registration, ...event.badges].join(' ').toLocaleLowerCase();
const driveMin = Number(event.drive.match(/\d+/)?.[0] ?? 999);
---
<article class="event-card" data-event data-search={searchable} data-day={event.day} data-day-order={event.dayOrder} data-time-order={event.timeOrder} data-library={event.library} data-age={event.ageGroup} data-drive={driveMin}>
  <div class="event-time"><span>{event.day}</span><strong>{event.time}</strong></div>
  <div class="event-body">
    <h2>{event.name}</h2><p class="event-library">{event.library}</p>
    <dl class="event-details"><div><dt>Location</dt><dd>{event.location} · {event.drive}</dd></div><div><dt>Age</dt><dd>{event.age}</dd></div><div><dt>Description</dt><dd>{event.description}</dd></div><div><dt>Registration</dt><dd>{event.registration}</dd></div></dl>
    {event.badges.length > 0 && <div class="badges event-badges">{event.badges.map((badge) => <span class="badge badge--warm">{badge}</span>)}</div>}
    <div class="actions"><a class="button button--blue" href={event.googleMapsUrl} target="_blank" rel="noreferrer">Google Maps</a><a class="button button--blue-outline" href={event.officialUrl} target="_blank" rel="noreferrer">Activity / library site</a></div>
  </div>
</article>
