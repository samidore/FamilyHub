<script>
  function enhanceMealBuilderNavigation() {
    const targetSection = document.querySelector<HTMLElement>('.meal-targets');
    if (targetSection && !targetSection.querySelector(':scope > [data-meal-target-fold]')) {
      const heading = targetSection.querySelector<HTMLElement>(':scope > .meal-section-heading');
      const grid = targetSection.querySelector<HTMLElement>(':scope > .meal-target-grid');
      const reset = heading?.querySelector<HTMLButtonElement>('#meal-reset');
      const stepActions = document.querySelector<HTMLElement>('#meal-builder-view > .meal-step-actions');
      if (grid) {
        if (reset && stepActions) {
          reset.classList.add('meal-target-reset');
          stepActions.append(reset);
        }
        heading?.querySelector('#meal-targets-heading')?.removeAttribute('id');
        heading?.remove();

        const fold = document.createElement('details');
        fold.className = 'meal-target-fold';
        fold.dataset.mealTargetFold = 'true';

        const summary = document.createElement('summary');
        summary.className = 'meal-target-fold__summary';
        const label = document.createElement('span');
        label.className = 'meal-target-fold__label';
        const title = document.createElement('strong');
        title.id = 'meal-targets-heading';
        title.textContent = '组餐目标';
        const primary = document.createElement('small');
        primary.dataset.mealTargetSummaryPrimary = 'true';
        const secondary = document.createElement('small');
        secondary.dataset.mealTargetSummarySecondary = 'true';
        label.append(title, primary, secondary);
        const action = document.createElement('span');
        action.className = 'meal-target-fold__action';
        action.innerHTML = '<span>修改</span><span aria-hidden="true">⌄</span>';
        summary.append(label, action);

        fold.append(summary, grid);
        targetSection.append(fold);

        const protein = document.querySelector<HTMLSelectElement>('#meal-protein');
        const vegetable = document.querySelector<HTMLSelectElement>('#meal-vegetable');
        const time = document.querySelector<HTMLSelectElement>('#meal-time');
        const staple = document.querySelector<HTMLInputElement>('#meal-staple');
        const child = document.querySelector<HTMLInputElement>('#meal-child');
        const syncTargetSummary = () => {
          const timeLabel = time?.selectedOptions[0]?.textContent?.trim() || time?.value || '不限';
          primary.textContent = `Protein ${protein?.value ?? '—'} · Vegetable ${vegetable?.value ?? '—'} · ${timeLabel}`;
          secondary.textContent = `Staple ${staple?.checked ? '✓' : '—'} · 孩子一起吃 ${child?.checked ? '✓' : '—'}`;
        };
        syncTargetSummary();
        targetSection.addEventListener('change', syncTargetSummary);

        const progress = document.querySelector<HTMLElement>('.meal-progress');
        const recipeGrid = document.querySelector<HTMLElement>('#meal-recipe-grid');
        const summaryObserver = new MutationObserver(syncTargetSummary);
        if (progress) summaryObserver.observe(progress, { childList: true, characterData: true, subtree: true, attributes: true, attributeFilter: ['hidden'] });
        if (recipeGrid) summaryObserver.observe(recipeGrid, { childList: true, subtree: true, attributes: true, attributeFilter: ['hidden'] });

        const builder = document.querySelector<HTMLElement>('#meal-builder-view');
        if (builder) {
          new MutationObserver(() => { if (!builder.hidden) fold.open = false; }).observe(builder, { attributes: true, attributeFilter: ['hidden'] });
        }
        document.querySelectorAll<HTMLElement>('#meal-start-current, [data-step-target="recipes"], #meal-back-to-menu').forEach((control) => {
          control.addEventListener('click', () => { fold.open = false; });
        });
      }
    }

    const ingredientSection = document.querySelector<HTMLElement>('.meal-ingredients');
    if (ingredientSection && !ingredientSection.querySelector(':scope > [data-meal-ingredient-fold]')) {
      const existingChildren = [...ingredientSection.childNodes];
      const fold = document.createElement('details');
      fold.className = 'meal-ingredient-overall-fold';
      fold.dataset.mealIngredientFold = 'true';

      const summary = document.createElement('summary');
      summary.id = 'meal-ingredient-overall-summary';
      summary.className = 'meal-ingredient-overall-fold__summary';

      const label = document.createElement('span');
      const title = document.createElement('strong');
      title.textContent = '可用食材';
      const hint = document.createElement('small');
      hint.textContent = '展开筛选';
      label.append(title, hint);

      const count = document.createElement('span');
      count.className = 'meal-count';
      count.dataset.mealIngredientFoldCount = 'true';
      count.textContent = '已选 0';
      summary.append(label, count);

      fold.append(summary, ...existingChildren);
      fold.querySelectorAll<HTMLDetailsElement>('details[data-ingredient-section]').forEach((section) => {
        section.open = true;
      });
      ingredientSection.append(fold);
      ingredientSection.setAttribute('aria-labelledby', summary.id);

      const sourceCount = fold.querySelector<HTMLElement>('#meal-ingredient-count');
      const syncCount = () => { count.textContent = sourceCount?.textContent?.trim() || '已选 0'; };
      syncCount();
      if (sourceCount) new MutationObserver(syncCount).observe(sourceCount, { childList: true, characterData: true, subtree: true });

      const builder = document.querySelector<HTMLElement>('#meal-builder-view');
      if (builder) {
        new MutationObserver(() => { if (!builder.hidden) fold.open = false; }).observe(builder, { attributes: true, attributeFilter: ['hidden'] });
      }
      document.querySelectorAll<HTMLElement>('#meal-start-current, [data-step-target="recipes"], #meal-back-to-menu').forEach((control) => {
        control.addEventListener('click', () => { fold.open = false; });
      });
    }

    const inventoryView = document.querySelector<HTMLElement>('#meal-inventory-view');
    const inventoryList = document.querySelector<HTMLElement>('#meal-inventory-list');
    if (!inventoryView || !inventoryList || inventoryView.querySelector(':scope > [data-inventory-jump-nav]')) return;

    const nav = document.createElement('nav');
    nav.className = 'meal-inventory-jump-nav';
    nav.dataset.inventoryJumpNav = 'true';
    nav.setAttribute('aria-label', '库存类型跳转');
    nav.hidden = true;
    const track = document.createElement('div');
    track.className = 'meal-inventory-jump-nav__track';
    nav.append(track);
    inventoryView.append(nav);

    const inventoryJumpLabels: Record<string, string> = {
      pork: '猪',
      chicken: '鸡',
      duck: '鸭',
      beef: '牛',
      'lamb-goat': '羊',
      fish: '鱼',
      shellfish: '海鲜',
      'egg-tofu': '蛋豆腐',
      'leafy-vegetable': '叶菜',
      'other-vegetable': '蔬菜',
      mushroom: '菌菇',
      staple: '主食',
      extra: '点心',
    };

    let signature = '';
    const syncInventoryJumpNav = () => {
      const groups = [...inventoryList.querySelectorAll<HTMLDetailsElement>('details[data-inventory-section]')];
      const entries = groups.flatMap((group) => {
        const id = group.dataset.inventorySection;
        if (!id) return [];
        const fullLabel = group.querySelector<HTMLElement>('summary strong')?.textContent?.trim() || id;
        const label = inventoryJumpLabels[id] ?? fullLabel;
        return [{ id, label, fullLabel }];
      });
      nav.hidden = entries.length === 0;
      track.style.setProperty('--meal-inventory-jump-columns', String(Math.max(1, Math.ceil(entries.length / 2))));
      const nextSignature = entries.map(({ id, label }) => `${id}:${label}`).join('|');
      if (nextSignature === signature) return;
      signature = nextSignature;
      track.replaceChildren();

      entries.forEach(({ id, label, fullLabel }) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.inventoryJump = id;
        button.textContent = label;
        button.setAttribute('aria-label', `跳至${fullLabel}`);
        button.addEventListener('click', () => {
          const target = inventoryList.querySelector<HTMLDetailsElement>(`details[data-inventory-section="${CSS.escape(id)}"]`);
          if (!target) return;
          target.open = true;
          requestAnimationFrame(() => target.scrollIntoView({ behavior: 'smooth', block: 'start' }));
        });
        track.append(button);
      });
    };

    new MutationObserver(syncInventoryJumpNav).observe(inventoryList, { childList: true });
    syncInventoryJumpNav();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', enhanceMealBuilderNavigation, { once: true });
  else enhanceMealBuilderNavigation();
</script>

<style is:global>
  .meal-targets { margin-bottom: 22px; }
  .meal-target-fold { border: 0; }
  .meal-target-fold > summary { list-style: none; }
  .meal-target-fold > summary::-webkit-details-marker { display: none; }
  .meal-target-fold__summary {
    display: flex;
    min-height: 74px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 14px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: color-mix(in srgb, var(--surface) 90%, var(--berry-soft));
    cursor: pointer;
  }
  .meal-target-fold__label { display: grid; min-width: 0; gap: 2px; }
  .meal-target-fold__label strong { color: var(--ink); font-size: 20px; line-height: 1.2; }
  .meal-target-fold__label small { color: var(--muted); font-size: 13px; font-weight: 700; line-height: 1.25; }
  .meal-target-fold__action { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 5px; color: var(--berry); font-size: 14px; font-weight: 800; }
  .meal-target-fold__action > span:last-child { display: inline-block; font-size: 18px; transition: transform .15s ease; }
  .meal-target-fold[open] .meal-target-fold__action > span:last-child { transform: rotate(180deg); }
  .meal-target-fold[open] > .meal-target-fold__summary { border-color: color-mix(in srgb, var(--berry) 35%, var(--line)); background: var(--berry-soft); }
  .meal-target-fold > .meal-target-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 8px; padding: 12px; border-radius: 14px; box-shadow: none; }
  .meal-target-fold > .meal-target-grid > .meal-toggle { grid-column: 1 / -1; min-height: 58px; }
  .meal-target-fold > .meal-target-grid select { min-width: 0; padding-inline: 8px; }
  .meal-step-actions .meal-target-reset { margin-left: auto; }

  .meal-ingredient-overall-fold { border: 0; }
  .meal-ingredient-overall-fold > summary { list-style: none; }
  .meal-ingredient-overall-fold > summary::-webkit-details-marker { display: none; }
  .meal-ingredient-overall-fold__summary {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: color-mix(in srgb, var(--surface) 88%, var(--berry-soft));
    cursor: pointer;
  }
  .meal-ingredient-overall-fold__summary > span:first-child { display: flex; min-width: 0; flex-direction: column; gap: 2px; }
  .meal-ingredient-overall-fold__summary small { color: var(--muted); font-size: .86rem; font-weight: 600; }
  .meal-ingredient-overall-fold[open] > .meal-ingredient-overall-fold__summary { margin-bottom: 16px; }

  .meal-builder-page #meal-inventory-view {
    padding-bottom: calc(126px + env(safe-area-inset-bottom, 0px));
  }
  .meal-inventory-jump-nav {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 50;
    margin: 0;
    padding: 8px clamp(10px, 3vw, 24px) calc(8px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid color-mix(in srgb, var(--line) 85%, transparent);
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    box-shadow: 0 -8px 24px color-mix(in srgb, var(--ink) 8%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    pointer-events: none;
  }
  .meal-inventory-jump-nav__track {
    display: grid;
    width: min(100%, 680px);
    grid-template-columns: repeat(var(--meal-inventory-jump-columns, 1), minmax(0, 1fr));
    gap: 6px;
    margin-inline: auto;
    padding: 2px;
    overflow: visible;
  }
  .meal-inventory-jump-nav button {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 6px 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: clamp(14px, 3.6vw, 17px);
    font-weight: 700;
    line-height: 1.1;
    white-space: nowrap;
    cursor: pointer;
    pointer-events: auto;
  }
  .meal-inventory-jump-nav button:focus-visible { outline: 3px solid color-mix(in srgb, var(--berry) 70%, white); outline-offset: 2px; }
  .meal-inventory-group { scroll-margin-top: calc(env(safe-area-inset-top, 0px) + 64px); }

  @media (max-width: 560px) {
    .meal-target-fold__summary { min-height: 70px; padding: 10px 12px; }
    .meal-target-fold__label strong { font-size: 19px; }
    .meal-target-fold__label small { font-size: 12px; }
    .meal-target-fold > .meal-target-grid { padding: 10px; }
    .meal-target-fold > .meal-target-grid > label:not(.meal-toggle) { gap: 3px; font-size: 12px; }
  }
</style>