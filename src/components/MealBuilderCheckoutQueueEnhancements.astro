    const finalize = target.closest<HTMLButtonElement>('#meal-finalize-checkout');
    if (finalize) {
      event.preventDefault(); event.stopImmediatePropagation(); if (!canWrite()) return; const drafts = allDrafts(); let outcome: ReturnType<typeof applyQueuedCheckoutComposition> | null = null;
      if (queueOnlyCheckout) {
        void repository.transaction((state) => { outcome = applyPendingOnlyCheckout(state, drafts); return outcome.state; }).then((next) => { household = next; if (outcome?.committed) { leaveQueueOnlyCheckout(); announce('待结算已完成。'); } else announce(outcome?.reason === 'invalid-consumption' ? '库存或实际用量已经变化，请重新核对。' : '待结算状态已经变化，请重新进入结算。'); scheduleRender(); }).catch((error) => announce(error instanceof Error ? error.message : '结算失败。'));
      } else {
        const meal = household.currentMeal; if (!meal) return; void repository.transaction((state) => { outcome = applyQueuedCheckoutComposition(state, meal.mealId, drafts, ingredients, { recipes, optionalGroups, nextMealId: createMealId(), completedAt: Date.now() }); return outcome.state; }).then((next) => { household = next; if (outcome?.committed) announce('排队餐和本顿已一起结算。'); else announce(outcome?.reason === 'invalid-consumption' ? '库存或实际用量已经变化，请重新核对。' : '本顿状态已经变化，请重新进入结算。'); scheduleRender(); }).catch((error) => announce(error instanceof Error ? error.message : '结算失败。'));
      }
    }
  }, true);

  document.addEventListener('change', (event) => { if (!household.pendingCheckoutMeals.length || (!queueOnlyCheckout && household.activeStep !== 'checkout')) return; const input = (event.target as HTMLElement).closest<HTMLInputElement>('[data-queue-used-up-meal]'); if (!input) return; event.stopImmediatePropagation(); const all = allDrafts(); const mealId = input.dataset.queueUsedUpMeal!; const drafts = cloneDrafts(all[mealId] ?? {}); const draft = drafts[input.dataset.queueUsedUpRecipe!]; if (!draft) return; draft.consumption[input.dataset.queueUsedUpIngredient!] = input.checked; void persistActual(mealId, drafts); }, true);

  repository.subscribe((next, status) => { household = next; repositoryStatus = status; scheduleRender(); });
  window.addEventListener('pagehide', () => repository.dispose(), { once: true });
  ensureQueueUi(); scheduleRender();
</script>

