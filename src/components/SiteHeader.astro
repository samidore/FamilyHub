---
import ModuleIcon from './ModuleIcon.astro';
import type { ModuleAccent, ModuleIcon as IconName } from '../config/modules';
interface Props { eyebrow: string; title: string; description: string; accent: ModuleAccent; icon: IconName; }
const { eyebrow, title, description, accent, icon } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<header class:list={['module-hero', `theme-${accent}`]}>
  <div class="shell">
    <nav class="module-nav" aria-label="页面导航"><a class="back-link" href={base}>← Family Hub</a></nav>
    <div class="module-hero__grid">
      <div class="field-tab"><ModuleIcon icon={icon} /><span>{eyebrow}</span></div>
      <div class="module-hero__copy">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p>{description}</p>
        <slot />
      </div>
    </div>
  </div>
</header>
