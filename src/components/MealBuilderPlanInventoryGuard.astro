<script>
  import {
    optionalGroupsForRecipe,
    type MealIngredient,
    type MealOptionalGroup,
    type MealRecipe,
  } from '../lib/mealEngine';
  import {
    availableIngredientIds,
    reconcileCurrentMeal,
    type CurrentMeal,
    type HouseholdState,
  } from '../lib/household';
  import { createHouseholdRepository, type RepositoryStatus } from '../lib/householdRepository';

  type Payload = {
    ingredients: MealIngredient[];
    optionalGroups: MealOptionalGroup[];
    recipes: (MealRecipe & { nameZh?: string })[];
  };
  type DraftAddon = { addonType: string; ingredientId: string };

  const source = document.querySelector<HTMLScriptElement>('#meal-recipe-selection-data');
  const firebaseSource = document.querySelector<HTMLScriptElement>('#meal-firebase-config');
  if (!source || !firebaseSource) throw new Error('Meal plan inventory guard bootstrap data is missing.');

  const payload = JSON.parse(source.textContent || '{}') as Payload;
  const firebaseConfig = JSON.parse(firebaseSource.textContent || '{}') as Record<string, string>;
  const ingredients = payload.ingredients;
  const recipes = payload.recipes;
  const optionalGroups = payload.optionalGroups;
  const ingredientById = new Map(ingredients.map((ingredient) => [ingredient.id, ingredient]));
  const recipeById = new Map(recipes.map((recipe) => [recipe.id, recipe]));
  const repository = createHouseholdRepository(firebaseConfig, { ingredients, recipes, firebase: { ingredients, recipes } });

  let household: HouseholdState = repository.getSnapshot();
  let repositoryStatus: RepositoryStatus = repository.getStatus();
  let refreshQueued = false;
  let bypassConfirmOnce = false;

  const live = document.querySelector<HTMLElement>('#meal-live');
  const canWrite = () => repositoryStatus.connection === 'local' || repositoryStatus.connection === 'connected';
  const nameFor = (id: string) => ingredientById.get(id)?.nameZh ?? id;
  const announce = (text: string) => {
    if (!live) return;
    live.textContent = '';
    requestAnimationFrame(() => { live.textContent = text; });
  };

  function selectableIds(state: HouseholdState, meal: CurrentMeal) {
    const liveIds = new Set(availableIngredientIds(state.inventory, ingredients));
    const excluded = new Set(meal.excludedIngredientIds ?? []);
    return new Set(meal.availableIngredientIds.filter((id) => liveIds.has(id) && !excluded.has(id)));
  }

  function persistedOptional(meal: CurrentMeal, recipeId: string, groupId: string, ingredientId: string) {
    return meal.selectedAddons.some((addon) =>
      addon.mainRecipeId === recipeId && addon.addonType === groupId && addon.ingredientId === ingredientId
    );
  }

  function choiceAllowed(button: HTMLButtonElement, state = household) {
    const meal = state.currentMeal;
    if (!meal) return false;
    const recipeId = button.dataset.recipeDraftBinding ?? button.dataset.recipeDraftOptional;
    const ingredientId = button.dataset.recipeDraftBindingIngredient ?? button.dataset.recipeDraftOptionalIngredient;
    if (!recipeId || !ingredientId) return false;
    if (selectableIds(state, meal).has(ingredientId)) return true;

    // An already-saved unavailable choice remains visible only while it is still pressed,
    // so the user can remove it. Once removed, it cannot be re-selected without stock.
    if (button.getAttribute('aria-pressed') !== 'true' || !meal.selectedRecipeIds.includes(recipeId)) return false;

    if (button.dataset.recipeDraftBinding) {
      const index = Number(button.dataset.recipeDraftBindingIndex);
      return meal.recipeIngredientBindings[recipeId]?.[index] === ingredientId;
    }
    return persistedOptional(
      meal,
      recipeId,
      button.dataset.recipeDraftOptionalGroup ?? '',
      ingredientId,
    );
  }

  function refreshDraftChoices() {
    document.querySelectorAll<HTMLButtonElement>('[data-recipe-draft-binding], [data-recipe-draft-optional]').forEach((button) => {
      const allowed = choiceAllowed(button);
      button.hidden = !allowed;
      button.toggleAttribute('data-live-inventory-blocked', !allowed);
    });
  }

  function scheduleRefresh() {
    if (refreshQueued) return;
    refreshQueued = true;
    requestAnimationFrame(() => {
      refreshQueued = false;
      refreshDraftChoices();
    });
  }

  function draftBindings(editor: HTMLElement, recipe: MealRecipe) {
    return recipe.requirements.map((requirement, index) => {
      if (requirement.anyOf.length === 1) return requirement.anyOf[0];
      return editor.querySelector<HTMLButtonElement>(
        `[data-recipe-draft-binding-index="${index}"][aria-pressed="true"]`
      )?.dataset.recipeDraftBindingIngredient ?? null;
    });
  }

  function draftOptionals(editor: HTMLElement): DraftAddon[] {
    return [...editor.querySelectorAll<HTMLButtonElement>('[data-recipe-draft-optional][aria-pressed="true"]')]
      .flatMap((button) => {
        const addonType = button.dataset.recipeDraftOptionalGroup;
        const ingredientId = button.dataset.recipeDraftOptionalIngredient;
        return addonType && ingredientId ? [{ addonType, ingredientId }] : [];
      });
  }

  function blockedPressedIngredient(editor: HTMLElement) {
    const blocked = editor.querySelector<HTMLButtonElement>(
      '[data-live-inventory-blocked][aria-pressed="true"]'
    );
    return blocked?.dataset.recipeDraftBindingIngredient ?? blocked?.dataset.recipeDraftOptionalIngredient ?? '';
  }

  async function confirmWithLiveInventory(confirm: HTMLButtonElement) {
    if (!canWrite()) return;
    const editor = confirm.closest<HTMLElement>('[data-recipe-plan-draft]');
    const recipeId = editor?.dataset.recipePlanDraft;
    const recipe = recipeId ? recipeById.get(recipeId) : undefined;
    const expectedMealId = household.currentMeal?.mealId;
    const mode: 'new' | 'edit' = confirm.textContent?.includes('修改') ? 'edit' : 'new';
    if (!editor || !recipe || !expectedMealId) return;

    // A live inventory update can invalidate a choice after the draft was opened.
    // Reject that visibly stale pressed choice before any write. The transaction below
    // repeats the inventory check to cover a change that races with this preflight.
    refreshDraftChoices();
    const blockedIngredient = blockedPressedIngredient(editor);
    if (blockedIngredient) {
      announce(`库存里现在没有${nameFor(blockedIngredient)}，不能选。`);
      scheduleRefresh();
      return;
    }

    const proposedBindings = draftBindings(editor, recipe);
    const proposedOptionals = draftOptionals(editor);
    let accepted = false;
    let rejectedIngredient = '';

    try {
      const next = await repository.transaction((state) => {
        accepted = false;
        rejectedIngredient = '';
        const meal = state.currentMeal;
        if (!meal || meal.mealId !== expectedMealId || state.activeStep !== 'recipes') return state;

        const alreadySelected = meal.selectedRecipeIds.includes(recipe.id);
        if ((mode === 'new' && alreadySelected) || (mode === 'edit' && !alreadySelected)) return state;

        const selectable = selectableIds(state, meal);
        const priorBindings = meal.recipeIngredientBindings[recipe.id] ?? [];
        const bindings = recipe.requirements.map((requirement, index) => {
          const ingredientId = proposedBindings[index];
          if (!ingredientId || !requirement.anyOf.includes(ingredientId)) return null;
          const mayKeepSaved = mode === 'edit' && priorBindings[index] === ingredientId;
          if (!selectable.has(ingredientId) && !mayKeepSaved) rejectedIngredient ||= ingredientId;
          return selectable.has(ingredientId) || mayKeepSaved ? ingredientId : null;
        });
        if (bindings.some((id) => id === null)) return state;

        const cleanBindings = bindings.filter((id): id is string => Boolean(id));
        const boundIds = new Set(cleanBindings);
        const savedOptionalKeys = new Set(
          meal.selectedAddons
            .filter((addon) => addon.mainRecipeId === recipe.id)
            .map((addon) => `${addon.addonType}\u0000${addon.ingredientId}`)
        );

        for (const addon of proposedOptionals) {
          if (boundIds.has(addon.ingredientId)) return state;
          const group = optionalGroupsForRecipe(recipe, optionalGroups).find((candidate) => candidate.id === addon.addonType);
          if (!group?.ingredients.some((entry) => entry.ingredientId === addon.ingredientId)) return state;
          const mayKeepSaved = mode === 'edit' && savedOptionalKeys.has(`${addon.addonType}\u0000${addon.ingredientId}`);
          if (!selectable.has(addon.ingredientId) && !mayKeepSaved) {
            rejectedIngredient ||= addon.ingredientId;
            return state;
          }
        }

        const selectedAddons = [
          ...meal.selectedAddons.filter((addon) => addon.mainRecipeId !== recipe.id),
          ...proposedOptionals.map((addon) => ({ mainRecipeId: recipe.id, ...addon })),
        ];
        const selectedRecipeIds = alreadySelected ? meal.selectedRecipeIds : [...meal.selectedRecipeIds, recipe.id];
        const currentMeal = reconcileCurrentMeal({
          ...meal,
          selectedRecipeIds,
          recipeIngredientBindings: { ...meal.recipeIngredientBindings, [recipe.id]: cleanBindings },
          selectedAddons,
          checkoutDraft: {},
          checkoutRecipeDrafts: {},
        }, recipes, ingredients, optionalGroups);

        accepted = true;
        return { ...state, currentMeal };
      });

      household = next;
      if (!accepted) {
        announce(rejectedIngredient
          ? `库存里现在没有${nameFor(rejectedIngredient)}，不能选。`
          : '本顿状态已经变化，请重新打开这道菜。');
        scheduleRefresh();
        return;
      }

      // Let the existing selection component clear its local draft and keep its normal success copy.
      const activeConfirm = document.querySelector<HTMLButtonElement>(
        `[data-recipe-plan-draft="${CSS.escape(recipe.id)}"] [data-confirm-recipe-draft]`
      ) ?? confirm;
      if (activeConfirm.isConnected) {
        bypassConfirmOnce = true;
        activeConfirm.click();
      } else {
        announce(mode === 'new' ? '已加入一道菜。' : '已更新这道菜。');
      }
    } catch (error) {
      announce(error instanceof Error ? error.message : '选菜保存失败。');
    }
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const choice = target.closest<HTMLButtonElement>('[data-recipe-draft-binding], [data-recipe-draft-optional]');
    if (choice && !choiceAllowed(choice)) {
      event.preventDefault();
      event.stopImmediatePropagation();
      const ingredientId = choice.dataset.recipeDraftBindingIngredient ?? choice.dataset.recipeDraftOptionalIngredient ?? '';
      announce(`库存里现在没有${nameFor(ingredientId)}，不能选。`);
      scheduleRefresh();
      return;
    }

    const confirm = target.closest<HTMLButtonElement>('[data-confirm-recipe-draft]');
    if (!confirm) return;
    if (bypassConfirmOnce) {
      bypassConfirmOnce = false;
      return;
    }
    event.preventDefault();
    event.stopImmediatePropagation();
    void confirmWithLiveInventory(confirm);
  }, true);

  repository.subscribe((next, status) => {
    household = next;
    repositoryStatus = status;
    scheduleRefresh();
  });

  const observer = new MutationObserver(() => scheduleRefresh());
  observer.observe(document.body, { childList: true, subtree: true });
  scheduleRefresh();

  window.addEventListener('pagehide', () => {
    observer.disconnect();
    repository.dispose();
  }, { once: true });
</script>
