---
import ModuleIcon from './ModuleIcon.astro';
import type { ModuleDefinition } from '../config/modules';
// `title` replaces the module title, e.g. one card per novel in 小离总周报.
interface Props { module: ModuleDefinition; href: string; title?: string; count?: number; verifiedDate?: string; }
const { module, href, title = module.title, count, verifiedDate } = Astro.props;
const searchText = [title, module.title, module.summary, ...module.keywords].join(' ').toLocaleLowerCase();
const authenticated = module.privacyClass === 'authenticated-household';
const privateLabel = module.id === 'novel-archive' ? '私人资料' : '家庭共享';
---
<a class:list={['module-card', `theme-${module.accent}`]} href={href} data-module data-category={module.categoryId} data-search={searchText}>
  <span class="module-card__tab" aria-hidden="true"><ModuleIcon icon={module.icon} /></span>
  <span class="module-card__body">
    <span class="module-card__heading"><strong>{title}</strong><span aria-hidden="true">→</span></span>
    <span class="module-card__summary">{module.summary}</span>
    <span class="module-card__meta">
      {authenticated ? <><b>{privateLabel}</b><span>需要登录</span></> : <><b>{count ?? 0}{module.itemLabel}</b><span>{verifiedDate ? `资料核实 ${verifiedDate}` : '核实日期未记录'}</span></>}
    </span>
  </span>
</a>
