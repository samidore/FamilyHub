    min-width: 0;
    padding-inline: 0 !important;
    justify-self: center;
  }
  .meal-builder-page .meal-stock-row [data-stock-delta="-0.5"] { grid-column: 2; }
  .meal-builder-page .meal-stock-row output {
    width: var(--meal-stock-value-width);
    min-width: 0;
    grid-column: 3;
    justify-self: center;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .meal-builder-page .meal-stock-row [data-stock-delta="0.5"] { grid-column: 4; }
  .meal-builder-page .meal-batch-row > span:first-child {
    min-width: 0;
    grid-column: 1;
  }
  .meal-builder-page .meal-batch-row [data-discard-stock] {
    grid-column: 5;
  }
  .meal-builder-page .meal-thaw-job__actions {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    gap: 7px;
  }
  .meal-builder-page .meal-thaw-job {
    display: grid !important;
    width: 100%;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr) auto !important;
    align-items: center;
    gap: 8px 10px !important;
  }
  .meal-builder-page .meal-thaw-job__info { min-width: 0; }
  @media (max-width: 560px) {
    .meal-builder-page .meal-thaw-job { grid-template-columns: minmax(0, 1fr) !important; }
    .meal-builder-page .meal-thaw-job__actions { justify-content: flex-start; }
  }

  .meal-builder-page .meal-inventory-item[hidden],
  .meal-builder-page .meal-inventory-group[hidden],
  .meal-builder-page .meal-storage-block[hidden],
  .meal-builder-page .meal-thaw-jobs[hidden] {
    display: none !important;
  }

  .meal-builder-page .meal-inventory-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    margin: 10px 0 16px;
  }
  .meal-builder-page .meal-inventory-tabs button {
    min-width: 0;
    min-height: 48px;
    padding: 8px 6px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.1;
    white-space: nowrap;
    cursor: pointer;
  }
  .meal-builder-page .meal-inventory-tabs button.is-active {
    border-color: var(--ink, #332a2e);
    background: var(--ink, #332a2e);
    color: white;
  }
  .meal-builder-page [data-inventory-legacy-toggle] { display: none !important; }
  .meal-builder-page .meal-inventory-view-empty { margin: 12px 0 0; }
  @media (max-width: 380px) {
    .meal-builder-page .meal-inventory-tabs { gap: 4px; }
    .meal-builder-page .meal-inventory-tabs button { padding-inline: 4px; font-size: 13px; }
  }
</style>
