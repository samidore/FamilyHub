    grid-template-columns: minmax(0, 1fr) !important;
    align-items: stretch !important;
    gap: 12px !important;
  }
  .meal-builder-page .meal-inventory-name {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
  }
  .meal-builder-page .meal-stock-states.meal-inventory-controls {
    --meal-stock-control-width: 2.75rem;
    --meal-stock-value-width: 2.25rem;
    --meal-stock-action-width: 4rem;
    --meal-stock-gap: 6px;
    display: grid !important;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr) !important;
    gap: 10px !important;
  }
  .meal-builder-page .meal-storage-block,
  .meal-builder-page .meal-thaw-jobs {
    display: grid;
    min-width: 0;
    gap: 7px;
  }
  .meal-builder-page .meal-storage-block + .meal-storage-block,
  .meal-builder-page .meal-thaw-jobs {
    padding-top: 8px;
    border-top: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .meal-builder-page .meal-storage-header,
  .meal-builder-page .meal-stock-row {
    display: grid !important;
    width: 100%;
    min-width: 0;
    grid-template-columns:
      minmax(0, 1fr)
      var(--meal-stock-control-width)
      var(--meal-stock-value-width)
      var(--meal-stock-control-width)
      var(--meal-stock-action-width) !important;
    align-items: center !important;
    gap: var(--meal-stock-gap) !important;
  }
  .meal-builder-page .meal-storage-header strong {
    min-width: 0;
    grid-column: 1;
  }
  .meal-builder-page .meal-storage-action {
    width: var(--meal-stock-action-width);
    min-width: 0;
    padding-inline: 0.25rem !important;
    justify-self: center;
  }
  .meal-builder-page .meal-storage-header .meal-storage-action,
  .meal-builder-page .meal-stock-correction-row .meal-storage-action {
    grid-column: 5;
  }
  .meal-builder-page .meal-storage-inline-label {
    min-width: 0;
