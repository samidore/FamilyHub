<script>
  type InventoryLayoutIngredient = {
    id: string;
    inventoryTracking?: 'counted' | 'presence-only';
    inventoryFreshness?: string;
    freezerBehavior?: 'direct' | 'thaw-required';
  };

  function enhanceMealInventoryStorageBlocks() {
    const inventoryList = document.querySelector<HTMLElement>('#meal-inventory-list');
    const dataNode = document.querySelector<HTMLScriptElement>('#meal-data');
    if (!inventoryList || !dataNode) return;

    let parsed: { ingredients?: InventoryLayoutIngredient[] } = {};
    try { parsed = JSON.parse(dataNode.textContent || '{}'); } catch { return; }
    const ingredientById = new Map((parsed.ingredients ?? []).map((item) => [item.id, item]));

    const quantityFromRow = (row?: HTMLElement | null) => {
      const value = Number(row?.querySelector<HTMLOutputElement>('output')?.textContent ?? 0);
      return Number.isFinite(value) ? value : 0;
    };

    const intakeFor = (elements: HTMLElement[], storage: 'inventory' | 'freezer') =>
      elements.find((element) => element.matches(`button[data-stock-add][data-stock-storage="${storage}"]`)) as HTMLButtonElement | undefined;

    const setOutputDomain = (output: HTMLOutputElement, domain: 'inventory' | 'freezer', ingredientId: string) => {
      if (domain === 'inventory') {
        output.dataset.inventoryValue = ingredientId;
        delete output.dataset.freezerValue;
      } else {
        output.dataset.freezerValue = ingredientId;
        delete output.dataset.inventoryValue;
      }
    };

    const storageLabel = (storage: 'inventory' | 'freezer') => {
      const label = document.createElement('span');
      label.className = 'sr-only';
      label.textContent = storage === 'freezer' ? '冷冻' : '冷藏';
      return label;
    };

    const makeCorrectionRow = (
      ingredientId: string,
      storage: 'inventory' | 'freezer',
      quantity: number,
      valueDomain: 'inventory' | 'freezer',
    ) => {
      const row = document.createElement('div');
      row.className = 'meal-stock-row meal-stock-correction-row';
      row.dataset.storageControlRow = storage;

      const minus = document.createElement('button');
      minus.type = 'button';
      minus.textContent = '−';
      minus.dataset.stockDelta = '-0.5';
      minus.dataset.stockStorage = storage;
      minus.dataset.stockItem = ingredientId;
      minus.disabled = quantity <= 0;

      const output = document.createElement('output');
      setOutputDomain(output, valueDomain, ingredientId);
      output.textContent = String(quantity);

      const plus = document.createElement('button');
      plus.type = 'button';
      plus.textContent = '+';
      plus.dataset.stockDelta = '0.5';
      plus.dataset.stockStorage = storage;
      plus.dataset.stockItem = ingredientId;

      row.append(storageLabel(storage), minus, output, plus);
      return row;
    };

    const cleanAggregateRow = (
      row: HTMLElement,
      storage: 'inventory' | 'freezer',
      valueDomain: 'inventory' | 'freezer',
      ingredientId: string,
    ) => {
      row.classList.add('meal-stock-correction-row');
      row.dataset.storageControlRow = storage;
      const label = row.querySelector<HTMLElement>(':scope > span:first-child');
      if (label && /^(冷藏|冷冻)/.test(label.textContent?.trim() ?? '')) {
        label.className = 'sr-only';
        label.textContent = storage === 'freezer' ? '冷冻' : '冷藏';
      } else if (!label?.classList.contains('sr-only')) {
        row.prepend(storageLabel(storage));
      }
      const output = row.querySelector<HTMLOutputElement>('output');
      if (output) setOutputDomain(output, valueDomain, ingredientId);
      return row;
    };

    const makeHeader = (label: string, quantity: number | null, action?: HTMLElement) => {
      const header = document.createElement('div');
      header.className = 'meal-storage-header';
      const title = document.createElement('strong');
      title.textContent = quantity === null ? label : `${label} ${quantity}`;
      header.append(title);
      if (action) {
        action.classList.add('meal-storage-action', 'meal-storage-intake');
        header.append(action);
      }
      return header;
    };

    const prepareThawAction = (
      ingredientId: string,
      quantity: number,
      thawButtons: HTMLButtonElement[],
    ) => {
      const targetQuantity = quantity >= 1 ? '1' : quantity >= 0.5 ? '0.5' : null;
      const action = targetQuantity
        ? thawButtons.find((button) => button.dataset.thawQuantity === targetQuantity)
        : undefined;

      if (action) {
        action.textContent = '化冻';
        action.classList.add('meal-storage-action');
        action.dataset.thawAction = ingredientId;
      }

      const hiddenAlternatives = thawButtons.filter((button) => button !== action);
      hiddenAlternatives.forEach((button) => {
        button.hidden = true;
        button.tabIndex = -1;
        button.setAttribute('aria-hidden', 'true');
      });

      if (action) return { action, hiddenAlternatives };

      const disabled = document.createElement('button');
      disabled.type = 'button';
      disabled.textContent = '化冻';
      disabled.disabled = true;
      disabled.className = 'meal-storage-action';
      disabled.dataset.thawAction = ingredientId;
      return { action: disabled, hiddenAlternatives };
    };

    const makeCountedBlock = (
      ingredientId: string,
      storage: 'inventory' | 'freezer',
      quantity: number,
      row: HTMLElement | undefined,
      intake: HTMLButtonElement | undefined,
      thawRequired: boolean,
      valueDomain: 'inventory' | 'freezer',
    ) => {
      const block = document.createElement('section');
      block.className = 'meal-storage-block';
      block.dataset.storageBlock = storage;

      const controlRow = row
        ? cleanAggregateRow(row, storage, valueDomain, ingredientId)
        : makeCorrectionRow(ingredientId, storage, quantity, valueDomain);
      const thawButtons = storage === 'freezer'
        ? [...controlRow.querySelectorAll<HTMLButtonElement>('[data-start-thaw]')]
        : [];
      thawButtons.forEach((button) => button.remove());

      if (storage === 'freezer') {
        const label = controlRow.querySelector<HTMLElement>(':scope > span:first-child');
        if (label) {
          label.className = 'meal-storage-inline-label';
          label.textContent = '冷冻';
        }

        if (thawRequired) {
          const { action, hiddenAlternatives } = prepareThawAction(ingredientId, quantity, thawButtons);
          controlRow.append(action);
          block.append(controlRow, ...hiddenAlternatives);
        } else {
          if (intake) {
            intake.classList.add('meal-storage-action', 'meal-storage-intake');
            controlRow.append(intake);
          }
          block.append(controlRow);
        }
        return block;
      }

      block.append(makeHeader('冷藏', quantity, intake), controlRow);
      return block;
    };

    const makePresenceBlock = (
      storage: 'inventory' | 'freezer',
      present: boolean,
      toggle: HTMLButtonElement | undefined,
    ) => {
      const block = document.createElement('section');
      block.className = 'meal-storage-block';
      block.dataset.storageBlock = storage;
      if (toggle) toggle.classList.add('meal-storage-action', 'meal-storage-intake');
      block.append(makeHeader(`${storage === 'freezer' ? '冷冻' : '冷藏'}${present ? ' · 有' : ''}`, null, toggle));
      return block;
    };

    const prepareBatchBlock = (host: HTMLElement, intake?: HTMLButtonElement) => {
      host.classList.add('meal-storage-block', 'meal-storage-block--batches');
      host.dataset.storageBlock = 'inventory';
      const heading = host.querySelector<HTMLElement>(':scope > strong');
      const batchRows = [...host.querySelectorAll<HTMLElement>(':scope > [data-batch-key]')];
      const total = batchRows.reduce((sum, row) => sum + quantityFromRow(row), 0);
      const header = makeHeader('冷藏', total, intake);
      heading?.remove();
      batchRows.forEach((row) => {
        row.classList.add('meal-batch-row');
        const discard = row.querySelector<HTMLButtonElement>('[data-discard-stock]');
        if (discard) {
          discard.textContent = '丢掉';
          discard.classList.add('meal-storage-action');
        }
      });
      host.prepend(header);
      return host;
    };

    const prepareThawJobs = (rows: HTMLElement[]) => {
      if (!rows.length) return null;
      const host = document.createElement('section');
      host.className = 'meal-thaw-jobs';
      rows.forEach((row) => {
        row.classList.add('meal-thaw-job');
        const buttons = [...row.querySelectorAll<HTMLButtonElement>('button')];
        const text = [...row.childNodes]
          .filter((node) => node.nodeType === Node.TEXT_NODE)
          .map((node) => node.textContent ?? '')
          .join('')
          .trim();
        const info = document.createElement('span');
        info.className = 'meal-thaw-job__info';
        info.textContent = text;
        const actions = document.createElement('span');
        actions.className = 'meal-thaw-job__actions';
        actions.append(...buttons);
        row.replaceChildren(info, actions);
        host.append(row);
      });
      return host;
    };

    const enhanceCard = (card: HTMLElement) => {
      if (card.dataset.storageBlocksEnhanced === 'true') return;
      const ingredientId = card.dataset.inventoryItem;
      const meta = ingredientId ? ingredientById.get(ingredientId) : undefined;
      const states = card.querySelector<HTMLElement>(':scope > .meal-stock-states');
      if (!ingredientId || !meta || !states) return;

      const children = [...states.children] as HTMLElement[];
      const thawRows = children.filter((element) =>
        element.classList.contains('meal-stock-row') && Boolean(element.querySelector('[data-complete-thaw], [data-cancel-thaw]')),
      );
      const aggregateRows = children.filter((element) =>
        element.classList.contains('meal-stock-row') && !thawRows.includes(element),
      );
      const fifoHost = children.find((element) =>
        !element.classList.contains('meal-stock-row') &&
        (Boolean(element.querySelector(':scope > [data-batch-key]')) || element.querySelector(':scope > strong')?.textContent?.trim().startsWith('冷藏')),
      );
      const looseButtons = children.filter((element) => element.matches('button'));
      const allLoose = [...looseButtons];
      if (fifoHost) allLoose.push(...fifoHost.querySelectorAll<HTMLElement>(':scope > button'));

      const coldRow = aggregateRows.find((row) => row.querySelector<HTMLElement>(':scope > span:first-child')?.textContent?.trim().startsWith('冷藏'));
      const frozenRow = aggregateRows.find((row) => row.querySelector<HTMLElement>(':scope > span:first-child')?.textContent?.trim().startsWith('冷冻'));
      const coldIntake = intakeFor(allLoose, 'inventory');
      const frozenIntake = intakeFor(allLoose, 'freezer');
      const looseToggle = looseButtons.find((element) => element.matches('[data-stock-toggle]')) as HTMLButtonElement | undefined;

      const rebuilt: HTMLElement[] = [];
      const tracking = meta.inventoryTracking ?? 'counted';
      const direct = meta.freezerBehavior === 'direct';
      const thawRequired = meta.freezerBehavior === 'thaw-required';

      if (direct) {
        if (tracking === 'presence-only') {
          const toggle = frozenRow?.querySelector<HTMLButtonElement>('[data-stock-toggle]') ?? looseToggle;
          rebuilt.push(makePresenceBlock('freezer', Boolean(frozenRow), toggle));
        } else {
          rebuilt.push(makeCountedBlock(ingredientId, 'freezer', quantityFromRow(frozenRow), frozenRow, frozenIntake, false, 'inventory'));
        }
      } else {
        if (tracking === 'presence-only') {
          const toggle = coldRow?.querySelector<HTMLButtonElement>('[data-stock-toggle]') ?? looseToggle;
          rebuilt.push(makePresenceBlock('inventory', Boolean(coldRow), toggle));
        } else if (fifoHost) {
          const embeddedIntake = fifoHost.querySelector<HTMLButtonElement>(':scope > button[data-stock-add][data-stock-storage="inventory"]') ?? coldIntake;
          rebuilt.push(prepareBatchBlock(fifoHost, embeddedIntake));
        } else {
          rebuilt.push(makeCountedBlock(ingredientId, 'inventory', quantityFromRow(coldRow), coldRow, coldIntake, false, 'inventory'));
        }

        if (meta.freezerBehavior) {
          if (tracking === 'presence-only') {
            const frozenToggle = frozenRow?.querySelector<HTMLButtonElement>('[data-stock-toggle]') ?? undefined;
            rebuilt.push(makePresenceBlock('freezer', Boolean(frozenRow), frozenToggle));
          } else {
            rebuilt.push(makeCountedBlock(ingredientId, 'freezer', quantityFromRow(frozenRow), frozenRow, frozenIntake, thawRequired, 'freezer'));
          }
        }
      }

      const thawJobs = prepareThawJobs(thawRows);
      if (thawJobs) rebuilt.push(thawJobs);
      states.replaceChildren(...rebuilt);
      card.dataset.storageBlocksEnhanced = 'true';
    };

    let scheduled = false;
    const sync = () => {
      scheduled = false;
      inventoryList.querySelectorAll<HTMLElement>('[data-inventory-item]').forEach(enhanceCard);
    };
    const schedule = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(sync);
    };

    new MutationObserver(schedule).observe(inventoryList, { childList: true, subtree: true });
    sync();
  }

  type InventoryView = 'cold' | 'freezer' | 'combined' | 'all';

  function enhanceMealInventoryViews() {
    const inventoryList = document.querySelector<HTMLElement>('#meal-inventory-list');
    const showAllToggle = document.querySelector<HTMLInputElement>('#meal-show-all');
    const legacyToggle = showAllToggle?.closest<HTMLElement>('.meal-inventory-toggle');
    if (!inventoryList || !showAllToggle || !legacyToggle || document.querySelector('[data-inventory-view-tabs]')) return;

    legacyToggle.hidden = true;
    legacyToggle.dataset.inventoryLegacyToggle = 'true';

    const tabs = document.createElement('div');
    tabs.className = 'meal-inventory-tabs';
    tabs.dataset.inventoryViewTabs = 'true';
    tabs.setAttribute('role', 'group');
    tabs.setAttribute('aria-label', '库存视图');

    const options: { id: InventoryView; label: string }[] = [
      { id: 'cold', label: '冷藏' },
      { id: 'freezer', label: '冷冻' },
      { id: 'combined', label: '冷藏+冷冻' },
      { id: 'all', label: '全部' },
    ];
    let activeView: InventoryView = 'cold';

    const buttons = new Map<InventoryView, HTMLButtonElement>();
    options.forEach(({ id, label }) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.inventoryTab = id;
      button.textContent = label;
      button.setAttribute('aria-pressed', 'false');
      tabs.append(button);
      buttons.set(id, button);
    });
    legacyToggle.before(tabs);

    const blockHasStock = (block: HTMLElement | null) => {
      if (!block) return false;
      const outputs = [...block.querySelectorAll<HTMLOutputElement>('output')];
      if (outputs.some((output) => Number(output.textContent ?? 0) > 0)) return true;
      const toggle = block.querySelector<HTMLButtonElement>('[data-stock-toggle]');
      return toggle?.textContent?.trim() === '移除';
    };

    const emptyCopy: Record<InventoryView, string> = {
      cold: '当前没有冷藏库存。',
      freezer: '当前没有冷冻库存或化冻中的食材。',
      combined: '当前没有冷藏、冷冻库存或化冻中的食材。',
      all: '当前没有可显示的食材。',
    };

    const syncTabs = () => {
      buttons.forEach((button, id) => {
        const active = id === activeView;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    };

    let scheduled = false;
    const sync = () => {
      scheduled = false;
      const cards = [...inventoryList.querySelectorAll<HTMLElement>('[data-inventory-item]')];
      if (cards.some((card) => card.dataset.storageBlocksEnhanced !== 'true')) {
        requestAnimationFrame(schedule);
        return;
      }

      let visibleCount = 0;
      cards.forEach((card) => {
        const coldBlock = card.querySelector<HTMLElement>('[data-storage-block="inventory"]');
        const freezerBlock = card.querySelector<HTMLElement>('[data-storage-block="freezer"]');
        const thawJobs = card.querySelector<HTMLElement>('.meal-thaw-jobs');
        const hasCold = blockHasStock(coldBlock);
        const hasFrozen = blockHasStock(freezerBlock);
        const hasThaw = Boolean(thawJobs?.querySelector('.meal-thaw-job'));

        if (coldBlock) coldBlock.hidden = activeView === 'freezer';
        if (freezerBlock) freezerBlock.hidden = activeView === 'cold';
        if (thawJobs) thawJobs.hidden = activeView === 'cold';

        const visible =
          activeView === 'all' ? true :
          activeView === 'cold' ? hasCold :
          activeView === 'freezer' ? hasFrozen || hasThaw :
          hasCold || hasFrozen || hasThaw;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      inventoryList.querySelectorAll<HTMLDetailsElement>('details[data-inventory-section]').forEach((group) => {
        group.hidden = ![...group.querySelectorAll<HTMLElement>('[data-inventory-item]')].some((card) => !card.hidden);
      });

      let empty = inventoryList.querySelector<HTMLElement>('[data-inventory-view-empty]');
      if (visibleCount === 0) {
        if (cards.length === 0) {
          [...inventoryList.childNodes].forEach((node) => {
            if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) node.remove();
          });
        }
        if (!empty) {
          empty = document.createElement('p');
          empty.className = 'empty-state meal-inventory-view-empty';
          empty.dataset.inventoryViewEmpty = 'true';
          inventoryList.append(empty);
        }
        if (empty.textContent !== emptyCopy[activeView]) empty.textContent = emptyCopy[activeView];
        empty.hidden = false;
      } else if (empty) {
        empty.remove();
      }
    };

    const schedule = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(sync);
    };

    buttons.forEach((button, id) => {
      button.addEventListener('click', () => {
        if (activeView === id) return;
        activeView = id;
        syncTabs();
        const showAll = activeView === 'all';
        if (showAllToggle.checked !== showAll) {
          showAllToggle.checked = showAll;
          showAllToggle.dispatchEvent(new Event('change', { bubbles: true }));
        }
        schedule();
      });
    });

    showAllToggle.addEventListener('change', () => {
      if (showAllToggle.checked) activeView = 'all';
      else if (activeView === 'all') activeView = 'cold';
      syncTabs();
      schedule();
    });

    new MutationObserver(schedule).observe(inventoryList, { childList: true, subtree: true });
    syncTabs();
    sync();
  }

  const enhanceMealInventory = () => {
    enhanceMealInventoryStorageBlocks();
    enhanceMealInventoryViews();
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', enhanceMealInventory, { once: true });
  else enhanceMealInventory();
</script>

<style is:global>
