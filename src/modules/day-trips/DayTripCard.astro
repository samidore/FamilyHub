---
import type { DayTrip } from '../../data/types';

const { destination: d } = Astro.props as { destination: DayTrip };

const activityLabels = {
  'woody-walk': '森系遛猫',
  playground: '麦攀爬',
  'indoor-visit': '室内赶鸡',
  animals: '动物园',
  'water-play': '玩水',
  aquarium: 'Aquarium',
  'pick-your-own': '摘棉花',
} as const;

const originalTags = [...new Set(d.locations.flatMap((location) => location.tags))];
const noPlayground = d.locations.every((location) => !location.tags.includes('playground'));
const searchable = [
  d.name,
  ...(d.aliases ?? []),
  d.city,
  d.state,
  ...d.locations.map((location) => location.name),
  ...originalTags,
  ...originalTags.map((tag) => activityLabels[tag]),
  ...(noPlayground ? ['no-playground', '麦不上天'] : []),
].join(' ').toLocaleLowerCase();
---

<article
  class="record-card trip-card"
  data-destination
  data-id={d.id}
  data-name={d.name}
  data-drive={d.driveMinutes}
  data-search={searchable}
  data-locations={JSON.stringify(d.locations)}
  data-no-playground={noPlayground ? 'true' : 'false'}
  data-reaction-rank="2"
  data-reaction-ups="0"
>
  <div class="record-card__top">
    <h2>{d.name}</h2>
    <p class="location-line">{d.city}, {d.state} <span aria-hidden="true">·</span> 约 {d.driveMinutes} 分钟</p>

    <div class="trip-hours" aria-label="今日营业时间">
      <strong>今天</strong>
      <div class="trip-hours__list">
        {d.locations.map((location, index) => (
          <span data-location-hours data-location-index={index}>
            <b>{location.name}</b> · <span data-hours-value>载入中…</span>
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="record-card__body">
    <div class="tags trip-tags" aria-label="活动标签">
      {originalTags.map((tag) => <span data-activity-tag={tag}>{activityLabels[tag]}</span>)}
      {noPlayground && <span data-derived-activity="no-playground">麦不上天</span>}
    </div>

    <p class="trip-note">{d.note}</p>

    {d.notice && (
      <section class="info-block info-block--before trip-notice">
        <h3>运营提醒</h3>
        <p>{d.notice}</p>
      </section>
    )}

    <section class="trip-household-interactions" aria-label="家庭评价">
      <div class="trip-reactions">
        <div class="trip-reaction-buttons">
          <button type="button" data-trip-reaction="up" aria-label={`赞成 ${d.name}`} aria-pressed="false" disabled>👍</button>
          <button type="button" data-trip-reaction="down" aria-label={`不赞成 ${d.name}`} aria-pressed="false" disabled>👎</button>
        </div>
        <div class="trip-reaction-people" data-trip-reaction-people aria-label="家庭成员评价"></div>
      </div>
      <div class="trip-comments" data-trip-comments></div>
    </section>

    <div class="actions">
      <a class="button button--primary" href={d.googleMapsUrl} target="_blank" rel="noopener noreferrer">Google Maps</a>
      <a class="button button--secondary" href={d.officialUrl} target="_blank" rel="noopener noreferrer">Official website</a>
    </div>
    <p class="verification-note">资料核实：{d.verifiedDate}</p>
  </div>
</article>

<style>
  .trip-hours { display: grid; gap: 5px; margin-top: 16px; padding: 11px 12px; border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--line)); border-radius: 10px; background: rgb(255 255 255 / 78%); }
  .trip-hours > strong { color: var(--accent); font-size: 14px; }
  .trip-hours__list { display: grid; gap: 3px; color: #35433a; font-size: 15px; }
  .trip-hours__list b { font-weight: 700; }
  .trip-note { margin: 0 0 18px; color: #35433a; }
  .trip-notice { margin-top: 4px; }
  .verification-note { margin: 12px 0 0; color: var(--muted); font-size: 13px; }

  .trip-household-interactions { display: grid; gap: 12px; margin: 16px 0; padding-top: 14px; border-top: 1px solid var(--line); }
  .trip-reactions { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .trip-reaction-buttons { display: flex; gap: 8px; }
  .trip-reaction-buttons button { width: 48px; min-height: 48px; border: 1px solid #b8c5bc; border-radius: 12px; background: #fff; font-size: 20px; cursor: pointer; }
  .trip-reaction-buttons button[aria-pressed="true"] { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 13%, white); box-shadow: inset 0 0 0 1px var(--accent); }
  .trip-reaction-buttons button:disabled { cursor: default; opacity: .42; }
  .trip-reaction-people { display: flex; align-items: center; gap: 9px; min-height: 32px; }
  :global(.trip-household-auth__actions button) { min-height: 48px; }
  :global(.trip-reaction-person), :global(.trip-comment__author) { display: inline-flex; align-items: center; gap: 5px; }
  :global(.household-person-icon) { width: 2rem; height: 2rem; flex: 0 0 2rem; border-radius: 999px; overflow: hidden; display: inline-grid; place-items: center; background: #eee9df; }
  :global(.household-person-icon--compact) { width: 1.65rem; height: 1.65rem; flex-basis: 1.65rem; }
  :global(.household-person-icon img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  :global(.household-person-icon svg) { width: 100%; height: 100%; fill: #d8d0c4; stroke: #776f64; stroke-width: 1.5; }
  :global(.trip-comment-list), :global(.trip-comment-expand ul) { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; }
  :global(.trip-comment) { border-left: 3px solid #c6b9a7; padding-left: 10px; }
  :global(.trip-comment__meta) { display: flex; justify-content: space-between; align-items: center; gap: 8px; color: #665f56; font-size: 13px; }
  :global(.trip-comment p) { margin: 5px 0; white-space: pre-wrap; }
  :global(.trip-comment__actions) { display: flex; gap: 8px; }
  :global(.trip-comment__actions button) { min-height: 48px; border: 0; background: none; padding: 5px 0; color: var(--accent); cursor: pointer; font-weight: 700; }
  :global(.trip-comment-expand-row) { list-style: none; }
  :global(.trip-comment-expand), :global(.trip-comment-add) { border: 0; margin: 0; padding: 0; }
  :global(.trip-comment-expand > summary), :global(.trip-comment-add > summary) { width: fit-content; min-height: 48px; display: flex; align-items: center; cursor: pointer; color: var(--accent); font-weight: 700; list-style: none; }
  :global(.trip-comment-expand > summary::-webkit-details-marker), :global(.trip-comment-add > summary::-webkit-details-marker) { display: none; }
  :global(.trip-comment-expand__open) { display: none; }
  :global(.trip-comment-expand[open] .trip-comment-expand__closed) { display: none; }
  :global(.trip-comment-expand[open] .trip-comment-expand__open) { display: inline; }
  :global(.trip-comment-form) { display: grid; gap: 7px; }
  :global(.trip-comment-form textarea) { width: 100%; resize: vertical; border: 1px solid #b8c5bc; border-radius: 9px; padding: 9px; font: inherit; }
  :global(.trip-comment-form button) { width: fit-content; min-height: 48px; border: 0; border-radius: 9px; padding: 7px 14px; background: var(--accent); color: white; font-weight: 700; }
  :global(.trip-interaction-warning) { margin: 5px 0 0; color: #8e2c21; font-size: 13px; font-weight: 700; }
</style>
