---
import type { Restaurant } from '../../data/restaurantTypes';

const { restaurant: r } = Astro.props as { restaurant: Restaurant };
const address = [r.address.line1, r.address.line2, `${r.address.city}, ${r.address.state} ${r.address.postalCode}`].filter(Boolean).join(', ');
const hasTakeout = r.orderPlatforms.length > 0;
const searchable = [r.name, address, ...r.tags, ...r.orderPlatforms.map((platform) => platform.name)].join(' ').toLocaleLowerCase();
const platformNames = r.orderPlatforms.map((platform) => platform.name).join('|');
const tagNames = r.tags.join('|');
const modeLabel = (modes: string[]) => modes.map((mode) => mode === 'delivery' ? '配送' : '自取').join(' / ');
const fixedLinks = [
  { label: '官网', url: r.officialUrl },
  { label: 'Google Maps', url: r.googleMapsUrl },
  { label: 'Yelp', url: r.yelpUrl },
];
---
<article class="record-card restaurant-card" data-restaurant data-search={searchable} data-dinein={r.dineIn ? '1' : '0'} data-takeout={hasTakeout ? '1' : '0'} data-tags={tagNames} data-platforms={platformNames}>
  <div class="record-card__top">
    <div class="badges" aria-label="饭店标签">{r.tags.map((tag) => <span class="badge">{tag}</span>)}</div>
    <h2>{r.name}</h2>
    <p class="location-line">{address}</p>
    <div class="restaurant-services" aria-label="服务方式">
      {r.dineIn && <span class="badge badge--status">堂食</span>}
      {hasTakeout && <span class="badge badge--status">外卖</span>}
    </div>
  </div>

  <div class="record-card__body">
    {hasTakeout && <section class="restaurant-platforms" aria-labelledby={`platforms-${r.id}`}>
      <h3 id={`platforms-${r.id}`}>外卖平台</h3>
      <div class="restaurant-platform-list">
        {r.orderPlatforms.map((platform) => <div class="restaurant-platform-row">
          <div>
            <strong>{platform.name}</strong>
            <span>{modeLabel(platform.modes)}</span>
          </div>
          <a class="button button--secondary" href={platform.url} target="_blank" rel="noopener noreferrer">打开</a>
        </div>)}
      </div>
    </section>}

    <div class="actions actions--three restaurant-links" aria-label="饭店链接">
      {fixedLinks.map((link) => link.url
        ? <a class="button button--secondary" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>
        : <span class="button restaurant-link--disabled" aria-disabled="true">{link.label} · 暂无</span>)}
    </div>
    <p class="verification-note">资料核实：{r.verifiedDate}</p>
  </div>
</article>

<style>
  .restaurant-services { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 16px; }
  .restaurant-platforms h3 { margin: 0 0 10px; font-size: 17px; }
  .restaurant-platform-list { display: grid; gap: 9px; }
  .restaurant-platform-row { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 11px; border: 1px solid var(--line); border-radius: 9px; background: #fbfcfa; }
  .restaurant-platform-row > div { display: grid; min-width: 0; gap: 1px; }
  .restaurant-platform-row strong { overflow-wrap: anywhere; font-size: 16px; }
  .restaurant-platform-row span { color: var(--muted); font-size: 14px; }
  .restaurant-platform-row .button { min-width: 78px; min-height: 48px; flex: 0 0 auto; }
  .restaurant-links { margin-top: 22px; }
  .restaurant-link--disabled { border: 1px solid var(--line); background: #eef0ed; color: #6d756f; cursor: not-allowed; }
  .verification-note { margin: 14px 0 0; }
</style>
