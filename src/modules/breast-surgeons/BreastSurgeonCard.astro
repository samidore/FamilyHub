---
import type { BreastSurgeon } from '../../data/breastSurgeonTypes';

const { surgeon: d } = Astro.props as { surgeon: BreastSurgeon };
const searchable = [
  d.name, d.system, d.practice, d.address, d.clinicalSummary, d.trainingSummary,
  d.centerSummary, d.negativeSummary, ...d.fitSignals, ...d.strengths, ...d.evidenceGaps,
].join(' ').toLocaleLowerCase();
const hg = d.reviewEvidence.find((item) => item.source === 'Healthgrades');
const fitLabels: Record<BreastSurgeon['clinicalFit'], string> = {
  strong: '明确覆盖诊断阶段',
  adequate: '乳腺专科适配',
  'oncology-focused': '偏乳腺癌外科',
};
const scopeLabels: Record<BreastSurgeon['locationScope'], string> = {
  'bergen-nj': 'Bergen County',
  'nearby-nj': '附近 NJ',
  'ny-alternative': 'NY 专科备选',
};
const safetyPortal = d.locationScope === 'ny-alternative'
  ? 'https://www.op.nysed.gov/verification-search'
  : 'https://newjersey.mylicense.com/verification/';
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(d.address)}`;
const reviewText = (rating: number | null, count: number) => rating === null
  ? '暂无医生级评分'
  : `${rating.toFixed(1)} / 5 · ${count} ratings`;
---
<article class="record-card breast-surgeon-card" data-breast-surgeon data-id={d.id} data-search={searchable} data-tier={d.tier} data-location-scope={d.locationScope} data-clinical-fit={d.clinicalFit} data-availability={d.availability} data-rank={d.rank} data-hg-rating={hg?.rating ?? -1} data-hg-count={hg?.reviewCount ?? 0} data-name={d.name}>
  <div class="record-card__top">
    <div class="badges">
      <span class="badge">Tier {d.tier} · 待独立安全核查</span>
      <span class="badge badge--status">{fitLabels[d.clinicalFit]}</span>
      {d.locationScope === 'ny-alternative' && <span class="badge badge--caution">纽约州备选</span>}
      <span class="badge">{scopeLabels[d.locationScope]}</span>
    </div>
    <h2>{d.name}</h2>
    <p class="provider-line"><strong>{d.system}</strong> · {d.practice}</p>
    <p class="location-line">{d.address}</p>
    <dl class="metric-grid">
      <div><dt>Healthgrades · 医生</dt><dd>{reviewText(hg?.rating ?? null, hg?.reviewCount ?? 0)}</dd></div>
      <div><dt>接收新患者</dt><dd>{d.availability === 'listed-accepting' ? '官网列为接收' : '电话确认'}</dd></div>
      <div><dt>正式执照</dt><dd>未完成独立查询</dd></div>
      <div><dt>电话</dt><dd><a href={`tel:${d.phone}`}>{d.phone}</a></dd></div>
    </dl>
  </div>
  <div class="record-card__body">
    <div class="tags" aria-label="已核实的公开匹配线索">
      {d.fitSignals.map((signal) => <span>{signal}</span>)}
    </div>
    <section class="info-block info-block--assessment">
      <h3>肿块 / 影像 / 活检异常适配</h3>
      <p>{d.clinicalSummary}</p>
    </section>
    <section class="info-block info-block--fact">
      <h3>可核实的训练与团队</h3>
      <p>{d.trainingSummary}</p>
      <p>{d.centerSummary}</p>
    </section>
    <section class="info-block">
      <h3>优势与证据边界</h3>
      <div class="tags">{d.strengths.map((strength) => <span>{strength}</span>)}</div>
      <ul class="finding-list">{d.evidenceGaps.map((gap) => <li>{gap}</li>)}</ul>
    </section>
    <section class="info-block">
      <h3>患者体验（不同来源不混合）</h3>
      {d.reviewEvidence.length ? (
        <ul class="finding-list">
          {d.reviewEvidence.map((review) => <li>
            <strong>{review.source} · 个人医生</strong> · {reviewText(review.rating, review.reviewCount)}
            {review.writtenCount !== null && <span> · {review.writtenCount} written</span>}
            <p>{review.summary}</p>
            <a href={review.url} target="_blank" rel="noopener noreferrer">查看对应来源</a>
          </li>)}
        </ul>
      ) : <p>暂无核实匹配的医生级公开评分，不以其他医生或诊所评分代替。</p>}
      <p>{d.negativeSummary}</p>
    </section>
    <details class="record-details">
      <summary>查看正式安全核查、待确认项及预约问题</summary>
      <div class="record-details__content">
        <section class="info-block info-block--risk">
          <h3>执照 / 正式纪律记录</h3>
          <p>州级医生个人执照：{d.licenseStatus === 'requires-confirmation' ? '待独立查询' : d.licenseStatus}；正式纪律记录：{d.disciplineStatus === 'requires-confirmation' ? '待独立查询' : d.disciplineStatus}。不能因为医院官网列为执业医生或 Healthgrades 未显示负面记录就声称州级清白。</p>
          <a href={safetyPortal} target="_blank" rel="noopener noreferrer">打开对应州官方执照验证入口</a>
        </section>
        <section class="info-block">
          <h3>联系诊所时优先问</h3>
          <ul class="question-list">{d.verificationQuestions.map((question) => <li>{question}</li>)}</ul>
        </section>
        <p class="verification-note">公开资料核验：{d.verifiedDate} · Tier 仅是当前资料下的家庭比较顺序；保险、接诊要求及具体预约必须另行确认。页面不收集或保存患者资料。</p>
      </div>
    </details>
    <div class="actions actions--four">
      <a class="button button--primary" href={d.officialUrl} target="_blank" rel="noopener noreferrer">医生官网</a>
      {hg && <a class="button button--secondary" href={hg.url} target="_blank" rel="noopener noreferrer">Healthgrades</a>}
      <a class="button button--secondary" href={d.centerUrl} target="_blank" rel="noopener noreferrer">乳腺中心</a>
      <a class="button button--secondary" href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps</a>
    </div>
  </div>
</article>
