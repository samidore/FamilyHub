---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FilterShell from '../components/FilterShell.astro';
import AdultDermatologistCard from '../modules/adult-dermatologists/AdultDermatologistCard.astro';
import { adultDermatologists } from '../data/catalog';

const concerns = [...new Set(adultDermatologists.map((item) => item.concernLevel))];
const confidences = [...new Set(adultDermatologists.map((item) => item.reviewConfidence))];
const reviewLabels: Record<string, string> = { moderate: 'moderate（10–24）', strong: 'strong（25–99）', 'very-strong': 'very-strong（100+）', unavailable: 'unavailable' };
const rankedDermatologists = [...adultDermatologists].sort((a, b) => a.rank - b.rank);
---
<BaseLayout title="Adult Dermatologists | Family Hub" description="按 board certification、成人痤疮适配、患者体验和预约前确认项比较附近成人皮肤科医生。" pageClass="module-page theme-ochre" themeColor="#F4EDE0">
  <SiteHeader eyebrow="健康与照护 · 公开资料比较" title="Adult Dermatologists" description="这是一份成人皮肤科比较清单：三条 evidence bands 等权看 clinical quality、adult acne fit 和 patient experience；Healthgrades 或可归因的 health-system provider reviews 保持分开，Google Maps/Yelp 只用于 office-level 线索。Tier 是家庭比较工具，不是医疗质量评级。" accent="ochre" icon="care">
    <div class="summary-row"><span>10 位医生</span><span>约 5–30 分钟车程</span><span>MD/DO · provider-level reviews</span></div>
  </SiteHeader>

  <FilterShell accent="ochre" filterId="dermatologist-filter-panel" countId="dermatologist-count" clearId="dermatologist-clear" countText="显示 10 / 10 位医生">
    <div slot="primary" class="filter-primary__grid">
      <label><span>搜索 provider 或证据</span><input id="dermatologist-search" type="search" placeholder="acne、board certified、Paramus…" autocomplete="off" /></label>
      <label><span>排序</span><select id="dermatologist-sort" data-default="rank"><option value="rank">家庭比较顺序</option><option value="drive">最短车程</option><option value="rating">主要评分</option><option value="reviews">评分数量</option><option value="name">名称</option></select></label>
    </div>
    <div slot="filters" class="contents">
      <label><span>比较 Tier</span><select id="dermatologist-tier"><option value="">全部 Tier</option><option value="1">Tier 1 · strongest choices</option><option value="2">Tier 2 · good alternatives</option><option value="3">Tier 3 · meaningful tradeoffs</option></select></label>
      <label><span>车程</span><select id="dermatologist-drive"><option value="">不限车程</option><option value="15">15 分钟内</option><option value="20">20 分钟内</option><option value="30">30 分钟内</option></select></label>
      <label><span>Adult acne fit</span><select id="dermatologist-acne-fit"><option value="">全部 evidence</option><option value="strong">strong</option><option value="adequate">adequate</option><option value="concern">concern</option><option value="unknown">unknown</option></select></label>
      <label><span>Review confidence</span><select id="dermatologist-confidence"><option value="">全部 confidence</option>{confidences.map((item) => <option value={item}>{reviewLabels[item]}</option>)}</select></label>
      <label><span>新患者</span><select id="dermatologist-availability"><option value="">全部状态</option><option value="verified">已核实</option><option value="conditional">需确认</option><option value="unknown">未知</option></select></label>
      <label><span>关注程度</span><select id="dermatologist-concern"><option value="">全部程度</option>{concerns.map((item) => <option value={item}>{item}</option>)}</select></label>
    </div>
  </FilterShell>

  <main id="main-content" class="shell listing-main"><div id="dermatologist-list" class="record-grid">{rankedDermatologists.map((dermatologist) => <AdultDermatologistCard dermatologist={dermatologist} />)}</div><p id="dermatologist-empty" class="empty-state" hidden>没有符合这些条件的医生。清除部分筛选后再试。</p></main>
  <footer class="module-footer"><div class="shell note-box"><strong>预约前直接确认：</strong>新患者名额、保险网络、由 MD/DO 还是团队成员负责、adult acne 是否包含 topical/oral/hormonal/isotretinoin 与疤痕/PIH 讨论、复诊与药物监测流程。若存在怀孕、备孕、哺乳、正在使用的药物或既往 acne treatment，请直接告诉 clinician；不要把本页当作诊断或处方建议。本页不保存家庭姓名、地址、保险号或医疗记录。</div></footer>

  <script>
    import { bindListState, clearListState, restoreListState } from '../lib/listState';
    const cards = [...document.querySelectorAll<HTMLElement>('[data-dermatologist]')];
    const controls = {
      q: document.querySelector<HTMLInputElement>('#dermatologist-search')!,
      sort: document.querySelector<HTMLSelectElement>('#dermatologist-sort')!,
      tier: document.querySelector<HTMLSelectElement>('#dermatologist-tier')!,
      drive: document.querySelector<HTMLSelectElement>('#dermatologist-drive')!,
      acneFit: document.querySelector<HTMLSelectElement>('#dermatologist-acne-fit')!,
      confidence: document.querySelector<HTMLSelectElement>('#dermatologist-confidence')!,
      availability: document.querySelector<HTMLSelectElement>('#dermatologist-availability')!,
      concern: document.querySelector<HTMLSelectElement>('#dermatologist-concern')!,
    };
    const list = document.querySelector<HTMLElement>('#dermatologist-list')!;
    const count = document.querySelector<HTMLElement>('#dermatologist-count')!;
    const empty = document.querySelector<HTMLElement>('#dermatologist-empty')!;
    const number = (card: HTMLElement, key: string) => Number(card.dataset[key] ?? -1);
    const render = () => {
      const query = controls.q.value.trim().toLocaleLowerCase();
      const visible = cards.filter((card) => (!query || card.dataset.search!.includes(query)) && (!controls.tier.value || card.dataset.tier === controls.tier.value) && (!controls.drive.value || number(card, 'driveMax') <= Number(controls.drive.value)) && (!controls.acneFit.value || card.dataset.acneFit === controls.acneFit.value) && (!controls.confidence.value || card.dataset.reviewConfidence === controls.confidence.value) && (!controls.availability.value || card.dataset.availability === controls.availability.value) && (!controls.concern.value || card.dataset.concern === controls.concern.value));
      const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        rank: (a, b) => number(a, 'rank') - number(b, 'rank'),
        drive: (a, b) => number(a, 'driveMax') - number(b, 'driveMax') || number(a, 'rank') - number(b, 'rank'),
        rating: (a, b) => number(b, 'primaryRating') - number(a, 'primaryRating') || number(b, 'primaryReviews') - number(a, 'primaryReviews'),
        reviews: (a, b) => number(b, 'primaryReviews') - number(a, 'primaryReviews') || number(b, 'primaryRating') - number(a, 'primaryRating'),
        name: (a, b) => a.dataset.name!.localeCompare(b.dataset.name!),
      };
      cards.forEach((card) => { card.hidden = !visible.includes(card); });
      visible.sort(sorters[controls.sort.value]).forEach((card) => list.append(card));
      count.textContent = `显示 ${visible.length} / ${cards.length} 位医生`;
      empty.hidden = visible.length > 0;
    };
    restoreListState(controls);
    if (Object.values(controls).slice(2).some((control) => control.value)) document.querySelector<HTMLDetailsElement>('.filter-disclosure')!.open = true;
    bindListState(controls, render);
    document.querySelector('#dermatologist-clear')!.addEventListener('click', () => clearListState(controls, render));
    render();
  </script>
</BaseLayout>
