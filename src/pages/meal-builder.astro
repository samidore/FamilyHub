    googleLogin.addEventListener('click', () => safeWrite(repository.signInWithGoogle())); accessRefresh.addEventListener('click', () => safeWrite(repository.refreshAccess())); logout.addEventListener('click', () => safeWrite(repository.signOut()));
    document.querySelectorAll<HTMLButtonElement>('[data-ingredient-id]').forEach((button) => button.addEventListener('click', () => { if (!household.currentMeal || !canWrite()) return; const id = button.dataset.ingredientId!; const available = new Set(state.availableIngredientIds); const shouldBeOn = !available.has(id); shouldBeOn ? available.add(id) : available.delete(id); state = reconcileMealState({ ...state, availableIngredientIds: [...available] }, recipes, ingredients, optionalGroups); void persistMeal((meal) => { const excluded = new Set(meal.excludedIngredientIds); shouldBeOn ? excluded.delete(id) : excluded.add(id); return resnapshotMeal({ ...meal, excludedIngredientIds: [...excluded], checkoutDraft: {} }); }); render(); }));
    document.querySelectorAll<HTMLButtonElement>('[data-ingredient-bulk]').forEach((button) => button.addEventListener('click', (event) => { event.preventDefault(); event.stopPropagation(); if (!household.currentMeal || !canWrite()) return; const ids = bulkIngredientIds(button.dataset.ingredientBulkSection); const shouldBeOn = button.dataset.ingredientBulk === 'select'; const available = new Set(state.availableIngredientIds); ids.forEach((id) => shouldBeOn ? available.add(id) : available.delete(id)); state = reconcileMealState({ ...state, availableIngredientIds: [...available] }, recipes, ingredients, optionalGroups); void persistMeal((meal) => { const excluded = new Set(meal.excludedIngredientIds); ids.forEach((id) => shouldBeOn ? excluded.delete(id) : excluded.add(id)); return resnapshotMeal({ ...meal, excludedIngredientIds: [...excluded], checkoutDraft: {} }); }); render(); }));
    inventoryList.addEventListener('click', (event) => { const target = event.target as HTMLElement; const toggle = target.closest<HTMLButtonElement>('[data-inventory-toggle]'); const step = target.closest<HTMLButtonElement>('[data-inventory-step]'); const ingredientId = toggle?.dataset.inventoryToggle ?? step?.dataset.inventoryIngredient; if (!ingredientId || !canWrite()) return; const reserved = queuedReservationUnits(household, ingredients)[ingredientId] ?? 0; if (toggle) { const tracking = toggle.dataset.inventoryTracking === 'presence-only' ? 'presence-only' : 'counted'; safeWrite(repository.updateInventory((inventory) => { const current = typeof inventory[ingredientId] === 'number' ? inventory[ingredientId] as number : inventory[ingredientId] === true ? 1 : 0; const next = { ...inventory }; if (tracking === 'presence-only') { if (inventory[ingredientId] === true) delete next[ingredientId]; else next[ingredientId] = true; } else if (current > 0) { if (reserved <= 0) delete next[ingredientId]; else next[ingredientId] = Math.min(current, reserved); } else next[ingredientId] = 1; return next; }).then((next) => { household = next; render(); })); } else if (step) { const delta = Number(step.dataset.inventoryStep); safeWrite(repository.updateInventory((inventory) => { const current = typeof inventory[ingredientId] === 'number' ? inventory[ingredientId] as number : 0; let nextValue = Math.max(0, roundCountedInventoryValue(current + delta)); if (delta < 0 && current <= reserved) nextValue = current; else if (delta < 0) nextValue = Math.max(Math.min(current, reserved), nextValue); const next = { ...inventory }; if (nextValue > 0) next[ingredientId] = nextValue; else delete next[ingredientId]; return next; }).then((next) => { household = next; render(); })); } });
    recipeGrid.addEventListener('change', (event) => { const select = (event.target as HTMLElement).closest<HTMLSelectElement>('[data-binding-recipe]'); if (!select || !household.currentMeal || !canWrite()) return; const recipe = byId.get(select.dataset.bindingRecipe!); if (!recipe) return; const index = Number(select.dataset.bindingIndex); const binding = draftBindingFor(recipe, new Set(state.availableIngredientIds)); binding[index] = select.value; draftBindings[recipe.id] = binding; state = reconcileMealState({ ...state, recipeIngredientBindings: { ...state.recipeIngredientBindings, [recipe.id]: binding.filter((value): value is string => Boolean(value)) } }, recipes, ingredients, optionalGroups); void persistMeal((meal) => { const remoteBinding = [...(meal.recipeIngredientBindings[recipe.id] ?? [])]; remoteBinding[index] = select.value; return reconcileCurrentMeal({ ...meal, recipeIngredientBindings: { ...meal.recipeIngredientBindings, [recipe.id]: remoteBinding.filter((value): value is string => Boolean(value)) }, checkoutDraft: {} }, recipes, ingredients, optionalGroups); }); render(); });
    document.querySelectorAll<HTMLButtonElement>('[data-select-recipe]').forEach((button) => button.addEventListener('click', () => { if (!household.currentMeal || !canWrite()) return; const id = button.dataset.selectRecipe!; const recipe = byId.get(id)!; const binding = draftBindingFor(recipe, new Set(state.availableIngredientIds)); state = reconcileMealState({ ...state, selectedRecipeIds: [...state.selectedRecipeIds, id], recipeIngredientBindings: { ...state.recipeIngredientBindings, [id]: binding.filter((value): value is string => Boolean(value)) } }, recipes, ingredients, optionalGroups); void persistMeal((meal) => reconcileCurrentMeal({ ...meal, selectedRecipeIds: [...new Set([...meal.selectedRecipeIds, id])], recipeIngredientBindings: { ...meal.recipeIngredientBindings, [id]: binding.filter((value): value is string => Boolean(value)) }, checkoutDraft: {} }, recipes, ingredients, optionalGroups)); render(); }));
    document.querySelectorAll<HTMLButtonElement>('[data-remove-recipe]').forEach((button) => button.addEventListener('click', () => { if (!household.currentMeal || !canWrite()) return; const id = button.dataset.removeRecipe!; state = reconcileMealState({ ...state, selectedRecipeIds: state.selectedRecipeIds.filter((selectedId) => selectedId !== id) }, recipes, ingredients, optionalGroups); void persistMeal((meal) => reconcileCurrentMeal({ ...meal, selectedRecipeIds: meal.selectedRecipeIds.filter((selectedId) => selectedId !== id), checkoutDraft: {} }, recipes, ingredients, optionalGroups)); render(); }));
    protein.addEventListener('change', () => { const value = Number(protein.value); state = { ...state, proteinTarget: value }; void persistMeal((meal) => ({ ...meal, proteinTarget: value })); render(); }); vegetable.addEventListener('change', () => { const value = Number(vegetable.value); state = { ...state, vegetableTarget: value }; void persistMeal((meal) => ({ ...meal, vegetableTarget: value })); render(); }); time.addEventListener('change', () => { const value = time.value as TimePreference; state = { ...state, timePreference: value }; void persistMeal((meal) => ({ ...meal, timePreference: value })); render(); }); staple.addEventListener('change', () => { const value = staple.checked; state = { ...state, stapleRequired: value }; void persistMeal((meal) => ({ ...meal, stapleRequired: value })); render(); }); child.addEventListener('change', () => { const value = child.checked; state = { ...state, childMode: value }; void persistMeal((meal) => ({ ...meal, childMode: value })); render(); });
