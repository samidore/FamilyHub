    confirmCheckout.addEventListener('click', () => { if (!household.currentMeal) return; ensureCheckoutDrafts(); const meals = [...(household.pendingCheckoutMeals ?? []), household.currentMeal]; checkoutStatus.textContent = `将一次结算 ${meals.length} 顿。请核对上面的实际用量；确认后会一次性扣库存。`; finalizeCheckout.hidden = false; });
    finalizeCheckout.addEventListener('click', async () => { if (!household.currentMeal || !canWrite()) return; const mealId = household.currentMeal.mealId; ensureCheckoutDrafts(); try { let outcome: ReturnType<typeof applyQueuedCheckoutComposition> | undefined; const next = await repository.transaction((current) => { outcome = applyQueuedCheckoutComposition(current, mealId, checkoutDraftsByMealId, ingredients, { recipes, optionalGroups, nextMealId: createMealId(), completedAt: Date.now() }); return outcome.state; }); household = next; if (!outcome?.committed) { checkoutStatus.textContent = outcome?.reason === 'invalid-consumption' ? '库存或结算内容已经变化，请重新核对。' : '这顿状态已经变化，请重新进入结算。'; render(); return; } checkoutDraftsByMealId = {}; state = next.currentMeal ? mealStateFromCurrentMeal(next.currentMeal) : defaultMealState(); checkoutStatus.textContent = ''; finalizeCheckout.hidden = true; render(); announce('排队餐和本顿已一起结算。'); } catch (error) { reportWriteError(error); } });
    repository.subscribe((next, status) => { household = next; repositoryStatus = status; if (next.currentMeal) { state = reconcileMealState(mealStateFromCurrentMeal(next.currentMeal), recipes, ingredients, optionalGroups); view = next.activeStep === 'cook' || next.activeStep === 'checkout' ? 'cook' : 'build'; } else { state = defaultMealState(); draftBindings = {}; checkoutDraftsByMealId = {}; view = 'build'; } render(); }); repository.ready?.catch(() => render()); render();
