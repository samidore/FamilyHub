      state = reconcileMealState({ ...state, availableIngredientIds: [...available] }, recipes, ingredients);
      void persistMeal((meal) => { const excluded = new Set(meal.excludedIngredientIds); ids.forEach((id) => shouldBeOn ? excluded.delete(id) : excluded.add(id)); return resnapshotMeal({ ...meal, excludedIngredientIds: [...excluded], checkoutDraft: {} }); });
      render();
      const removed = before - state.selectedRecipeIds.length;
      announce(removed > 0 ? `已批量取消食材，并移除 ${removed} 道无法制作的已选菜。` : `已${shouldBeOn ? '全选' : '全不选'} ${ids.length} 种食材。`);
    }));
    document.querySelector('#meal-show-all')!.addEventListener('change', (event) => { showAllInventory = (event.target as HTMLInputElement).checked; renderInventory(); });
    inventoryList.addEventListener('click', (event) => { const target = event.target as HTMLElement; const start = target.closest<HTMLButtonElement>('[data-start-thaw]'); const enter = target.closest<HTMLButtonElement>('[data-complete-thaw]'); const cancel = target.closest<HTMLButtonElement>('[data-cancel-thaw]'); const add = target.closest<HTMLButtonElement>('[data-stock-add]'); const delta = target.closest<HTMLButtonElement>('[data-stock-delta]'); const toggle = target.closest<HTMLButtonElement>('[data-stock-toggle]'); const discard = target.closest<HTMLButtonElement>('[data-discard-stock]'); if (!canWrite()) return; if (start) safeWrite(repository.transaction((state) => startThaw(state, start.dataset.startThaw!, ingredients, Date.now(), undefined, Number(start.dataset.thawQuantity)))); else if (enter) safeWrite(repository.transaction((state) => completeThaw(state, enter.dataset.completeThaw!, Date.now(), ingredients, 1))); else if (cancel) safeWrite(repository.transaction((state) => cancelThaw(state, cancel.dataset.cancelThaw!))); else if (delta) safeWrite(repository.transaction((state) => delta.dataset.stockStorage === 'inventory' ? (delta.closest<HTMLElement>('[data-batch-key]') ? adjustInventoryBatch(state, delta.dataset.stockItem!, delta.closest<HTMLElement>('[data-batch-key]')!.dataset.batchKey!, Number(delta.dataset.stockDelta), ingredients) : adjustReadyAggregate(state, delta.dataset.stockItem!, Number(delta.dataset.stockDelta), ingredients)) : adjustFrozenAggregate(state, delta.dataset.stockItem!, Number(delta.dataset.stockDelta), ingredients))); else if (add) safeWrite(repository.transaction((state) => addStock(state, add.dataset.stockAdd!, add.dataset.stockStorage as 'inventory' | 'freezer', Number(add.dataset.stockQuantity ?? '1'), ingredients, calendarDateKey(Date.now())))); else if (toggle) safeWrite(repository.transaction((state) => addStock(state, toggle.dataset.stockToggle!, 'inventory', 1, ingredients, calendarDateKey(Date.now())))); else if (discard) safeWrite(repository.transaction((state) => discardStock(state, discard.dataset.discardStock!, discard.dataset.discardStorage as 'inventory' | 'freezer', Date.now(), discard.closest<HTMLElement>('[data-batch-key]')?.dataset.batchKey, ingredients))); });
    undoNotices.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-undo-discard]'); if (button && canWrite()) safeWrite(repository.transaction((state) => undoDiscard(state, button.dataset.undoDiscard!, Date.now(), ingredients))); });
    recipeGrid.addEventListener('change', (event) => {
      const target = event.target as HTMLElement;
      const select = target.closest<HTMLSelectElement>('[data-binding-recipe]'); if (!select || !household.currentMeal || !canWrite()) return; const recipe = byId.get(select.dataset.bindingRecipe!); if (!recipe) return; const index = Number(select.dataset.bindingIndex); const binding = draftBindingFor(recipe, new Set(state.availableIngredientIds)); binding[index] = select.value; draftBindings[recipe.id] = binding; state = reconcileMealState({ ...state, recipeIngredientBindings: { ...state.recipeIngredientBindings, [recipe.id]: binding.filter((value): value is string => Boolean(value)) } }, recipes, ingredients); void persistMeal((meal) => { const remoteBinding = [...(meal.recipeIngredientBindings[recipe.id] ?? [])]; remoteBinding[index] = select.value; return reconcileCurrentMeal({ ...meal, recipeIngredientBindings: { ...meal.recipeIngredientBindings, [recipe.id]: remoteBinding.filter((value): value is string => Boolean(value)) }, checkoutDraft: {} }, recipes, ingredients); }); render(); announce('已更新这道菜的食材选择。');
    });
    document.querySelectorAll<HTMLButtonElement>('[data-select-recipe]').forEach((button) => button.addEventListener('click', () => { if (!household.currentMeal || !canWrite()) return; const id = button.dataset.selectRecipe!; const recipe = byId.get(id)!; const binding = draftBindingFor(recipe, new Set(state.availableIngredientIds)); state = reconcileMealState({ ...state, selectedRecipeIds: [...state.selectedRecipeIds, id], recipeIngredientBindings: { ...state.recipeIngredientBindings, [id]: binding.filter((value): value is string => Boolean(value)) } }, recipes, ingredients); void persistMeal((meal) => { const remoteState = mealStateFromCurrentMeal(meal); if (remoteState.selectedRecipeIds.includes(id)) return meal; const remoteBinding = bindRecipeIngredients(recipe, remoteState.availableIngredientIds, binding, remoteState.ingredientFreshnessDates); return reconcileCurrentMeal({ ...meal, selectedRecipeIds: [...meal.selectedRecipeIds, id], recipeIngredientBindings: { ...meal.recipeIngredientBindings, [id]: remoteBinding.filter((value): value is string => Boolean(value)) }, checkoutDraft: {} }, recipes, ingredients); }); render(); announce('已加入一道菜。'); }));
    document.querySelectorAll<HTMLButtonElement>('[data-remove-recipe]').forEach((button) => button.addEventListener('click', () => { if (!household.currentMeal || !canWrite()) return; const id = button.dataset.removeRecipe!; state = reconcileMealState({ ...state, selectedRecipeIds: state.selectedRecipeIds.filter((selectedId) => selectedId !== id) }, recipes, ingredients); void persistMeal((meal) => reconcileCurrentMeal({ ...meal, selectedRecipeIds: meal.selectedRecipeIds.filter((selectedId) => selectedId !== id), checkoutDraft: {} }, recipes, ingredients)); render(); announce('已移除一道菜。'); }));
    protein.addEventListener('change', () => { if (!canWrite() || !household.currentMeal) return; const value = Number(protein.value); state = { ...state, proteinTarget: value }; void persistMeal((meal) => ({ ...meal, proteinTarget: value })); render(); }); vegetable.addEventListener('change', () => { if (!canWrite() || !household.currentMeal) return; const value = Number(vegetable.value); state = { ...state, vegetableTarget: value }; void persistMeal((meal) => ({ ...meal, vegetableTarget: value })); render(); }); time.addEventListener('change', () => { if (!canWrite() || !household.currentMeal) return; const value = time.value as TimePreference; state = { ...state, timePreference: value }; void persistMeal((meal) => ({ ...meal, timePreference: value })); render(); }); staple.addEventListener('change', () => { if (!canWrite() || !household.currentMeal) return; const value = staple.checked; state = { ...state, stapleRequired: value }; void persistMeal((meal) => ({ ...meal, stapleRequired: value })); render(); }); child.addEventListener('change', () => { if (!canWrite() || !household.currentMeal) return; const value = child.checked; state = { ...state, childMode: value }; void persistMeal((meal) => ({ ...meal, childMode: value })); render(); });
    const resetRecipes = () => { if (!household.currentMeal || !canWrite()) return; state = { ...state, selectedRecipeIds: [], recipeIngredientBindings: {} }; view = 'build'; void persistMeal((meal) => resetRecipeSelection(meal)); render(); announce('已重置本顿选菜；库存和本顿可用食材未改变。'); };
    document.querySelector('#meal-reset')!.addEventListener('click', resetRecipes); document.querySelector('#meal-recipe-reset')!.addEventListener('click', resetRecipes);
    document.querySelector('#meal-inventory-reset')!.addEventListener('click', () => { if (canWrite() && window.confirm('确定清空共享库存吗？')) { safeWrite(repository.resetInventory().then((next) => { household = next; render(); })); announce('已清空库存；本顿可用食材保持不变。'); } });
    document.querySelectorAll<HTMLButtonElement>('[data-step-target]').forEach((button) => button.addEventListener('click', async () => { if (button.disabled) return; const target = button.dataset.stepTarget as 'inventory' | 'recipes' | 'cook' | 'checkout'; await persistStep(target); render(); announce(`已进入第 ${target === 'inventory' ? '一' : target === 'recipes' ? '二' : target === 'cook' ? '三' : '四'} 步。`); }));
    document.querySelector('#meal-start-current')!.addEventListener('click', async () => { if (!canWrite()) return; const meal = await persistStep('recipes'); if (meal) { state = mealStateFromCurrentMeal(meal); view = 'build'; render(); announce('已进入选菜步骤。'); } });
    document.querySelector('#meal-back-inventory')!.addEventListener('click', async () => { await persistStep('inventory'); render(); });
    document.querySelector('#meal-modify')!.addEventListener('click', async () => { if (!household.currentMeal || household.currentMeal.status !== 'ready' || !canWrite()) return; const updated = await persistMeal((meal) => setCurrentMealStatus(meal, 'selecting')); if (updated?.status === 'selecting') { setView('build'); render(); } else if (updated?.status === 'cooking') { setView('cook'); render(); } });
    document.querySelector('#meal-start-cooking')!.addEventListener('click', async () => { if (!household.currentMeal || household.currentMeal.status !== 'ready' || !canWrite()) return; const updated = await persistMeal((meal) => setCurrentMealStatus(meal, 'cooking')); if (updated?.status === 'cooking') { setView('cook'); render(); } else if (updated?.status === 'selecting') { setView('build'); render(); } });
    document.querySelector('#meal-back-to-menu')!.addEventListener('click', async () => { await persistStep('recipes', (meal) => ({ ...meal, status: 'selecting' })); render(); });
    nextButton.addEventListener('click', async () => { if (nextButton.disabled || !household.currentMeal || !canWrite()) return; await persistStep('cook', advanceMealToCooking); render(); announce('已进入做饭步骤。'); });
    forceNextButton.addEventListener('click', async () => { if (state.selectedRecipeIds.length === 0 || !household.currentMeal || !canWrite()) return; await persistStep('cook', advanceMealToCooking); render(); announce('已按当前菜单进入做饭步骤。'); });
    openCheckout.addEventListener('click', async () => { if (!household.currentMeal || household.currentMeal.status !== 'cooking' || !canWrite()) return; await persistStep('checkout'); render(); });
    document.querySelector('#meal-back-cook')!.addEventListener('click', async () => { await persistStep('cook'); render(); });
    repository.subscribe((next, status) => { household = next; repositoryStatus = status; if (Object.values(next.thawingItems).some((job) => job.readyAt <= Date.now())) safeWrite(repository.transaction((current) => reconcileDueThawing(current, Date.now(), ingredients))); if (next.currentMeal) { state = reconcileMealState(mealStateFromCurrentMeal(next.currentMeal), recipes, ingredients); view = next.activeStep === 'cook' || next.activeStep === 'checkout' ? 'cook' : 'build'; } else { state = defaultMealState(); draftBindings = {}; checkout.hidden = true; view = 'build'; } render(); });
    window.setInterval(() => { if (canWrite()) { if (Object.values(household.thawingItems).some((job) => job.readyAt <= Date.now())) safeWrite(repository.transaction((current) => reconcileDueThawing(current, Date.now(), ingredients))); if (Object.values(household.discardedStock).some((record) => record.undoUntil <= Date.now())) safeWrite(repository.transaction((current) => cleanupDiscardedStock(current, Date.now()))); renderInventory(); } }, 1000);
    repository.ready?.catch(() => render());
    render();
  </script>
