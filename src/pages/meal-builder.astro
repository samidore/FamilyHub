      const candidates = rankCandidates(recipes, state, ingredients, draftBindings, household.recentMeals.map((meal) => meal.recipeIds), undefined, optionalGroups); const candidateIds = new Set(candidates.map((recipe) => recipe.id)); document.querySelectorAll<HTMLElement>('[data-meal-recipe]').forEach((card) => { card.hidden = !candidateIds.has(card.dataset.mealRecipe!); }); candidates.forEach((recipe) => { const card = document.querySelector<HTMLElement>(`[data-meal-recipe="${CSS.escape(recipe.id)}"]`)!; const binding = renderRecipeBindings(recipe, card, available); card.querySelector<HTMLElement>('[data-candidate-freshness-badge]')!.hidden = !bindingIsExpiring(binding); const badge = card.querySelector<HTMLElement>('[data-time-badge]')!; const fit = timeFit(recipe, state.timePreference); badge.hidden = !fit.label; badge.textContent = fit.label; recipeGrid.append(card); }); document.querySelector('#meal-result-count')!.textContent = `${candidates.length} 道可选`; document.querySelector<HTMLElement>('#meal-empty')!.hidden = candidates.length > 0; document.querySelector('#meal-guidance')!.textContent = available.size === 0 ? '先选择可用食材，候选菜会在这里出现。' : candidates.length ? '候选会先按当前组餐缺口排序。' : '增加可用食材，或调整组餐目标。'; if (!hasMeal) view = 'build'; if (!done && view !== 'build' && household.currentMeal?.status !== 'cooking') view = 'build'; builder.hidden = !hasMeal || household.activeStep !== 'recipes'; complete.hidden = true; cook.hidden = !hasMeal || (household.activeStep !== 'cook' && household.activeStep !== 'checkout'); checkout.hidden = household.activeStep !== 'checkout'; const checkoutStep = household.activeStep === 'checkout'; cook.querySelector<HTMLElement>(':scope > .meal-section-heading')!.hidden = checkoutStep; cook.querySelector<HTMLElement>('.meal-cook-list')!.hidden = checkoutStep; if (checkoutStep) renderCheckout(); save();
