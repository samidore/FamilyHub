    document.querySelectorAll<HTMLButtonElement>('[data-select-recipe]').forEach((button) => button.addEventListener('click', () => { if (!household.currentMeal || !canWrite()) return; const id = button.dataset.selectRecipe!; const recipe = byId.get(id)!; const binding = draftBindingFor(recipe, new Set(state.availableIngredientIds)); state = reconcileMealState({ ...state, selectedRecipeIds: [...state.selectedRecipeIds, id], recipeIngredientBindings: { ...state.recipeIngredientBindings, [id]: binding.filter((value): value is string => Boolean(value)) } }, recipes, ingredients); void persistMeal((meal) => { const remoteState = mealStateFromCurrentMeal(meal); if (remoteState.selectedRecipeIds.includes(id)) return meal; const remoteBinding = bindRecipeIngredients(recipe, remoteState.availableIngredientIds, binding); return reconcileCurrentMeal({ ...meal, selectedRecipeIds: [...meal.selectedRecipeIds, id], recipeIngredientBindings: { ...meal.recipeIngredientBindings, [id]: remoteBinding.filter((value): value is string => Boolean(value)) }, checkoutDraft: {} }, recipes, ingredients); }); render(); announce('已加入一道菜。'); }));
    document.querySelectorAll<HTMLButtonElement>('[data-remove-recipe]').forEach((button) => button.addEventListener('click', () => { if (!household.currentMeal || !canWrite()) return; const id = button.dataset.removeRecipe!; state = reconcileMealState({ ...state, selectedRecipeIds: state.selectedRecipeIds.filter((selectedId) => selectedId !== id) }, recipes, ingredients); void persistMeal((meal) => reconcileCurrentMeal({ ...meal, selectedRecipeIds: meal.selectedRecipeIds.filter((selectedId) => selectedId !== id), checkoutDraft: {} }, recipes, ingredients)); render(); announce('已移除一道菜。'); }));
    selectedPanel.addEventListener('change', (event) => { const select = (event.target as HTMLElement).closest<HTMLSelectElement>('[data-addon-select]'); if (!select || !household.currentMeal || !canWrite()) return; const recipe = byId.get(select.dataset.addonRecipe!); if (!recipe) return; state = addSelectedAddon(state, recipe, select.dataset.addonId!, select.value, ingredients); state = reconcileMealState(state, recipes, ingredients); void persistMeal((meal) => { const remoteState = mealStateFromCurrentMeal(meal); const nextState = addSelectedAddon(remoteState, recipe, select.dataset.addonId!, select.value, ingredients); return currentMealFromState(meal, reconcileMealState(nextState, recipes, ingredients)); }); render(); announce('已更新叶菜附加项食材。'); });
    selectedPanel.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-addon-id]'); if (!button || !household.currentMeal || !canWrite()) return; const recipe = byId.get(button.dataset.addonRecipe!); if (!recipe) return; const current = selectedAddonEntries(recipe.id).some((entry) => entry.addonType === button.dataset.addonId); const select = button.parentElement?.querySelector<HTMLSelectElement>('[data-addon-select]'); const ingredientId = select?.value ?? button.dataset.addonIngredient!; state = current || button.dataset.addonAction === 'remove' ? removeSelectedAddon(state, recipe.id, button.dataset.addonId!) : addSelectedAddon(state, recipe, button.dataset.addonId!, ingredientId, ingredients); state = reconcileMealState(state, recipes, ingredients); void persistMeal((meal) => { const remoteState = mealStateFromCurrentMeal(meal); const remoteSelected = remoteState.selectedAddons.some((entry) => entry.mainRecipeId === recipe.id && entry.addonType === button.dataset.addonId); const nextState = remoteSelected ? removeSelectedAddon(remoteState, recipe.id, button.dataset.addonId!) : addSelectedAddon(remoteState, recipe, button.dataset.addonId!, ingredientId, ingredients); return currentMealFromState(meal, reconcileMealState(nextState, recipes, ingredients)); }); render(); announce(current || button.dataset.addonAction === 'remove' ? '已移除叶菜附加项。' : '已加入叶菜附加项。'); });
    protein.addEventListener('change', () => { if (!canWrite() || !household.currentMeal) return; const value = Number(protein.value); state = { ...state, proteinTarget: value }; void persistMeal((meal) => ({ ...meal, proteinTarget: value })); render(); }); vegetable.addEventListener('change', () => { if (!canWrite() || !household.currentMeal) return; const value = Number(vegetable.value); state = { ...state, vegetableTarget: value }; void persistMeal((meal) => ({ ...meal, vegetableTarget: value })); render(); }); time.addEventListener('change', () => { if (!canWrite() || !household.currentMeal) return; const value = time.value as TimePreference; state = { ...state, timePreference: value }; void persistMeal((meal) => ({ ...meal, timePreference: value })); render(); }); staple.addEventListener('change', () => { if (!canWrite() || !household.currentMeal) return; const value = staple.checked; state = { ...state, stapleRequired: value }; void persistMeal((meal) => ({ ...meal, stapleRequired: value })); render(); }); child.addEventListener('change', () => { if (!canWrite() || !household.currentMeal) return; const value = child.checked; state = { ...state, childMode: value }; void persistMeal((meal) => ({ ...meal, childMode: value })); render(); });
    const resetRecipes = () => { if (!household.currentMeal || !canWrite()) return; state = { ...state, selectedRecipeIds: [], recipeIngredientBindings: {}, selectedAddons: [] }; view = 'build'; checkoutDraft = {}; void persistMeal((meal) => resetRecipeSelection(meal)); render(); announce('已重置本顿选菜；库存和本顿可用食材未改变。'); };
    document.querySelector('#meal-reset')!.addEventListener('click', resetRecipes); document.querySelector('#meal-recipe-reset')!.addEventListener('click', resetRecipes);
    document.querySelector('#meal-inventory-reset')!.addEventListener('click', () => { if (canWrite() && window.confirm('确定清空共享库存吗？')) { safeWrite(repository.resetInventory().then((next) => { household = next; render(); })); announce('已清空库存；本顿可用食材保持不变。'); } });
    document.querySelectorAll<HTMLButtonElement>('[data-step-target]').forEach((button) => button.addEventListener('click', async () => { if (button.disabled) return; const target = button.dataset.stepTarget as 'inventory' | 'recipes' | 'cook' | 'checkout'; await persistStep(target); render(); announce(`已进入第 ${target === 'inventory' ? '一' : target === 'recipes' ? '二' : target === 'cook' ? '三' : '四'} 步。`); }));
    document.querySelector('#meal-start-current')!.addEventListener('click', async () => { if (!canWrite()) return; const meal = await persistStep('recipes'); if (meal) { state = mealStateFromCurrentMeal(meal); view = 'build'; checkoutDraft = meal.checkoutDraft; render(); announce('已进入选菜步骤。'); } });
    document.querySelector('#meal-back-inventory')!.addEventListener('click', async () => { await persistStep('inventory'); render(); });
    document.querySelector('#meal-modify')!.addEventListener('click', async () => { if (!household.currentMeal || household.currentMeal.status !== 'ready' || !canWrite()) return; const updated = await persistMeal((meal) => setCurrentMealStatus(meal, 'selecting')); if (updated?.status === 'selecting') { setView('build'); render(); } else if (updated?.status === 'cooking') { setView('cook'); render(); } });
    document.querySelector('#meal-start-cooking')!.addEventListener('click', async () => { if (!household.currentMeal || household.currentMeal.status !== 'ready' || !canWrite()) return; const updated = await persistMeal((meal) => setCurrentMealStatus(meal, 'cooking')); if (updated?.status === 'cooking') { setView('cook'); render(); } else if (updated?.status === 'selecting') { setView('build'); render(); } });
    document.querySelector('#meal-back-to-menu')!.addEventListener('click', async () => { await persistStep('recipes', (meal) => ({ ...meal, status: 'selecting' })); render(); });
    nextButton.addEventListener('click', async () => { const totals = aggregateSelection(recipes, state, ingredients); if (!isMealComplete(state, totals) || !household.currentMeal || !canWrite()) return; await persistStep('cook', advanceMealToCooking); render(); announce('已进入做饭步骤。'); });
    forceNextButton.addEventListener('click', async () => { if (state.selectedRecipeIds.length === 0 || !household.currentMeal || !canWrite()) return; await persistStep('cook', advanceMealToCooking); render(); announce('已按当前菜单进入做饭步骤。'); });
    openCheckout.addEventListener('click', async () => { if (!household.currentMeal || household.currentMeal.status !== 'cooking' || !canWrite()) return; await persistStep('checkout'); render(); });
    document.querySelector('#meal-back-cook')!.addEventListener('click', async () => { await persistStep('cook'); render(); });
    checkoutList.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-checkout-step]'); if (!button) return; const id = button.dataset.checkoutIngredient!; const current = typeof checkoutDraft[id] === 'number' ? checkoutDraft[id] as number : 0; const available = typeof household.inventory[id] === 'number' ? household.inventory[id] as number : 0; checkoutDraft[id] = Math.max(0, Math.min(available, Math.round((current + Number(button.dataset.checkoutStep)) * 2) / 2)); safeWrite(persistMeal((meal) => updateCheckoutDraft(meal, checkoutDraft, household.inventory, ingredients, recipes))); renderCheckout(); });
    checkoutList.addEventListener('change', (event) => { const input = (event.target as HTMLInputElement).closest<HTMLInputElement>('[data-checkout-used-up]'); if (input) { checkoutDraft[input.dataset.checkoutUsedUp!] = input.checked; safeWrite(persistMeal((meal) => updateCheckoutDraft(meal, checkoutDraft, household.inventory, ingredients, recipes))); } });
    confirmCheckout.addEventListener('click', () => { checkoutStatus.textContent = '请再次确认后清除本顿和已用库存。'; finalizeCheckout.hidden = false; finalizeCheckout.focus(); });
    finalizeCheckout.addEventListener('click', async () => { const meal = household.currentMeal; if (!meal || !canWrite()) return; try { const result = await repository.checkout(meal.mealId, checkoutDraft); if (result.committed) { household = result.state; state = result.state.currentMeal ? mealStateFromCurrentMeal(result.state.currentMeal) : defaultMealState(); checkoutDraft = {}; checkout.hidden = true; view = 'build'; announce('结算已完成，已按剩余库存开始新一顿选菜。'); } else { checkoutStatus.textContent = result.reason === 'stale-meal' ? '本顿已被另一台设备修改或结算，请刷新当前状态。' : 'Checkout 数量无效，请重新检查。'; } render(); } catch (error) { reportWriteError(error); } });
    repository.subscribe((next, status) => { household = next; repositoryStatus = status; if (next.currentMeal) { state = reconcileMealState(mealStateFromCurrentMeal(next.currentMeal), recipes, ingredients); view = next.activeStep === 'cook' || next.activeStep === 'checkout' ? 'cook' : 'build'; checkoutDraft = next.currentMeal.checkoutDraft; } else { state = defaultMealState(); draftBindings = {}; checkoutDraft = {}; checkout.hidden = true; view = 'build'; } render(); });
    repository.ready?.catch(() => render());
    render();
  </script>
