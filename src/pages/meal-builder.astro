    document.querySelectorAll<HTMLButtonElement>('[data-step-target]').forEach((button) => button.addEventListener('click', async () => { if (button.disabled) return; await persistStep(button.dataset.stepTarget as 'inventory' | 'recipes' | 'cook' | 'checkout'); render(); })); document.querySelector('#meal-start-current')!.addEventListener('click', async () => { const meal = await persistStep('recipes'); if (meal) { state = mealStateFromCurrentMeal(meal); render(); } }); document.querySelector('#meal-back-inventory')!.addEventListener('click', async () => { await persistStep('inventory'); render(); }); document.querySelector('#meal-modify')!.addEventListener('click', async () => { const updated = await persistMeal((meal) => setCurrentMealStatus(meal, 'selecting')); if (updated) render(); }); document.querySelector('#meal-start-cooking')!.addEventListener('click', async () => { const updated = await persistMeal((meal) => setCurrentMealStatus(meal, 'cooking')); if (updated) render(); }); document.querySelector('#meal-back-to-menu')!.addEventListener('click', async () => { await persistStep('recipes', (meal) => ({ ...meal, status: 'selecting' })); render(); }); nextButton.addEventListener('click', async () => { await persistStep('cook', advanceMealToCooking); render(); }); forceNextButton.addEventListener('click', async () => { await persistStep('cook', advanceMealToCooking); render(); }); openCheckout.addEventListener('click', async () => { checkoutDraftsByMealId = {}; await persistStep('checkout'); render(); }); queueGoCheckout.addEventListener('click', async () => { checkoutDraftsByMealId = {}; await persistStep('checkout'); render(); }); document.querySelector('#meal-back-cook')!.addEventListener('click', async () => { await persistStep('cook'); render(); });
