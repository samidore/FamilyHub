---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { mealData } from '../data/meal';
import { MEAL_TARGET_OPTIONS, TIME_PREFERENCES, defaultMealState } from '../lib/mealEngine';

const visibleIngredients = mealData.ingredients.filter((ingredient) => ingredient.visible);
const recipes = mealData.recipes;
const initialMealState = defaultMealState();
type StarterSection = { id: string; labelZh: string; labelEn: string; order: number; visible: boolean };
const clientData = JSON.stringify({
  version: mealData.metadata.version,
  starterSections: mealData.starterSections,
  ingredients: mealData.ingredients.map((ingredient) => ({ id: ingredient.id, nameZh: ingredient.nameZh, nameEn: ingredient.nameEn, visible: ingredient.visible, section: ingredient.section, tags: ingredient.tags, inventoryTracking: ingredient.inventoryTracking, inventoryFreshness: ingredient.inventoryFreshness, freshnessPriorityDays: ingredient.freshnessPriorityDays, freezerBehavior: ingredient.freezerBehavior, childCoverage: ingredient.childCoverage })),
  recipes: recipes.map((recipe) => ({
    id: recipe.id, order: recipe.order, fitScore: recipe.fitScore, contribution: recipe.contribution,
    childCoverage: recipe.childCoverage, requirements: recipe.requirements, tags: recipe.tags,
    ingredientChildCoverage: recipe.ingredientChildCoverage, mealWindowMinutes: recipe.mealWindowMinutes,
    elapsedMinutes: recipe.elapsedMinutes, advanceStartRequired: recipe.advanceStartRequired,
  })),
});
const firebaseConfig = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY ?? '',
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN ?? '',
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID ?? '',
  databaseURL: import.meta.env.PUBLIC_FIREBASE_DATABASE_URL ?? '',
  storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET || undefined,
  messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID || undefined,
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID ?? '',
  householdId: import.meta.env.PUBLIC_FAMILY_HOUSEHOLD_ID ?? '',
};
const clientFirebaseConfig = JSON.stringify(firebaseConfig);
const contributionText = (recipe: (typeof recipes)[number]) => [
  recipe.contribution.protein ? `Protein ${recipe.contribution.protein}` : '',
  recipe.contribution.vegetable ? `Vegetable ${recipe.contribution.vegetable}` : '',
  recipe.contribution.staple ? 'Staple ✓' : '',
].filter(Boolean).join(' · ');
---
<BaseLayout title="Meal Builder | Family Hub" description="按本顿可用食材和家庭组餐目标，实时选择合适的菜。" pageClass="module-page theme-berry meal-builder-page" themeColor="#F3E8EC">
  <SiteHeader eyebrow="饮食与家庭 · 动态组餐" title="Meal Builder" description="先勾选这顿可以使用的食材，再逐步补齐 Protein、Vegetable、Staple 和孩子需要的菜。食材可用不代表每样都必须用。" accent="berry" icon="meal">
    <div class="summary-row"><span>{visibleIngredients.length} 种可选食材</span><span>{recipes.length} 道候选菜</span></div>
  </SiteHeader>

  <main id="main-content" class="meal-builder-app" data-enhanced="false">
    <noscript><div class="shell meal-noscript note-box"><strong>当前是阅读模式。</strong>启用 JavaScript 后可以选择食材、实时组餐和开始做饭；下方仍完整列出食材与菜谱。</div></noscript>
    <div id="meal-live" class="sr-only" aria-live="polite"></div>
    <nav class="shell meal-step-band" aria-label="组餐步骤"><ol><li data-step="inventory"><button type="button" data-step-target="inventory">1 库存</button></li><li data-step="recipes"><button type="button" data-step-target="recipes">2 选菜</button></li><li data-step="cook"><button type="button" data-step-target="cook">3 做饭</button></li><li data-step="checkout"><button type="button" data-step-target="checkout">4 结算</button></li></ol></nav>

    <section class="shell meal-household-bar" aria-label="家庭共享状态">
      <div>
        <p id="meal-connection" class="meal-connection" role="status">家庭同步准备中</p>
        <p id="meal-account" class="meal-uid" hidden></p>
        <p id="meal-auth-detail" class="meal-uid" hidden></p>
        <div class="meal-auth-actions">
          <button id="meal-google-login" class="button button--secondary" type="button" hidden>使用 Google 登录</button>
          <button id="meal-access-refresh" class="clear-button" type="button" hidden>重新检查权限</button>
          <button id="meal-logout" class="clear-button" type="button" hidden>退出登录</button>
        </div>
      </div>
      <div class="meal-shared-status"><span>本顿状态</span><strong id="meal-shared-status">未开始</strong></div>
    </section>

    <section id="meal-inventory-view" class="shell meal-inventory" aria-labelledby="meal-inventory-heading">
      <div class="meal-section-heading"><div><h2 id="meal-inventory-heading">家庭库存</h2><p>库存会在家庭设备之间同步；有日期的食材减少或结算时先扣最早一批。</p></div><div class="meal-inventory-actions"><span id="meal-inventory-count" class="meal-count">已开启 0</span><button id="meal-inventory-reset" class="clear-button" type="button">清空库存</button></div></div>
      <label class="meal-inventory-toggle"><input id="meal-show-all" type="checkbox" /> 显示全部食材</label>
      <div id="meal-inventory-list" class="meal-inventory-list"></div>
      <div id="meal-undo-notices" class="meal-undo-notices" aria-live="polite"></div>
    </section>

    <section class="shell meal-current-tools" aria-label="本顿操作">
      <button id="meal-start-current" class="button button--secondary" type="button">下一步：选择食材</button>
      <button id="meal-recipe-reset" class="clear-button" type="button">重置本顿选菜</button>
    </section>

    <section id="meal-builder-view" class="shell meal-workspace" aria-label="组餐设置与候选菜">
      <div class="meal-step-actions"><button id="meal-back-inventory" class="button button--secondary" type="button">返回库存</button></div>
      <section class="meal-targets" aria-labelledby="meal-targets-heading">
        <div class="meal-section-heading"><div><p class="eyebrow">01 · 这顿需要什么</p><h2 id="meal-targets-heading">组餐目标</h2></div><button id="meal-reset" class="clear-button" type="button">重置本顿选菜</button></div>
        <div class="meal-target-grid">
          <label><span>Protein</span><select id="meal-protein">{MEAL_TARGET_OPTIONS.map((value) => <option value={value} selected={value === initialMealState.proteinTarget}>{value}</option>)}</select></label>
          <label><span>Vegetable</span><select id="meal-vegetable">{MEAL_TARGET_OPTIONS.map((value) => <option value={value} selected={value === initialMealState.vegetableTarget}>{value}</option>)}</select></label>
          <label><span>时间</span><select id="meal-time">{TIME_PREFERENCES.map((value) => <option value={value} selected={value === initialMealState.timePreference}>{value === 'any' ? '不限' : `约 ${value} 分钟`}</option>)}</select></label>
          <label class="meal-toggle"><input id="meal-staple" type="checkbox" checked /><span><strong>需要 Staple</strong><small>米饭、面或菜中自带主食</small></span></label>
          <label class="meal-toggle"><input id="meal-child" type="checkbox" checked /><span><strong>孩子一起吃</strong><small>孩子蛋白和蔬菜都是必需项</small></span></label>
        </div>
      </section>

      <section class="meal-ingredients" aria-labelledby="meal-ingredients-heading">
        <div class="meal-section-heading">
          <div><p class="eyebrow">02 · 今天有什么</p><h2 id="meal-ingredients-heading">可用食材</h2><p>只选这顿可以拿来做菜的食材。收起分组不会清除选择。</p></div>
          <div class="meal-ingredient-toolbar">
            <span id="meal-ingredient-count" class="meal-count">已选 0</span>
            <div class="meal-bulk-actions" aria-label="全部食材筛选">
              <button class="meal-bulk-icon meal-bulk-icon--select" type="button" data-ingredient-bulk="select" data-ingredient-bulk-scope="all" aria-label="全选所有可用食材">
                <svg viewBox="0 0 24 24" aria-hidden="true" data-bulk-icon="circle-check"><circle cx="12" cy="12" r="9.5"></circle><path d="m7.8 12.4 2.6 2.7 5.8-6.1"></path></svg>
              </button>
              <button class="meal-bulk-icon meal-bulk-icon--clear" type="button" data-ingredient-bulk="clear" data-ingredient-bulk-scope="all" aria-label="全不选所有可用食材">
                <svg viewBox="0 0 24 24" aria-hidden="true" data-bulk-icon="circle-x"><circle cx="12" cy="12" r="9.5"></circle><path d="m8.7 8.7 6.6 6.6m0-6.6-6.6 6.6"></path></svg>
              </button>
            </div>
          </div>
        </div>
        <div class="meal-ingredient-sections">
          {mealData.starterSections.map((section: StarterSection, index: number) => {
            const sectionIngredients = visibleIngredients.filter((ingredient) => ingredient.section === section.id);
            return <details class="meal-ingredient-section" data-ingredient-section={section.id} open={index < 2}>
              <summary>
                <span><strong>{section.labelZh}</strong><small>{section.labelEn}</small></span>
                <span class="meal-ingredient-section__tools">
                  <span data-section-count>0 / {sectionIngredients.length}</span>
                  <span class="meal-bulk-actions" aria-label={`${section.labelZh}食材筛选`}>
                    <button class="meal-bulk-icon meal-bulk-icon--select" type="button" data-ingredient-bulk="select" data-ingredient-bulk-section={section.id} aria-label={`全选${section.labelZh}食材`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true" data-bulk-icon="circle-check"><circle cx="12" cy="12" r="9.5"></circle><path d="m7.8 12.4 2.6 2.7 5.8-6.1"></path></svg>
                    </button>
                    <button class="meal-bulk-icon meal-bulk-icon--clear" type="button" data-ingredient-bulk="clear" data-ingredient-bulk-section={section.id} aria-label={`全不选${section.labelZh}食材`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true" data-bulk-icon="circle-x"><circle cx="12" cy="12" r="9.5"></circle><path d="m8.7 8.7 6.6 6.6m0-6.6-6.6 6.6"></path></svg>
                    </button>
                  </span>
                </span>
              </summary>
              <div class="meal-chip-grid">{sectionIngredients.map((ingredient) => <button class="meal-chip" type="button" aria-pressed="false" data-ingredient-id={ingredient.id}><span aria-hidden="true">✓</span><strong>{ingredient.nameZh}</strong><small>{ingredient.nameEn}</small></button>)}</div>
            </details>;
          })}
        </div>
      </section>

      <section class="meal-results" aria-labelledby="meal-results-heading">
        <div class="meal-progress" aria-label="当前组餐进度">
          <div><span>Protein</span><strong id="progress-protein">0 / {initialMealState.proteinTarget}</strong></div>
          <div><span>Vegetable</span><strong id="progress-vegetable">0 / {initialMealState.vegetableTarget}</strong></div>
          <div><span>Staple</span><strong id="progress-staple">●</strong></div>
          <div data-child-progress><span>孩子蛋白</span><strong id="progress-child-protein">●</strong></div>
          <div data-child-progress><span>孩子蔬菜</span><strong id="progress-child-vegetable">●</strong></div>
        </div>
        <p id="meal-completion-status" class="note-box" role="status"></p>
        <div class="meal-next-actions"><button id="meal-next" class="button button--primary" type="button" disabled>下一步：开始做饭</button><button id="meal-force-next" class="button button--secondary" type="button" disabled>就这样吧</button></div>

        <div id="meal-selected-panel" class="meal-selected" hidden>
          <h3>已选的菜</h3>
          <ul>{recipes.map((recipe) => <li data-selected-recipe={recipe.id} hidden><span><span class="meal-selected-title"><strong>{recipe.nameZh}</strong><span class="meal-freshness-badge" data-selected-freshness-badge={recipe.id} hidden><svg viewBox="0 0 16 14" aria-hidden="true" data-freshness-icon="hourglass"><path d="M5 3h6c0 1.9-.9 3.1-3 4 2.1.9 3 2.1 3 4H5c0-1.9.9-3.1 3-4-2.1-.9-3-2.1-3-4Z"></path><path d="M4 2h8M4 12h8"></path></svg><span>临期</span></span></span><small>{contributionText(recipe)}</small><small data-selected-bindings={recipe.id}></small></span><button type="button" data-remove-recipe={recipe.id}>移除</button></li>)}</ul>
        </div>

        <div class="meal-section-heading"><div><p class="eyebrow">03 · 逐步补齐</p><h2 id="meal-results-heading">候选菜</h2><p id="meal-guidance">先选择可用食材，候选菜会在这里出现。</p></div><span id="meal-result-count" class="meal-count" aria-live="polite">0 道可选</span></div>
        <div id="meal-recipe-grid" class="meal-recipe-grid">
          {recipes.map((recipe) => <article class="meal-recipe-card" data-meal-recipe={recipe.id}>
            <div class="meal-recipe-card__heading"><div><h3>{recipe.nameZh}</h3><p>{recipe.nameEn}</p></div><div class="meal-recipe-card__signals"><span class="meal-freshness-badge" data-candidate-freshness-badge hidden><svg viewBox="0 0 16 14" aria-hidden="true" data-freshness-icon="hourglass"><path d="M5 3h6c0 1.9-.9 3.1-3 4 2.1.9 3 2.1 3 4H5c0-1.9.9-3.1 3-4-2.1-.9-3-2.1-3-4Z"></path><path d="M4 2h8M4 12h8"></path></svg><span>临期</span></span><span class="meal-role">{recipe.primaryRole}</span></div></div>
            <div class="badges"><span class="badge">{contributionText(recipe)}</span>{recipe.childCoverage.protein === true && <span class="badge">孩子蛋白 ✓</span>}{recipe.childCoverage.vegetable === true && <span class="badge">孩子蔬菜 ✓</span>}{recipe.childCoverage.vegetable === 'ingredient-dependent' && <span class="badge" data-child-vegetable-badge>孩子蔬菜：按食材</span>}<span class="badge" data-time-badge hidden></span></div>
            <div class="meal-recipe-bindings" data-recipe-bindings={recipe.id}></div>
            <p class="meal-timing">{recipe.mealWindowMinutes || recipe.elapsedMinutes || recipe.activeMinutes}{recipe.advanceStartRequired ? ' · 需提前开始' : ''}</p>
            <p class="meal-equipment">{recipe.equipment.join(' · ')}</p>
            <button class="button button--primary" type="button" data-select-recipe={recipe.id}>选择这道菜</button>
          </article>)}
        </div>
        <p id="meal-empty" class="empty-state" hidden>目前没有能补齐缺口的候选菜。增加可用食材，或调整组餐目标。</p>
      </section>
    </section>

    <section id="meal-complete-view" class="shell meal-finish" hidden aria-labelledby="meal-complete-heading">
      <p class="eyebrow">组餐完成</p><h2 id="meal-complete-heading">今晚的菜</h2><p>目标都补齐了。可以返回调整，也可以开始做饭。</p>
      <ul class="meal-finish-list">{recipes.map((recipe) => <li data-complete-recipe={recipe.id} hidden><span aria-hidden="true">✓</span><strong>{recipe.nameZh}</strong><small>{recipe.nameEn}</small></li>)}</ul>
      <div class="meal-finish-actions"><button id="meal-modify" class="button button--secondary" type="button">修改选菜</button><button id="meal-start-cooking" class="button button--primary" type="button">开始做饭</button></div>
    </section>

      <section id="meal-cook-view" class="shell meal-cook" hidden aria-labelledby="meal-cook-heading">
      <div class="meal-section-heading"><div><h2 id="meal-cook-heading">开始做饭</h2></div><div class="meal-cook-actions"><button id="meal-back-to-menu" class="button button--secondary" type="button">返回选菜</button><button id="meal-open-checkout" class="button button--primary" type="button">下一步：结算</button></div></div>
      <div class="meal-cook-list">{recipes.map((recipe) => <details class="meal-cook-card" data-cook-recipe={recipe.id} hidden>
        <summary><span><strong>{recipe.nameZh}</strong><small>{recipe.nameEn}</small></span><span>{recipe.mealWindowMinutes || recipe.elapsedMinutes}</span></summary>
        <div class="meal-cook-card__body">
          <div class="badges"><span class="badge">{contributionText(recipe)}</span><span class="badge">{recipe.detailLevel === 'discoverable' ? '基础做法' : '可直接照做'}</span></div>
          {recipe.cookIngredientLines.length > 0 && <><h3>食材</h3><ul>{recipe.cookIngredientLines.map((line) => <li>{line}</li>)}</ul></>}
          <h3>步骤</h3><ol>{recipe.steps.map((step) => <li>{step}</li>)}</ol>
          {recipe.childServing && <><h3>孩子上桌</h3><p>{recipe.childServing}</p></>}
          {recipe.adultFinish && <><h3>成人收尾</h3><p>{recipe.adultFinish}</p></>}
          {recipe.substitutions.length > 0 && <><h3>替换</h3><ul>{recipe.substitutions.map((item) => <li>{item}</li>)}</ul></>}
        </div>
      </details>)}</div>
      <section id="meal-checkout" class="meal-checkout" hidden aria-labelledby="meal-checkout-heading">
        <div class="meal-section-heading"><div><h2 id="meal-checkout-heading">本顿消耗</h2></div><button id="meal-back-cook" class="button button--secondary" type="button">返回做饭</button></div>
        <div id="meal-checkout-list" class="meal-checkout-list"></div>
        <p id="meal-checkout-status" class="note-box" role="status"></p>
        <div class="meal-finish-actions"><button id="meal-confirm-checkout" class="button button--primary" type="button">核对消耗</button><button id="meal-finalize-checkout" class="button button--primary" type="button" hidden>确认并清除本顿</button></div>
      </section>
    </section>

    <section class="shell meal-readable-catalog" aria-labelledby="meal-readable-heading">
      <h2 id="meal-readable-heading">完整菜谱目录</h2><p>无需交互也可以阅读全部 {recipes.length} 道候选菜的基础信息。</p>
      <div class="meal-readable-grid">{recipes.map((recipe) => <article><h3>{recipe.nameZh}</h3><p>{recipe.nameEn}</p><p>{contributionText(recipe)} · {recipe.mealWindowMinutes || recipe.elapsedMinutes || recipe.activeMinutes}</p></article>)}</div>
    </section>
  </main>

  <script id="meal-data" type="application/json" is:inline set:html={clientData}></script>
  <script id="meal-firebase-config" type="application/json" is:inline set:html={clientFirebaseConfig}></script>
  <script>
    import { aggregateSelection, bindRecipeIngredients, calendarDateKey, defaultMealState, freshnessAgeDays, freshnessPriorityAgeDays, rankCandidates, reconcileMealState, resolveRecipeChildCoverage, timeFit, unmetCompletionRequirements } from '../lib/mealEngine';
    import type { MealIngredient, MealRecipe, MealState, TimePreference } from '../lib/mealEngine';
    import { addStock, adjustFrozenAggregate, adjustInventoryBatch, adjustReadyAggregate, advanceMealToCooking, cancelThaw, cleanupDiscardedStock, completeThaw, createCurrentMealFromInventory, discardStock, freshnessDatesForInventory, reconcileCurrentMeal, reconcileDueThawing, resetRecipeSelection, setCurrentMealStatus, startThaw, undoDiscard, type CurrentMeal, type HouseholdState } from '../lib/household';
    import { createHouseholdRepository, type RepositoryStatus } from '../lib/householdRepository';
    type View = 'build' | 'complete' | 'cook';
    type Payload = { version: string; starterSections: { id: string; labelZh: string }[]; ingredients: (MealIngredient & { visible?: boolean; section?: string })[]; recipes: MealRecipe[] };
    const payload = JSON.parse(document.querySelector<HTMLScriptElement>('#meal-data')!.textContent!) as Payload;
    const recipes = payload.recipes;
    const ingredients = payload.ingredients;
    const byId = new Map(recipes.map((recipe) => [recipe.id, recipe]));
    const ingredientById = new Map(ingredients.map((ingredient) => [ingredient.id, ingredient]));
    const storageKey = `family-hub-meal-builder-${payload.version}`;
    const firebaseConfig = JSON.parse(document.querySelector<HTMLScriptElement>('#meal-firebase-config')!.textContent!) as Record<string, string>;
    const repository = createHouseholdRepository(firebaseConfig, { ingredients, recipes, firebase: { ingredients, recipes } });
    let household: HouseholdState = repository.getSnapshot();
    let state: MealState = household.currentMeal ? { ...mealStateFromCurrentMeal(household.currentMeal) } : defaultMealState(); let view: View = household.activeStep === 'cook' || household.activeStep === 'checkout' ? 'cook' : household.activeStep === 'recipes' ? 'build' : 'build';
    let repositoryStatus: RepositoryStatus = repository.getStatus(); let showAllInventory = false;
    let draftBindings: Record<string, (string | null)[]> = {};
    try {
      const saved = JSON.parse(sessionStorage.getItem(storageKey) ?? 'null');
      if (!household.currentMeal && saved?.state) state = reconcileMealState({ ...defaultMealState(), ...saved.state }, recipes, ingredients);
      if (!household.currentMeal) view = saved?.view ?? 'build';
    } catch { sessionStorage.removeItem(storageKey); }
    state = reconcileMealState({ ...state, availableIngredientIds: state.availableIngredientIds.filter((id) => ingredientById.has(id)) }, recipes, ingredients);

    function mealStateFromCurrentMeal(meal: CurrentMeal): MealState {
      return { availableIngredientIds: [...meal.availableIngredientIds], ingredientFreshnessDates: { ...meal.ingredientFreshnessDates }, proteinTarget: meal.proteinTarget, vegetableTarget: meal.vegetableTarget, stapleRequired: meal.stapleRequired, childMode: meal.childMode, timePreference: meal.timePreference, selectedRecipeIds: [...meal.selectedRecipeIds], recipeIngredientBindings: { ...meal.recipeIngredientBindings } };
    }

    const app = document.querySelector<HTMLElement>('.meal-builder-app')!; app.dataset.enhanced = 'true';
    const builder = document.querySelector<HTMLElement>('#meal-builder-view')!; const complete = document.querySelector<HTMLElement>('#meal-complete-view')!; const cook = document.querySelector<HTMLElement>('#meal-cook-view')!;
    const live = document.querySelector<HTMLElement>('#meal-live')!; const recipeGrid = document.querySelector<HTMLElement>('#meal-recipe-grid')!; const selectedPanel = document.querySelector<HTMLElement>('#meal-selected-panel')!; const nextButton = document.querySelector<HTMLButtonElement>('#meal-next')!; const forceNextButton = document.querySelector<HTMLButtonElement>('#meal-force-next')!; const completionStatus = document.querySelector<HTMLElement>('#meal-completion-status')!;
    const protein = document.querySelector<HTMLSelectElement>('#meal-protein')!; const vegetable = document.querySelector<HTMLSelectElement>('#meal-vegetable')!; const time = document.querySelector<HTMLSelectElement>('#meal-time')!; const staple = document.querySelector<HTMLInputElement>('#meal-staple')!; const child = document.querySelector<HTMLInputElement>('#meal-child')!;
    const connection = document.querySelector<HTMLElement>('#meal-connection')!; const account = document.querySelector<HTMLElement>('#meal-account')!; const authDetail = document.querySelector<HTMLElement>('#meal-auth-detail')!; const googleLogin = document.querySelector<HTMLButtonElement>('#meal-google-login')!; const accessRefresh = document.querySelector<HTMLButtonElement>('#meal-access-refresh')!; const logout = document.querySelector<HTMLButtonElement>('#meal-logout')!; const sharedStatus = document.querySelector<HTMLElement>('#meal-shared-status')!; const inventoryList = document.querySelector<HTMLElement>('#meal-inventory-list')!; const undoNotices = document.querySelector<HTMLElement>('#meal-undo-notices')!;
    const checkout = document.querySelector<HTMLElement>('#meal-checkout')!; const openCheckout = document.querySelector<HTMLButtonElement>('#meal-open-checkout')!; const confirmCheckout = document.querySelector<HTMLButtonElement>('#meal-confirm-checkout')!;
