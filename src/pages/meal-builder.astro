---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { mealData } from '../data/meal';

const visibleIngredients = mealData.ingredients.filter((ingredient) => ingredient.visible);
const recipes = mealData.recipes;
type StarterSection = { id: string; labelZh: string; labelEn: string; order: number; visible: boolean };
const clientData = JSON.stringify({ version: mealData.metadata.version, recipes: recipes.map((recipe) => ({
  id: recipe.id, order: recipe.order, fitScore: recipe.fitScore, contribution: recipe.contribution,
  childCoverage: recipe.childCoverage, requirements: recipe.requirements, mealWindowMinutes: recipe.mealWindowMinutes,
  elapsedMinutes: recipe.elapsedMinutes, advanceStartRequired: recipe.advanceStartRequired,
})) });
const contributionText = (recipe: (typeof recipes)[number]) => [
  recipe.contribution.protein ? `Protein ${recipe.contribution.protein === .5 ? '½' : recipe.contribution.protein}` : '',
  recipe.contribution.vegetable ? `Vegetable ${recipe.contribution.vegetable}` : '',
  recipe.contribution.staple ? 'Staple ✓' : '',
].filter(Boolean).join(' · ');
---
<BaseLayout title="Meal Builder | Family Hub" description="按本顿可用食材和家庭组餐目标，实时选择合适的菜。" pageClass="module-page theme-berry meal-builder-page" themeColor="#F3E8EC">
  <SiteHeader eyebrow="饮食与家庭 · 动态组餐" title="Meal Builder" description="先勾选这顿可以使用的食材，再逐步补齐 Protein、Vegetable、Staple 和孩子需要的菜。食材可用不代表每样都必须用。" accent="berry" icon="meal">
    <div class="summary-row"><span>{visibleIngredients.length} 种可选食材</span><span>{recipes.length} 道候选菜</span><span>实时补齐组餐缺口</span><span>KB v{mealData.metadata.version}</span></div>
  </SiteHeader>

  <main id="main-content" class="meal-builder-app" data-enhanced="false">
    <noscript><div class="shell meal-noscript note-box"><strong>当前是阅读模式。</strong>启用 JavaScript 后可以选择食材、实时组餐和进入 Cook View；下方仍完整列出食材与菜谱。</div></noscript>

    <div id="meal-live" class="sr-only" aria-live="polite"></div>
    <section id="meal-builder-view" class="shell meal-workspace" aria-label="组餐设置与候选菜">
      <section class="meal-targets" aria-labelledby="meal-targets-heading">
        <div class="meal-section-heading"><div><p class="eyebrow">01 · 这顿需要什么</p><h2 id="meal-targets-heading">组餐目标</h2></div><button id="meal-reset" class="clear-button" type="button">重新开始</button></div>
        <div class="meal-target-grid">
          <label><span>Protein</span><select id="meal-protein"><option value="1">1</option><option value="2">2</option><option value="3">3</option></select></label>
          <label><span>Vegetable</span><select id="meal-vegetable"><option value="1">1</option><option value="2" selected>2</option><option value="3">3</option></select></label>
          <label><span>时间</span><select id="meal-time"><option value="any">不限</option><option value="30">约 30 分钟</option><option value="45">约 45 分钟</option><option value="60">约 60 分钟</option></select></label>
          <label class="meal-toggle"><input id="meal-staple" type="checkbox" checked /><span><strong>需要 Staple</strong><small>米饭、面或菜中自带主食</small></span></label>
          <label class="meal-toggle"><input id="meal-child" type="checkbox" checked /><span><strong>孩子一起吃</strong><small>孩子蛋白和蔬菜都是必需项</small></span></label>
        </div>
      </section>

      <section class="meal-ingredients" aria-labelledby="meal-ingredients-heading">
        <div class="meal-section-heading"><div><p class="eyebrow">02 · 今天有什么</p><h2 id="meal-ingredients-heading">可用食材</h2><p>只选这顿可以拿来做菜的食材。收起分组不会清除选择。</p></div><span id="meal-ingredient-count" class="meal-count">已选 0</span></div>
        <div class="meal-ingredient-sections">
          {mealData.starterSections.map((section: StarterSection, index: number) => {
            const sectionIngredients = visibleIngredients.filter((ingredient) => ingredient.section === section.id);
            return <details class="meal-ingredient-section" data-ingredient-section={section.id} open={index < 2}>
              <summary><span><strong>{section.labelZh}</strong><small>{section.labelEn}</small></span><span data-section-count>0 / {sectionIngredients.length}</span></summary>
              <div class="meal-chip-grid">{sectionIngredients.map((ingredient) => <button class="meal-chip" type="button" aria-pressed="false" data-ingredient-id={ingredient.id}><span aria-hidden="true">✓</span><strong>{ingredient.nameZh}</strong><small>{ingredient.nameEn}</small></button>)}</div>
            </details>;
          })}
        </div>
      </section>

      <section class="meal-results" aria-labelledby="meal-results-heading">
        <div class="meal-progress" aria-label="当前组餐进度">
          <div><span>Protein</span><strong id="progress-protein">0 / 1</strong></div>
          <div><span>Vegetable</span><strong id="progress-vegetable">0 / 2</strong></div>
          <div><span>Staple</span><strong id="progress-staple">○</strong></div>
          <div data-child-progress><span>孩子蛋白</span><strong id="progress-child-protein">○</strong></div>
          <div data-child-progress><span>孩子蔬菜</span><strong id="progress-child-vegetable">○</strong></div>
        </div>

        <div id="meal-selected-panel" class="meal-selected" hidden>
          <h3>已选的菜</h3>
          <ul>{recipes.map((recipe) => <li data-selected-recipe={recipe.id} hidden><span><strong>{recipe.nameZh}</strong><small>{contributionText(recipe)}</small></span><button type="button" data-remove-recipe={recipe.id}>移除</button></li>)}</ul>
        </div>

        <div class="meal-section-heading"><div><p class="eyebrow">03 · 逐步补齐</p><h2 id="meal-results-heading">候选菜</h2><p id="meal-guidance">先选择可用食材，候选菜会在这里出现。</p></div><span id="meal-result-count" class="meal-count" aria-live="polite">0 道可选</span></div>
        <div id="meal-recipe-grid" class="meal-recipe-grid">
          {recipes.map((recipe) => <article class="meal-recipe-card" data-meal-recipe={recipe.id}>
            <div class="meal-recipe-card__heading"><div><h3>{recipe.nameZh}</h3><p>{recipe.nameEn}</p></div><span class="meal-role">{recipe.primaryRole}</span></div>
            <div class="badges"><span class="badge">{contributionText(recipe)}</span>{recipe.childCoverage.protein && <span class="badge">孩子蛋白 ✓</span>}{recipe.childCoverage.vegetable && <span class="badge">孩子蔬菜 ✓</span>}<span class="badge" data-time-badge hidden></span></div>
            <p class="meal-timing">{recipe.mealWindowMinutes || recipe.elapsedMinutes || recipe.activeMinutes}{recipe.advanceStartRequired ? ' · 需提前开始' : ''}</p>
            <p class="meal-equipment">{recipe.equipment.join(' · ')}</p>
            <button class="button button--primary" type="button" data-select-recipe={recipe.id}>选择这道菜</button>
          </article>)}
        </div>
        <p id="meal-empty" class="empty-state" hidden>目前没有能补齐缺口的候选菜。增加可用食材，或调整组餐目标。</p>
      </section>
    </section>

    <section id="meal-complete-view" class="shell meal-finish" hidden aria-labelledby="meal-complete-heading">
      <p class="eyebrow">组餐完成</p><h2 id="meal-complete-heading">今晚的菜</h2><p>目标都补齐了。可以返回调整，也可以进入做饭视图。</p>
      <ul class="meal-finish-list">{recipes.map((recipe) => <li data-complete-recipe={recipe.id} hidden><span aria-hidden="true">✓</span><strong>{recipe.nameZh}</strong><small>{recipe.nameEn}</small></li>)}</ul>
      <div class="meal-finish-actions"><button id="meal-modify" class="button button--secondary" type="button">修改选菜</button><button id="meal-start-cooking" class="button button--primary" type="button">开始做饭</button></div>
    </section>

    <section id="meal-cook-view" class="shell meal-cook" hidden aria-labelledby="meal-cook-heading">
      <div class="meal-section-heading"><div><p class="eyebrow">Cook View</p><h2 id="meal-cook-heading">开始做饭</h2><p>这里只显示本次选中的菜。内容按 KB 当前完成度呈现，不补造精确用量。</p></div><button id="meal-back-to-menu" class="button button--secondary" type="button">返回菜单</button></div>
      <div class="meal-cook-list">{recipes.map((recipe) => <details class="meal-cook-card" data-cook-recipe={recipe.id} hidden>
        <summary><span><strong>{recipe.nameZh}</strong><small>{recipe.nameEn}</small></span><span>{recipe.mealWindowMinutes || recipe.elapsedMinutes}</span></summary>
        <div class="meal-cook-card__body">
          <div class="badges"><span class="badge">{contributionText(recipe)}</span><span class="badge">{recipe.detailLevel === 'discoverable' ? '基础做法' : '可直接照做'}</span></div>
          {recipe.detailLevel === 'discoverable' && <p class="note-box">这道菜目前只有可靠的结构和基础步骤；精确用量仍需按来源或首次家庭实做校准。</p>}
          <h3>步骤</h3><ol>{recipe.steps.map((step) => <li>{step}</li>)}</ol>
          {recipe.childServing && <><h3>孩子上桌</h3><p>{recipe.childServing}</p></>}
          {recipe.adultFinish && <><h3>成人收尾</h3><p>{recipe.adultFinish}</p></>}
          {recipe.substitutions.length > 0 && <><h3>替换</h3><ul>{recipe.substitutions.map((item) => <li>{item}</li>)}</ul></>}
        </div>
      </details>)}</div>
    </section>

    <section class="shell meal-readable-catalog" aria-labelledby="meal-readable-heading">
      <h2 id="meal-readable-heading">完整菜谱目录</h2><p>无需交互也可以阅读全部 {recipes.length} 道候选菜的基础信息。</p>
      <div class="meal-readable-grid">{recipes.map((recipe) => <article><h3>{recipe.nameZh}</h3><p>{recipe.nameEn}</p><p>{contributionText(recipe)} · {recipe.mealWindowMinutes || recipe.elapsedMinutes || recipe.activeMinutes}</p></article>)}</div>
    </section>
  </main>
  <footer class="module-footer"><div class="shell note-box">Meal Builder 是组餐参考，不是营养计算器。时间是工作量信号；第一次做仍应按可靠来源确认火候、安全温度和具体比例。本页不保存姓名、生日、地址、日程或其他私人资料。</div></footer>

  <script id="meal-data" type="application/json" is:inline set:html={clientData}></script>
  <script>
    import { aggregateMeal, defaultMealState, isFeasible, isMealComplete, rankCandidates, timeFit } from '../lib/mealEngine';
    import type { MealRecipe, MealState, TimePreference } from '../lib/mealEngine';
    type Recipe = MealRecipe;
    type View = 'build' | 'complete' | 'cook';
    const payload = JSON.parse(document.querySelector<HTMLScriptElement>('#meal-data')!.textContent!) as { version: string; recipes: Recipe[] };
    const recipes = payload.recipes;
    const byId = new Map(recipes.map((recipe) => [recipe.id, recipe]));
    const storageKey = `family-hub-meal-builder-${payload.version}`;
    let state: MealState = defaultMealState(); let view: View = 'build'; let suppressAutoComplete = false;
    try { const saved = JSON.parse(sessionStorage.getItem(storageKey) ?? 'null'); if (saved?.state) { state = { ...defaultMealState(), ...saved.state }; view = saved.view ?? 'build'; } } catch { sessionStorage.removeItem(storageKey); }
    state.availableIngredientIds = state.availableIngredientIds.filter((id) => document.querySelector(`[data-ingredient-id="${CSS.escape(id)}"]`));
    const restoredAvailable = new Set(state.availableIngredientIds);
    state.selectedRecipeIds = state.selectedRecipeIds.filter((id) => { const recipe = byId.get(id); return recipe && isFeasible(recipe, restoredAvailable); });

    const app = document.querySelector<HTMLElement>('.meal-builder-app')!; app.dataset.enhanced = 'true';
    const builder = document.querySelector<HTMLElement>('#meal-builder-view')!; const complete = document.querySelector<HTMLElement>('#meal-complete-view')!; const cook = document.querySelector<HTMLElement>('#meal-cook-view')!;
    const live = document.querySelector<HTMLElement>('#meal-live')!; const recipeGrid = document.querySelector<HTMLElement>('#meal-recipe-grid')!;
    const protein = document.querySelector<HTMLSelectElement>('#meal-protein')!; const vegetable = document.querySelector<HTMLSelectElement>('#meal-vegetable')!; const time = document.querySelector<HTMLSelectElement>('#meal-time')!; const staple = document.querySelector<HTMLInputElement>('#meal-staple')!; const child = document.querySelector<HTMLInputElement>('#meal-child')!;
    const save = () => sessionStorage.setItem(storageKey, JSON.stringify({ state, view }));
    const announce = (message: string) => { live.textContent = ''; requestAnimationFrame(() => { live.textContent = message; }); };
    const selectedRecipes = () => state.selectedRecipeIds.map((id) => byId.get(id)).filter((recipe): recipe is Recipe => Boolean(recipe));
    const setView = (next: View) => { view = next; builder.hidden = next !== 'build'; complete.hidden = next !== 'complete'; cook.hidden = next !== 'cook'; save(); window.scrollTo({ top: 0, behavior: 'smooth' }); };

    function render(selectionChanged = false) {
      protein.value = String(state.proteinTarget); vegetable.value = String(state.vegetableTarget); time.value = state.timePreference; staple.checked = state.stapleRequired; child.checked = state.childMode;
      const available = new Set(state.availableIngredientIds);
      document.querySelectorAll<HTMLButtonElement>('[data-ingredient-id]').forEach((button) => { const active = available.has(button.dataset.ingredientId!); button.setAttribute('aria-pressed', String(active)); });
      document.querySelectorAll<HTMLElement>('[data-ingredient-section]').forEach((section) => { const buttons = [...section.querySelectorAll<HTMLButtonElement>('[data-ingredient-id]')]; section.querySelector<HTMLElement>('[data-section-count]')!.textContent = `${buttons.filter((button) => button.getAttribute('aria-pressed') === 'true').length} / ${buttons.length}`; });
      document.querySelector<HTMLElement>('#meal-ingredient-count')!.textContent = `已选 ${available.size}`;

      const selected = selectedRecipes(); const totals = aggregateMeal(selected);
      document.querySelector('#progress-protein')!.textContent = `${totals.protein} / ${state.proteinTarget}`;
      document.querySelector('#progress-vegetable')!.textContent = `${totals.vegetable} / ${state.vegetableTarget}`;
      document.querySelector('#progress-staple')!.textContent = state.stapleRequired ? (totals.staple >= 1 ? '✓' : '○') : '不需要';
      document.querySelector('#progress-child-protein')!.textContent = totals.childProtein ? '✓' : '○'; document.querySelector('#progress-child-vegetable')!.textContent = totals.childVegetable ? '✓' : '○';
      document.querySelectorAll<HTMLElement>('[data-child-progress]').forEach((item) => item.hidden = !state.childMode);
      const selectedSet = new Set(state.selectedRecipeIds); document.querySelector<HTMLElement>('#meal-selected-panel')!.hidden = selectedSet.size === 0;
      document.querySelectorAll<HTMLElement>('[data-selected-recipe]').forEach((item) => item.hidden = !selectedSet.has(item.dataset.selectedRecipe!));
      document.querySelectorAll<HTMLElement>('[data-complete-recipe]').forEach((item) => item.hidden = !selectedSet.has(item.dataset.completeRecipe!));
      document.querySelectorAll<HTMLElement>('[data-cook-recipe]').forEach((item) => item.hidden = !selectedSet.has(item.dataset.cookRecipe!));

      const candidates = rankCandidates(recipes, state) as Recipe[]; const candidateIds = new Set(candidates.map((recipe) => recipe.id));
      document.querySelectorAll<HTMLElement>('[data-meal-recipe]').forEach((card) => { card.hidden = !candidateIds.has(card.dataset.mealRecipe!); });
      candidates.forEach((recipe) => { const card = document.querySelector<HTMLElement>(`[data-meal-recipe="${CSS.escape(recipe.id)}"]`)!; const badge = card.querySelector<HTMLElement>('[data-time-badge]')!; const fit = timeFit(recipe, state.timePreference); badge.hidden = !fit.label; badge.textContent = fit.label; recipeGrid.append(card); });
      document.querySelector('#meal-result-count')!.textContent = `${candidates.length} 道可选`;
      document.querySelector<HTMLElement>('#meal-empty')!.hidden = candidates.length > 0;
      document.querySelector('#meal-guidance')!.textContent = available.size === 0 ? '先选择可用食材，候选菜会在这里出现。' : candidates.length ? '优先显示能补齐更多当前缺口、同时减少多余份数的菜。' : '增加可用食材，或调整组餐目标。';

      const done = isMealComplete(state, totals);
      if (selectionChanged && done && !suppressAutoComplete) view = 'complete';
      if (!done && view !== 'build') view = 'build';
      suppressAutoComplete = false; builder.hidden = view !== 'build'; complete.hidden = view !== 'complete'; cook.hidden = view !== 'cook'; save();
    }

    document.querySelectorAll<HTMLButtonElement>('[data-ingredient-id]').forEach((button) => button.addEventListener('click', () => {
      const id = button.dataset.ingredientId!; const available = new Set(state.availableIngredientIds); available.has(id) ? available.delete(id) : available.add(id); state.availableIngredientIds = [...available];
      const feasibleSelected = selectedRecipes().filter((recipe) => isFeasible(recipe, available)); const removed = state.selectedRecipeIds.length - feasibleSelected.length; state.selectedRecipeIds = feasibleSelected.map((recipe) => recipe.id);
      render(true); announce(removed ? `已取消食材，并移除 ${removed} 道无法制作的已选菜。` : `已${available.has(id) ? '选择' : '取消'}食材。`);
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-select-recipe]').forEach((button) => button.addEventListener('click', () => { state.selectedRecipeIds = [...state.selectedRecipeIds, button.dataset.selectRecipe!]; render(true); announce('已加入一道菜。'); }));
    document.querySelectorAll<HTMLButtonElement>('[data-remove-recipe]').forEach((button) => button.addEventListener('click', () => { state.selectedRecipeIds = state.selectedRecipeIds.filter((id) => id !== button.dataset.removeRecipe); render(true); announce('已移除一道菜。'); }));
    protein.addEventListener('change', () => { state.proteinTarget = Number(protein.value); render(true); }); vegetable.addEventListener('change', () => { state.vegetableTarget = Number(vegetable.value); render(true); }); time.addEventListener('change', () => { state.timePreference = time.value as TimePreference; render(); }); staple.addEventListener('change', () => { state.stapleRequired = staple.checked; render(true); }); child.addEventListener('change', () => { state.childMode = child.checked; render(true); });
    document.querySelector('#meal-reset')!.addEventListener('click', () => { state = defaultMealState(); view = 'build'; sessionStorage.removeItem(storageKey); render(); announce('Meal Builder 已重新开始。'); });
    document.querySelector('#meal-modify')!.addEventListener('click', () => { suppressAutoComplete = true; setView('build'); render(); }); document.querySelector('#meal-start-cooking')!.addEventListener('click', () => setView('cook')); document.querySelector('#meal-back-to-menu')!.addEventListener('click', () => setView('complete'));
    render();
  </script>
</BaseLayout>
