---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ModuleCard from '../components/ModuleCard.astro';
import modules from '../data/modules.json';
import destinations from '../data/day-trips.json';
import events from '../data/library-events.json';
import dentists from '../data/pediatric-dentists.json';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const moduleCounts: Record<string, number> = { 'day-trips': destinations.length, 'library-activities': events.length, 'pediatric-dentists': dentists.length };
const moduleLabels: Record<string, string> = { 'day-trips': 'places', 'library-activities': 'activities', 'pediatric-dentists': 'practices' };
const symbols: Record<string, string> = { 'day-trips': 'DT', 'library-activities': 'LA', 'pediatric-dentists': 'PD' };
const latestDate = (records: Array<{ verifiedDate: string }>) => {
  const dates = records.map((item) => item.verifiedDate).filter(Boolean).sort();
  return dates.length ? `Updated ${dates.at(-1)}` : 'Verification date not recorded';
};
const updatedLabels: Record<string, string> = { 'day-trips': latestDate(destinations), 'library-activities': latestDate(events), 'pediatric-dentists': latestDate(dentists) };
---
<BaseLayout title="Family Hub" description="One shared entrance for family day trips, library activities, and pediatric dentist research.">
  <main class="home-page">
    <SiteHeader home kicker="One family · one shared entrance" title="Family Hub" description="A calm, shared starting point for choosing a day trip, finding a library activity, or comparing pediatric dentists." />
    <section class="module-grid shell" aria-label="Family Hub modules">
      {modules.map((module) => (
        <ModuleCard title={module.title} description={module.description} href={withBase(module.href)} count={moduleCounts[module.id]} label={moduleLabels[module.id]} accent={module.accent} symbol={symbols[module.id]} updated={updatedLabels[module.id]} />
      ))}
    </section>
  </main>
</BaseLayout>
