---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleCard from '../components/ModuleCard.astro';
import { categoryDefinitions, moduleRegistry, type ModuleId } from '../config/modules';
import { adultDermatologists, colonoscopySpecialists, dayTrips, libraryEvents, obGynProviders, pediatricDentists, restaurants, latestVerifiedDate, moduleRecords } from '../data/catalog';
import { mealData } from '../data/meal';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const verifiedDates: Partial<Record<ModuleId, string>> = {
  'day-trips': latestVerifiedDate(dayTrips),
  'library-activities': latestVerifiedDate(libraryEvents),
  'pediatric-dentists': latestVerifiedDate(pediatricDentists),
  'adult-dermatologists': latestVerifiedDate(adultDermatologists),
  'colonoscopy-specialists': latestVerifiedDate(colonoscopySpecialists),
  'ob-gyn': latestVerifiedDate(obGynProviders),
  'meal-builder': mealData.metadata.lastUpdated,
  'restaurants': latestVerifiedDate(restaurants),
};
const publicCounts: Partial<Record<ModuleId, number>> = Object.fromEntries(
  Object.entries(moduleRecords).map(([id, records]) => [id, records?.length ?? 0]),
) as Partial<Record<ModuleId, number>>;
const visibleCategories = categoryDefinitions.filter((category) => moduleRegistry.some((module) => module.categoryId === category.id));
---
<BaseLayout title="Family Hub" description="适合手机使用的家庭出行、活动、照护与共享工具入口。" pageClass="home-page">
  <main id="main-content">
    <header class="home-hero shell">
      <p class="eyebrow">A shared family field guide</p>
      <h1>Family Hub</h1>
      <p class="home-lead">把经常需要查找、筛选和比较的家庭资料放在一个清楚的入口里。先选择需要解决的问题，再进入适合它的列表。</p>
      <label class="home-search">
        <span>查找一个工具</span>
        <input id="module-search" type="search" placeholder="例如：公园、storytime、牙医、todo…" autocomplete="off" />
      </label>
      <p id="module-search-status" class="search-status" aria-live="polite">{moduleRegistry.length} 个可用工具</p>
    </header>

    <div class="home-directory shell">
      {visibleCategories.map((category) => {
        const modules = moduleRegistry.filter((module) => module.categoryId === category.id);
        return <section class:list={['category-section', `theme-${category.accent}`]} data-category-section={category.id}>
          <div class="category-heading">
            <span class="category-index" aria-hidden="true">{String(category.order).padStart(2, '0')}</span>
            <div><h2>{category.title}</h2><p>{category.description}</p></div>
          </div>
          <div class="module-list">
            {modules.map((module) => <ModuleCard module={module} href={withBase(module.route)} count={publicCounts[module.id]} verifiedDate={verifiedDates[module.id]} />)}
          </div>
        </section>;
      })}
      <p id="module-empty" class="empty-state" hidden>没有找到对应工具。试试“出行”、“library”、“牙医”、“todo”或“皮肤科”。</p>
    </div>
  </main>
  <footer class="site-footer"><div class="shell"><p>公开目录不包含家庭私有数据；需要登录的家庭工具只在授权后读取共享状态。</p></div></footer>
  <script>
    const search = document.querySelector<HTMLInputElement>('#module-search')!;
    const modules = [...document.querySelectorAll<HTMLElement>('[data-module]')];
    const sections = [...document.querySelectorAll<HTMLElement>('[data-category-section]')];
    const status = document.querySelector<HTMLElement>('#module-search-status')!;
    const empty = document.querySelector<HTMLElement>('#module-empty')!;
    const render = () => {
      const query = search.value.trim().toLocaleLowerCase();
      let visibleCount = 0;
      modules.forEach((module) => {
        const visible = !query || module.dataset.search!.includes(query);
        module.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      sections.forEach((section) => section.hidden = ![...section.querySelectorAll<HTMLElement>('[data-module]')].some((module) => !module.hidden));
      status.textContent = query ? `找到 ${visibleCount} 个工具` : `${modules.length} 个可用工具`;
      empty.hidden = visibleCount > 0;
    };
    search.addEventListener('input', render);
  </script>
</BaseLayout>
