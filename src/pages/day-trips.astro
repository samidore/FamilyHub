---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DestinationCard from '../components/DestinationCard.astro';
import destinations from '../data/day-trips.json';

const categories = [...new Set(destinations.map((item) => item.category))].sort();
const statuses = [...new Set(destinations.map((item) => item.status))].sort();
const conditions = [...new Set(destinations.flatMap((item) => item.conditions))].sort();
const ratingOptions = [3, 3.5, 4, 4.5, 5];
---
<BaseLayout title="Day Trips | Family Hub" description="Filter and compare 29 family day-trip destinations.">
  <SiteHeader kicker="Fair Lawn · Northern NJ · Lower Hudson Valley" title="Day Trips" description="Nature, science, local parks, playgrounds, animals, and gardens. Verified facts are kept separate from our family-specific assessment." >
    <div class="summary-row"><span>29 places</span><span>5–70 minute drives</span><span>No destination photos</span></div>
  </SiteHeader>
  <section class="controls" aria-label="Day trip filters">
    <div class="shell controls-inner">
      <div class="primary-controls">
        <label class="search-label"><span>Search</span><input id="trip-search" type="search" placeholder="Animals, rain, ponds, science…" /></label>
        <label><span>Sort</span><select id="trip-sort"><option value="recommended">Recommended</option><option value="drive">Shortest drive</option><option value="toddler">Toddler rating</option><option value="parent">Parent rating</option><option value="name">Name</option></select></label>
      </div>
      <button class="filter-toggle" id="trip-filter-toggle" type="button" aria-expanded="false" aria-controls="trip-filter-panel">Show filters</button>
      <div class="filter-grid" id="trip-filter-panel">
        <label><span>Category</span><select id="trip-category"><option value="">All categories</option>{categories.map((item) => <option value={item}>{item}</option>)}</select></label>
        <label><span>Drive time</span><select id="trip-drive"><option value="">Any drive</option><option value="20">Up to 20 min</option><option value="40">21–40 min</option><option value="60">41–60 min</option><option value="61">60+ min</option></select></label>
        <label><span>Weather / use case</span><select id="trip-condition"><option value="">Any condition</option>{conditions.map((item) => <option value={item}>{item}</option>)}</select></label>
        <label><span>Family status</span><select id="trip-status"><option value="">Any status</option>{statuses.map((item) => <option value={item}>{item}</option>)}</select></label>
        {['indoor', 'outdoor', 'stroller', 'weather'].map((key) => <label><span>Min. {key === 'weather' ? 'weather tolerance' : key}</span><select id={`trip-${key}`} data-rating-filter={key}><option value="">Any rating</option>{ratingOptions.map((value) => <option value={value}>{value}+</option>)}</select></label>)}
      </div>
      <div class="filter-footer"><p id="trip-count" aria-live="polite">Showing 29 of 29 places</p><button id="trip-clear" class="clear-button" type="button">Clear filters</button></div>
    </div>
  </section>
  <main class="shell listing-main"><div id="trip-list" class="destination-grid">{destinations.map((destination) => <DestinationCard destination={destination} />)}</div><p id="trip-empty" class="empty-state" hidden>No destinations match those filters.</p></main>
  <footer><div class="shell note-box"><strong>Plan with current sources.</strong> Opening hours, fees, registration, construction, and seasonal facilities can change. Use each official link before leaving.</div></footer>
  <script>
    const cards = [...document.querySelectorAll<HTMLElement>('[data-destination]')];
    const search = document.querySelector<HTMLInputElement>('#trip-search')!;
    const sort = document.querySelector<HTMLSelectElement>('#trip-sort')!;
    const category = document.querySelector<HTMLSelectElement>('#trip-category')!;
    const drive = document.querySelector<HTMLSelectElement>('#trip-drive')!;
    const condition = document.querySelector<HTMLSelectElement>('#trip-condition')!;
    const status = document.querySelector<HTMLSelectElement>('#trip-status')!;
    const ratingFilters = [...document.querySelectorAll<HTMLSelectElement>('[data-rating-filter]')];
    const list = document.querySelector<HTMLElement>('#trip-list')!;
    const count = document.querySelector<HTMLElement>('#trip-count')!;
    const empty = document.querySelector<HTMLElement>('#trip-empty')!;
    const number = (card: HTMLElement, key: string) => Number(card.dataset[key] || -1);
    function renderTrips() {
      const query = search.value.trim().toLocaleLowerCase();
      const visible = cards.filter((card) => {
        const max = number(card, 'driveMax');
        const driveMatches = !drive.value || (drive.value === '20' && max <= 20) || (drive.value === '40' && max > 20 && max <= 40) || (drive.value === '60' && max > 40 && max <= 60) || (drive.value === '61' && max > 60);
        return (!query || card.dataset.search!.includes(query)) && (!category.value || card.dataset.category === category.value) && driveMatches && (!condition.value || card.dataset.conditions!.split('|').includes(condition.value)) && (!status.value || card.dataset.status === status.value) && ratingFilters.every((filter) => !filter.value || number(card, filter.dataset.ratingFilter!) >= Number(filter.value));
      });
      const sorter: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        recommended: (a, b) => number(b, 'score') - number(a, 'score'), drive: (a, b) => number(a, 'driveMin') - number(b, 'driveMin'), toddler: (a, b) => number(b, 'toddler') - number(a, 'toddler'), parent: (a, b) => number(b, 'parent') - number(a, 'parent'), name: (a, b) => a.dataset.name!.localeCompare(b.dataset.name!),
      };
      cards.forEach((card) => card.hidden = !visible.includes(card));
      visible.sort(sorter[sort.value]).forEach((card) => list.append(card));
      count.textContent = `Showing ${visible.length} of ${cards.length} places`;
      empty.hidden = visible.length > 0;
    }
    [search, sort, category, drive, condition, status, ...ratingFilters].forEach((control) => { control.addEventListener('input', renderTrips); control.addEventListener('change', renderTrips); });
    document.querySelector('#trip-clear')!.addEventListener('click', () => { [search, category, drive, condition, status, ...ratingFilters].forEach((control) => control.value = ''); sort.value = 'recommended'; renderTrips(); });
    const toggle = document.querySelector<HTMLButtonElement>('#trip-filter-toggle')!;
    const panel = document.querySelector<HTMLElement>('#trip-filter-panel')!;
    toggle.addEventListener('click', () => { const open = panel.classList.toggle('is-open'); toggle.setAttribute('aria-expanded', String(open)); toggle.textContent = open ? 'Hide filters' : 'Show filters'; });
    renderTrips();
  </script>
</BaseLayout>
