---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FilterShell from '../components/FilterShell.astro';
import DayTripCard from '../modules/day-trips/DayTripCard.astro';
import { dayTrips } from '../data/catalog';

const categories = [...new Set(dayTrips.map((item) => item.category))].sort();
const statuses = [...new Set(dayTrips.map((item) => item.status))].sort();
const conditions = [...new Set(dayTrips.flatMap((item) => item.conditions))].sort();
const ratingOptions = [3, 3.5, 4, 4.5, 5];
---
<BaseLayout title="Day Trips | Family Hub" description="按车程、天气、家庭适配与使用场景筛选 29 个家庭目的地。" pageClass="module-page theme-evergreen" themeColor="#E7EFE8">
  <SiteHeader eyebrow="出行与玩乐 · 目的地" title="Day Trips" description="按车程、天气和孩子当天的活动需求，筛选附近的公园、playground、自然中心、动物园和其他适合全家出门的地方。" accent="evergreen" icon="compass">
    <div class="summary-row"><span>29 个地点</span><span>约 5–60 分钟车程</span><span>无目的地图片</span></div>
  </SiteHeader>

  <FilterShell accent="evergreen" filterId="trip-filter-panel" countId="trip-count" clearId="trip-clear" countText="显示 29 / 29 个地点">
    <div slot="primary" class="filter-primary__grid">
      <label><span>搜索地点</span><input id="trip-search" type="search" placeholder="动物、雨天、池塘、science…" autocomplete="off" /></label>
      <label><span>排序</span><select id="trip-sort" data-default="recommended"><option value="recommended">家庭推荐</option><option value="drive">最短车程</option><option value="toddler">Toddler 评分</option><option value="parent">家长评分</option><option value="name">名称</option></select></label>
    </div>
    <div slot="filters" class="contents">
      <label><span>类别</span><select id="trip-category"><option value="">全部类别</option>{categories.map((item) => <option value={item}>{item}</option>)}</select></label>
      <label><span>车程</span><select id="trip-drive"><option value="">不限车程</option><option value="20">20 分钟内</option><option value="40">21–40 分钟</option><option value="60">41–60 分钟</option></select></label>
      <label><span>天气 / 使用场景</span><select id="trip-condition"><option value="">全部场景</option>{conditions.map((item) => <option value={item}>{item}</option>)}</select></label>
      <label><span>家庭状态</span><select id="trip-status"><option value="">全部状态</option>{statuses.map((item) => <option value={item}>{item}</option>)}</select></label>
      {['indoor', 'outdoor', 'stroller', 'weather'].map((key) => <label><span>最低 {key === 'weather' ? '天气容错' : key} 评分</span><select id={`trip-${key}`} data-rating-filter={key}><option value="">不限评分</option>{ratingOptions.map((value) => <option value={value}>{value}+</option>)}</select></label>)}
    </div>
  </FilterShell>

  <main id="main-content" class="shell listing-main">
    <div id="trip-list" class="record-grid">{dayTrips.map((destination) => <DayTripCard destination={destination} />)}</div>
    <p id="trip-empty" class="empty-state" hidden>没有符合这些条件的地点。清除部分筛选后再试。</p>
  </main>
  <footer class="module-footer"><div class="shell note-box"><strong>出发前使用最新官方资料。</strong> 开放时间、费用、registration、施工和季节性设施都可能变化。这里的家庭评分是判断，不是官方评级。</div></footer>

  <script>
    import { bindListState, clearListState, restoreListState } from '../lib/listState';
    const cards = [...document.querySelectorAll<HTMLElement>('[data-destination]')];
    const controls = {
      q: document.querySelector<HTMLInputElement>('#trip-search')!, sort: document.querySelector<HTMLSelectElement>('#trip-sort')!,
      category: document.querySelector<HTMLSelectElement>('#trip-category')!, drive: document.querySelector<HTMLSelectElement>('#trip-drive')!,
      condition: document.querySelector<HTMLSelectElement>('#trip-condition')!, status: document.querySelector<HTMLSelectElement>('#trip-status')!,
      indoor: document.querySelector<HTMLSelectElement>('#trip-indoor')!, outdoor: document.querySelector<HTMLSelectElement>('#trip-outdoor')!,
      stroller: document.querySelector<HTMLSelectElement>('#trip-stroller')!, weather: document.querySelector<HTMLSelectElement>('#trip-weather')!,
    };
    const list = document.querySelector<HTMLElement>('#trip-list')!;
    const count = document.querySelector<HTMLElement>('#trip-count')!;
    const empty = document.querySelector<HTMLElement>('#trip-empty')!;
    const number = (card: HTMLElement, key: string) => card.dataset[key] === '' ? -1 : Number(card.dataset[key] ?? -1);
    const render = () => {
      const query = controls.q.value.trim().toLocaleLowerCase();
      const visible = cards.filter((card) => {
        const drive = number(card, 'driveMin');
        const driveMatches = !controls.drive.value || (controls.drive.value === '20' && drive <= 20) || (controls.drive.value === '40' && drive > 20 && drive <= 40) || (controls.drive.value === '60' && drive > 40 && drive <= 60);
        return (!query || card.dataset.search!.includes(query)) && (!controls.category.value || card.dataset.category === controls.category.value) && driveMatches && (!controls.condition.value || card.dataset.conditions!.split('|').includes(controls.condition.value)) && (!controls.status.value || card.dataset.status === controls.status.value) && ['indoor', 'outdoor', 'stroller', 'weather'].every((key) => !controls[key as keyof typeof controls].value || number(card, key) >= Number(controls[key as keyof typeof controls].value));
      });
      const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        recommended: (a, b) => number(b, 'score') - number(a, 'score'), drive: (a, b) => number(a, 'driveMin') - number(b, 'driveMin'), toddler: (a, b) => number(b, 'toddler') - number(a, 'toddler'), parent: (a, b) => number(b, 'parent') - number(a, 'parent'), name: (a, b) => a.dataset.name!.localeCompare(b.dataset.name!),
      };
      cards.forEach((card) => card.hidden = !visible.includes(card));
      visible.sort(sorters[controls.sort.value]).forEach((card) => list.append(card));
      count.textContent = `显示 ${visible.length} / ${cards.length} 个地点`;
      empty.hidden = visible.length > 0;
    };
    restoreListState(controls);
    if (Object.values(controls).slice(2).some((control) => control.value)) document.querySelector<HTMLDetailsElement>('.filter-disclosure')!.open = true;
    bindListState(controls, render);
    document.querySelector('#trip-clear')!.addEventListener('click', () => clearListState(controls, render));
    render();
  </script>
</BaseLayout>
