---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/today.css';
import { mealData } from '../data/meal';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const payload = JSON.stringify({
  ingredients: mealData.ingredients.map((item) => ({
    id: item.id, nameZh: item.nameZh, inventoryTracking: item.inventoryTracking,
    inventoryFreshness: item.inventoryFreshness, freshnessPriorityDays: item.freshnessPriorityDays,
  })),
  recipes: mealData.recipes.map((recipe) => ({
    id: recipe.id, nameZh: recipe.nameZh,
    finishOptions: recipe.finishOptions?.map((finish) => ({
      id: finish.id, default: finish.default, displayNameZh: finish.displayNameZh,
    })),
  })),
}).replace(/</g, '\\u003c');
const firebaseConfig = JSON.stringify({
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY ?? '',
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN ?? '',
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID ?? '',
  databaseURL: import.meta.env.PUBLIC_FIREBASE_DATABASE_URL ?? '',
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID ?? '',
  webPushPublicKey: import.meta.env.PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY ?? '',
  householdId: import.meta.env.PUBLIC_FAMILY_HOUSEHOLD_ID ?? '',
}).replace(/</g, '\\u003c');
---
<BaseLayout title="今日看板 | FamilyHub" description="登录后查看这顿饭、紧急事项、反复干和家庭库存提醒。" pageClass="today-page theme-evergreen" themeColor="#e7efe8">
  <main id="main-content" class="shell today-shell">
    <nav class="today-nav" aria-label="页面导航">
      <a class="back-link" href={withBase('/')}>← Family Hub</a>
    </nav>
    <header class="today-hero">
      <div><p class="eyebrow">Home at a glance</p><h1>家庭今日看板</h1><p>今晚和明天的事、家里点的菜、要优先处理的事项。</p></div>
      <time id="today-date"></time>
    </header>
    <section id="today-connection" class="today-connection household-status" aria-live="polite">
      <p id="today-auth-message">正在确认家庭登录状态…</p>
      <div class="today-auth-actions">
        <button id="today-sign-in" type="button" hidden>使用 Google 登录</button>
        <button id="today-refresh-access" type="button" hidden>重新检查权限</button>
        <button id="today-retry-data" type="button" hidden>重新读取家庭数据</button>
        <button id="today-sign-out" type="button" hidden>退出登录</button>
      </div>
    </section>
    <section id="today-push" class="today-push" hidden>
      <div><strong>手机通知</strong><p id="today-push-status" aria-live="polite">正在检查设备通知状态…</p></div>
      <div class="today-auth-actions">
        <button id="today-enable-push" type="button" hidden>开启通知</button>
        <button id="today-disable-push" type="button" hidden>关闭通知</button>
        <button id="today-check-push" type="button" hidden>重新检查通知</button>
      </div>
    </section>
    <div id="today-dashboard" class="today-dashboard" hidden>
      <section data-source="notebook" class="today-card today-card--upcoming" aria-labelledby="today-upcoming-title">
        <div class="today-card-heading"><div><p class="today-kicker">COMING UP</p><h2 id="today-upcoming-title">今晚与接下来七天</h2></div><a href={withBase('/sami-notebook/')}>小本本</a></div>
        <div class="today-source-status" role="status"><p></p><button class="button button--secondary" data-retry-source="notebook" type="button" hidden>重新读取</button></div>
        <ul id="today-upcoming" class="today-list"></ul>
        <p id="today-upcoming-more" class="today-more" hidden></p>
      </section>
      <section data-source="state" class="today-card today-card--meal" aria-labelledby="today-meal-title">
        <div class="today-card-heading"><div><p class="today-kicker">MEAL PLAN</p><h2 id="today-meal-title">这顿吃什么</h2></div><a href={withBase('/meal-builder/')}>点菜 / 做饭</a></div>
        <div class="today-source-status" role="status"><p></p><button class="button button--secondary" data-retry-source="state" type="button" hidden>重新读取</button></div>
        <p id="today-meal-status" class="today-muted"></p>
        <ul id="today-meal-dishes" class="today-list"></ul>
        <p id="today-meal-note" class="today-meal-note" hidden></p>
        <p id="today-meal-queue" class="today-queue" hidden></p>
      </section>
      <section data-source="notebook" class="today-card today-card--urgent" aria-labelledby="today-urgent-title">
        <div class="today-card-heading"><div><p class="today-kicker">ACTION NEEDED</p><h2 id="today-urgent-title">Urgent</h2></div><a href={withBase('/sami-notebook/')}>处理事项</a></div>
        <div class="today-source-status" role="status"><p></p><button class="button button--secondary" data-retry-source="notebook" type="button" hidden>重新读取</button></div>
        <ul id="today-urgent" class="today-list"></ul>
        <p id="today-urgent-more" class="today-more" hidden></p>
      </section>
      <section data-source="state" class="today-card today-card--stock" aria-labelledby="today-stock-title">
        <div class="today-card-heading"><div><p class="today-kicker">KITCHEN</p><h2 id="today-stock-title">食材与化冻</h2></div><a href={withBase('/meal-builder/')}>管理库存</a></div>
        <div class="today-source-status" role="status"><p></p><button class="button button--secondary" data-retry-source="state" type="button" hidden>重新读取</button></div>
        <div id="today-stock" class="today-stock-groups"></div>
      </section>
    </div>
    <p class="today-footer">家庭数据仅在已验证的成员登录后，从 Firebase 读取；这里不保存第二份家庭清单。</p>
  </main>
  <script id="today-catalog" type="application/json" is:inline set:html={payload}></script>
  <script id="today-firebase" type="application/json" is:inline set:html={firebaseConfig}></script>
  <script>
    import { onValue, ref } from 'firebase/database';
    import { FirebaseHouseholdSession, hasCompleteFirebaseConfig, type FirebaseConfig, type HouseholdSessionStatus } from '../lib/householdSession.ts';
    import { normalizeHouseholdState, type HouseholdState } from '../lib/household.ts';
    import { normalizeNotebookState, type NotebookState, type NotebookItem } from '../lib/notebookDomain.ts';
    import { getNotebookDueSoonState, notebookLocalDateKey, notebookNextLocalMidnight } from '../lib/notebookDueSoon.ts';
    import { buildTodaySummary, type TodayCatalog } from '../lib/todayDomain.ts';
    import { disableTodayPush, enableTodayPush, todayPushAvailable, todayPushIsEnabled } from '../lib/todayPush.ts';

    const readJson = <T,>(id: string): T => JSON.parse(document.getElementById(id)!.textContent!) as T;
    const catalog = readJson<TodayCatalog>('today-catalog');
    const config = readJson<FirebaseConfig & { webPushPublicKey?: string }>('today-firebase');
    const base = import.meta.env.BASE_URL;
    const notebookHref = `${base.replace(/\/$/, '')}/sami-notebook/`;
    const dashboard = document.getElementById('today-dashboard')!;
    const authMessage = document.getElementById('today-auth-message')!;
    const loginButton = document.getElementById('today-sign-in') as HTMLButtonElement;
    const refreshButton = document.getElementById('today-refresh-access') as HTMLButtonElement;
    const retryButton = document.getElementById('today-retry-data') as HTMLButtonElement;
    const logoutButton = document.getElementById('today-sign-out') as HTMLButtonElement;
    const pushPanel = document.getElementById('today-push')!;
    const pushStatus = document.getElementById('today-push-status')!;
    const pushEnable = document.getElementById('today-enable-push') as HTMLButtonElement;
    const pushDisable = document.getElementById('today-disable-push') as HTMLButtonElement;
    const pushCheck = document.getElementById('today-check-push') as HTMLButtonElement;
    let pushCheckedUid = '';
    const mockRequested = import.meta.env.DEV && new URLSearchParams(location.search).get('mock')?.startsWith('today-');
    let session = !mockRequested && hasCompleteFirebaseConfig(config) ? new FirebaseHouseholdSession(config) : null;
    let preview: Awaited<ReturnType<typeof import('../dev/householdMock.ts').createTodayMock>> | undefined;
    let meal: HouseholdState | null = null;
    let notebook: NotebookState | null = null;
    let connectedUid = '';
    let errorMessage = '';
    let dataError = '';
    const sourceErrors = { state: '', notebook: '' };
    let mealLoading = true;
    let notebookLoading = true;
    let stopMeal: (() => void) | undefined;
    let stopNotebook: (() => void) | undefined;

    const showText = (id: string, text: string) => {
      const node = document.getElementById(id)!;
      node.textContent = text;
      node.hidden = !text;
    };
    const dateLabel = (item: NotebookItem, today: string) => {
      const due = getNotebookDueSoonState(item, today);
      if (due === 'overdue') return '已过期';
      if (due === 'today') return '今天';
      if (due === 'tomorrow') return '明天';
      return item.dueDate ? `${Number(item.dueDate.slice(5, 7))}/${Number(item.dueDate.slice(8))}` : '待处理';
    };
    function renderTasks(id: string, items: NotebookItem[], empty: string, today: string, limit: number) {
      const target = document.getElementById(id)!;
      const contentKey = JSON.stringify([items, today]);
      if (target.dataset.contentKey === contentKey) return;
      target.dataset.contentKey = contentKey;
      target.replaceChildren();
      if (!items.length) {
        const li = document.createElement('li'); li.className = 'today-empty'; li.textContent = empty; target.append(li);
      }
      for (const item of items.slice(0, limit)) {
        const li = document.createElement('li');
        const link = document.createElement('a'); link.href = notebookHref; link.className = 'today-task-link';
        const title = document.createElement('span'); title.textContent = item.title;
        const when = document.createElement('small'); when.textContent = [dateLabel(item, today), item.dueTime].filter(Boolean).join(' · ');
        link.append(title, when); li.append(link); target.append(li);
      }
      const moreId = id === 'today-urgent' ? 'today-urgent-more' : 'today-upcoming-more';
      showText(moreId, items.length > limit ? `另外还有 ${items.length - limit} 项，请打开小本本查看。` : '');
    }
    function renderStockGroup(host: HTMLElement, label: string, rows: string[]) {
      if (!rows.length) return;
      const group = document.createElement('section'); group.className = 'today-stock-group';
      const header = document.createElement('h3'); header.textContent = label; group.append(header);
      const list = document.createElement('ul'); list.className = 'today-list';
      for (const text of rows.slice(0, 4)) {
        const li = document.createElement('li'); li.textContent = text; list.append(li);
      }
      if (rows.length > 4) {
        const li = document.createElement('li'); li.className = 'today-muted'; li.textContent = `还有 ${rows.length - 4} 项…`; list.append(li);
      }
      group.append(list); host.append(group);
    }
    function render() {
      const now = Date.now();
      const today = notebookLocalDateKey(now);
      const date = document.getElementById('today-date')!;
      date.textContent = new Intl.DateTimeFormat('zh-CN', { month: 'long', day: 'numeric', weekday: 'long' }).format(new Date(now));
      if (!connectedUid) { dashboard.hidden = true; return; }
      updateSourceStatus();
      const summary = buildTodaySummary(meal ?? normalizeHouseholdState(null), notebook ?? normalizeNotebookState(null), catalog, now);
      dashboard.hidden = false;
      renderTasks('today-upcoming', summary.upcoming, '未来七天暂无到期事项。', today, 6);
      renderTasks('today-urgent', summary.urgent, '目前没有紧急或临近截止的事项。', today, 6);
      const mealStatus = summary.meal?.status === 'cooking' ? '已经开始做饭' : summary.meal?.status === 'ready' ? '已选好这顿饭' : '正在点菜';
      showText('today-meal-status', summary.meal ? mealStatus : '目前没有已选的菜。');
      const dishes = document.getElementById('today-meal-dishes')!;
      dishes.replaceChildren();
      for (const name of summary.meal?.dishes ?? []) {
        const li = document.createElement('li'); li.textContent = name; dishes.append(li);
      }
      showText('today-meal-note', summary.meal?.note ? `整顿备注：${summary.meal.note}` : '');
      showText('today-meal-queue', summary.queuedMeals ? `还有 ${summary.queuedMeals} 顿等待结算。` : '');
      const stock = document.getElementById('today-stock')!;
      stock.replaceChildren();
      renderStockGroup(stock, '临期优先使用', summary.expiring.map((item) => `${item.name} · ${item.quantity} 份 · 最早 ${item.ageDays} 天`));
      renderStockGroup(stock, '库存份数偏多', summary.highStock.map((item) => `${item.name} · ${item.quantity} 份`));
      renderStockGroup(stock, '正在化冻', summary.thawing.map((item) => `${item.name} · ${item.quantity} 份 · ${item.readyAt <= now ? '已可转冷藏' : new Intl.DateTimeFormat('zh-CN', { month: 'numeric', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(item.readyAt)}`));
      if (!stock.childElementCount) stock.textContent = '目前没有需要优先处理的库存或化冻任务。';
      if (session) showAuth(session!.getStatus());
    }
    function stopListening() {
      stopMeal?.(); stopNotebook?.(); stopMeal = undefined; stopNotebook = undefined;
      connectedUid = ''; meal = null; notebook = null; dashboard.hidden = true;
      dataError = ''; sourceErrors.state = ''; sourceErrors.notebook = '';
    }
    function setPushState(enabled: boolean | null, message = '') {
      const denied = preview ? preview.push.denied : todayPushAvailable() && Notification.permission === 'denied';
      const available = preview ? preview.push.available : todayPushAvailable();
      const configured = preview ? preview.push.configured : Boolean(config.webPushPublicKey);
      pushEnable.hidden = enabled !== false || !available || !configured || denied;
      pushDisable.hidden = enabled !== true;
      pushCheck.hidden = enabled !== null || !message;
      pushStatus.textContent = message || (enabled ? '此设备已开启家庭通知。' : !configured
        ? '通知服务尚未配置完成，今日看板仍可正常使用。'
        : denied ? '通知权限已关闭。请在浏览器或手机设置中允许 FamilyHub 通知，再重新打开此页。'
        : available ? '在此设备开启点菜变化和到期提醒。' : '此浏览器暂不支持通知。iPhone 请从 Safari 添加到主屏幕后再开启。');
    }
    const isCurrentMember = (uid: string | undefined) => session?.getStatus().connection === 'connected' && session!.getStatus().uid === uid;
    function checkPushState() {
      const uid = session?.getStatus().uid;
      if (!session || !uid) return;
      if (!(preview ? preview.push.available : todayPushAvailable())) { setPushState(false); return; }
      setPushState(null);
      pushStatus.textContent = '正在检查设备通知状态…';
      void (preview ? preview.push.check() : todayPushIsEnabled(session, base)).then((enabled) => {
        if (isCurrentMember(uid)) {
          setPushState(enabled);
          if (preview?.push.action === 'enable') pushEnable.click();
          if (preview?.push.action === 'disable') pushDisable.click();
        }
      }).catch(() => {
        if (isCurrentMember(uid)) setPushState(null, '暂时无法确认通知状态，请重新检查。');
      });
    }
    pushCheck.addEventListener('click', checkPushState);
    pushEnable.addEventListener('click', () => {
      if (!session) return;
      const uid = session!.getStatus().uid;
      pushEnable.disabled = true;
      pushStatus.textContent = '正在开启通知，请确认通知权限…';
      void (preview ? preview.push.enable() : enableTodayPush(session, config.webPushPublicKey ?? '', base)).then(() => { if (isCurrentMember(uid)) setPushState(true); })
        .catch(() => { if (isCurrentMember(uid)) setPushState(false, Notification.permission === 'denied' ? '通知权限已关闭，请在浏览器或手机设置中允许 FamilyHub 通知。' : '开启通知失败，请重试。'); })
        .finally(() => { pushEnable.disabled = false; });
    });
    pushDisable.addEventListener('click', () => {
      if (!session) return;
      const uid = session!.getStatus().uid;
      pushDisable.disabled = true;
      pushStatus.textContent = '正在关闭此设备的通知…';
      void (preview ? preview.push.disable() : disableTodayPush(session, base)).then(() => { if (isCurrentMember(uid)) setPushState(false); })
        .catch(() => { if (isCurrentMember(uid)) setPushState(true, '关闭通知失败，请重试。'); })
        .finally(() => { pushDisable.disabled = false; });
    });
    function showAuth(status: HouseholdSessionStatus) {
      loginButton.hidden = !(status.connection === 'signed-out' || (status.connection === 'error' && !status.email));
      refreshButton.hidden = !(status.connection === 'pending' || (status.connection === 'error' && Boolean(status.email)));
      logoutButton.hidden = !status.email;
      retryButton.hidden = status.connection !== 'connected' || !dataError;
      document.getElementById('today-connection')!.dataset.state = status.connection === 'error' || dataError ? 'error' : status.connection;
      authMessage.textContent = errorMessage || (status.connection === 'connected'
        ? dataError || (status.networkConnected === false ? '连接暂时中断，正在自动重连；显示上次读取的内容。' : mealLoading || notebookLoading ? '正在读取家庭数据…' : '家庭数据已同步')
        : status.error || status.label);
      pushPanel.hidden = status.connection !== 'connected';
      if (status.connection !== 'connected' || !status.uid) {
        pushCheckedUid = '';
        if (connectedUid) stopListening();
        return;
      }
      if (pushCheckedUid !== status.uid) {
        pushCheckedUid = status.uid;
        checkPushState();
      }
      if (connectedUid === status.uid) return;
      stopListening(); connectedUid = status.uid;
      listenToData();
    }
    function updateSourceStatus() {
      dataError = Object.values(sourceErrors).filter(Boolean).join(' ');
      document.querySelectorAll<HTMLElement>('[data-source]').forEach((card) => {
        const source = card.dataset.source as 'state' | 'notebook';
        const ready = source === 'state' ? Boolean(meal) : Boolean(notebook);
        const loading = source === 'state' ? mealLoading : notebookLoading;
        card.dataset.ready = String(ready);
        const panel = card.querySelector<HTMLElement>('.today-source-status')!;
        panel.hidden = !loading && !sourceErrors[source];
        panel.querySelector('p')!.textContent = sourceErrors[source] || (source === 'state' ? '正在读取点菜与库存…' : '正在读取小本本…');
        panel.querySelector<HTMLButtonElement>('button')!.hidden = !sourceErrors[source];
      });
    }
    function listenToData(source?: 'state' | 'notebook') {
      const uid = connectedUid;
      for (const key of source ? [source] : ['state', 'notebook'] as const) {
        if (key === 'state') { stopMeal?.(); mealLoading = true; } else { stopNotebook?.(); notebookLoading = true; }
        sourceErrors[key] = '';
        const success = (value: unknown) => {
          if (!isCurrentMember(uid)) return;
          if (key === 'state') { meal = normalizeHouseholdState(value, catalog.ingredients); mealLoading = false; }
          else { notebook = normalizeNotebookState(value); notebookLoading = false; }
          sourceErrors[key] = ''; render();
        };
        const failure = () => {
          if (!isCurrentMember(uid)) return;
          if (key === 'state') mealLoading = false; else notebookLoading = false;
          sourceErrors[key] = key === 'state' ? '点菜状态读取失败，请重新读取家庭数据。' : '小本本读取失败，请重新读取家庭数据。';
          render();
        };
        const stop = preview ? preview.listen(key, success, failure) : onValue(ref(session!.database, `households/${config.householdId}/${key}`), (snapshot) => success(snapshot.val()), failure);
        if (key === 'state') stopMeal = stop; else stopNotebook = stop;
      }
      render();
    }
    const retrySource = (source?: 'state' | 'notebook') => {
      if (!session || !connectedUid) return;
      preview?.retry(); errorMessage = ''; listenToData(source); showAuth(session!.getStatus());
    };
    retryButton.addEventListener('click', () => retrySource());
    document.querySelectorAll<HTMLButtonElement>('[data-retry-source]').forEach((button) => button.addEventListener('click', () => retrySource(button.dataset.retrySource as 'state' | 'notebook')));
    function runAuth(button: HTMLButtonElement, action: () => Promise<void>, message: string) {
      if (!session || button.disabled) return;
      button.disabled = true; errorMessage = '';
      authMessage.textContent = message;
      void action().catch(() => {
        errorMessage = session!.getStatus().error || '操作失败，请重试。'; showAuth(session!.getStatus());
      }).finally(() => { button.disabled = false; });
    }
    loginButton.addEventListener('click', () => runAuth(loginButton, () => session!.signInWithGoogle(), '正在打开 Google 登录…'));
    refreshButton.addEventListener('click', () => runAuth(refreshButton, () => session!.refreshAccess(), '正在重新检查家庭权限…'));
    logoutButton.addEventListener('click', () => {
      if (!session) return;
      runAuth(logoutButton, async () => {
        try { await (preview ? preview.push.disable() : disableTodayPush(session!, base)); } finally { await session!.signOut(); }
      }, '正在关闭此设备通知并退出登录…');
    });
    if (import.meta.env.DEV && mockRequested) {
      void import('../dev/householdMock.ts').then(({ createTodayMock }) => {
        preview = createTodayMock(catalog.ingredients, catalog.recipes);
        session = preview.session; session.subscribe(showAuth);
      });
    } else if (session) {
      session.subscribe(showAuth);
      void session.ready.catch((error: Error) => { errorMessage = error.message; showAuth(session!.getStatus()); });
    } else {
      document.getElementById('today-connection')!.dataset.state = 'error';
      authMessage.textContent = 'FamilyHub 的 Firebase 配置不完整，无法读取私人家庭数据。';
    }
    const refreshAtMidnight = () => {
      window.setTimeout(() => { render(); refreshAtMidnight(); }, Math.max(1000, notebookNextLocalMidnight() - Date.now() + 100));
    };
    refreshAtMidnight();
    document.addEventListener('visibilitychange', () => { if (!document.hidden) render(); });
  </script>
</BaseLayout>
