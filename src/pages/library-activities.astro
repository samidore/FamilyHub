---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FilterShell from '../components/FilterShell.astro';
import LibraryEventCard from '../modules/library-activities/LibraryEventCard.astro';
import { libraryEvents } from '../data/catalog';
const days = [...new Set([...libraryEvents].sort((a, b) => a.dayOrder - b.dayOrder).map((event) => event.day))];
const ages = [...new Set(libraryEvents.map((event) => event.ageGroup))];
const eventCount = libraryEvents.length;
---
<BaseLayout title="Library Activities | Family Hub" description="查看 Fair Lawn 当前 library 儿童活动，并区分 2 岁适龄与年龄待确认状态。" pageClass="module-page theme-lake" themeColor="#E7F0F3">
  <SiteHeader eyebrow="出行与玩乐 · Fair Lawn" title="Library Activities" description="只看 Maurice M. Pine Library 当前或即将举行的儿童活动；明确不适合 2 岁的排除，官网未公开年龄的保留并标记待确认。" accent="lake" icon="calendar">
    <div class="summary-row"><span id="event-total">{eventCount} 个当前活动</span><span>Fair Lawn only</span><span>2 岁适龄优先</span></div>
  </SiteHeader>

  <FilterShell accent="lake" filterId="event-filter-panel" countId="event-count" clearId="event-clear" countText={`显示 ${eventCount} / ${eventCount} 个活动`}>
    <div slot="primary" class="filter-primary__grid">
      <label><span>搜索活动</span><input id="event-search" type="search" placeholder="storytime、音乐、手工…" autocomplete="off" /></label>
      <label><span>排序</span><select id="event-sort" data-default="schedule"><option value="schedule">日期与时间</option><option value="drive">最短车程</option></select></label>
    </div>
    <div slot="filters" class="contents">
      <label><span>星期</span><select id="event-day"><option value="">全部日期</option>{days.map((item) => <option value={item}>{item}</option>)}</select></label>
      <label><span>年龄状态</span><select id="event-age"><option value="">全部年龄</option>{ages.map((item) => <option value={item}>{item}</option>)}</select></label>
      <label><span>活动类型</span><select id="event-type"><option value="">全部类型</option><option value="story">Storytime</option><option value="movement">音乐与运动</option><option value="craft">手工</option><option value="play">自由玩耍</option><option value="other">其他</option></select></label>
      <label><span>报名方式</span><select id="event-registration"><option value="">全部方式</option><option value="drop-in">无需预先报名 / 先到先得</option><option value="registration">需要报名或确认</option></select></label>
    </div>
  </FilterShell>

  <main id="main-content" class="shell listing-main">
    <div id="event-list" class="event-list">{libraryEvents.map((event) => <LibraryEventCard event={event} />)}</div>
    <div id="event-empty" class="empty-state" hidden={eventCount > 0}>
      <p>这里暂时没有尚未过期的 Fair Lawn 儿童活动。</p>
      <p><a class="button button--secondary" href="https://www.fairlawnlibrary.org/children" target="_blank" rel="noopener noreferrer">查看官方儿童活动页</a></p>
    </div>
  </main>
  <footer class="module-footer"><div class="shell note-box"><strong>年龄未知的当前活动也会保留。</strong> Registration、居民资格、年龄限制、时间、地点和取消安排会变化；官网没有公开的字段明确标记待确认，不做推测。</div></footer>

  <script>
    import { bindListState, clearListState, restoreListState } from '../lib/listState';
    const cards = [...document.querySelectorAll<HTMLElement>('[data-event]')];
    const controls = {
      q: document.querySelector<HTMLInputElement>('#event-search')!,
      sort: document.querySelector<HTMLSelectElement>('#event-sort')!,
      day: document.querySelector<HTMLSelectElement>('#event-day')!,
      age: document.querySelector<HTMLSelectElement>('#event-age')!,
      type: document.querySelector<HTMLSelectElement>('#event-type')!,
      registration: document.querySelector<HTMLSelectElement>('#event-registration')!,
    };
    const list = document.querySelector<HTMLElement>('#event-list')!;
    const count = document.querySelector<HTMLElement>('#event-count')!;
    const total = document.querySelector<HTMLElement>('#event-total')!;
    const empty = document.querySelector<HTMLElement>('#event-empty')!;
    const number = (card: HTMLElement, key: string) => Number(card.dataset[key]);
    const fairLawnDate = () => {
      const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
      const value = (type: Intl.DateTimeFormatPartTypes) => parts.find((part) => part.type === type)?.value ?? '';
      return `${value('year')}-${value('month')}-${value('day')}`;
    };
    const schedule = (a: HTMLElement, b: HTMLElement) => (a.dataset.startDate || '9999-12-31').localeCompare(b.dataset.startDate || '9999-12-31') || number(a, 'timeOrder') - number(b, 'timeOrder') || number(a, 'dayOrder') - number(b, 'dayOrder');
    const render = () => {
      const query = controls.q.value.trim().toLocaleLowerCase();
      const today = fairLawnDate();
      const active = cards.filter((card) => !card.dataset.endDate || card.dataset.endDate >= today);
      const visible = active.filter((card) => (!query || card.dataset.search!.includes(query)) && (!controls.day.value || card.dataset.day === controls.day.value) && (!controls.age.value || card.dataset.age === controls.age.value) && (!controls.type.value || card.dataset.type === controls.type.value) && (!controls.registration.value || card.dataset.registration === controls.registration.value));
      const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = { schedule, drive: (a, b) => number(a, 'drive') - number(b, 'drive') || schedule(a, b) };
      cards.forEach((card) => card.hidden = !visible.includes(card));
      visible.sort(sorters[controls.sort.value]).forEach((card) => list.append(card));
      count.textContent = `显示 ${visible.length} / ${active.length} 个活动`;
      total.textContent = `${active.length} 个当前活动`;
      empty.hidden = visible.length > 0;
    };
    restoreListState(controls);
    if (Object.values(controls).slice(2).some((control) => control.value)) document.querySelector<HTMLDetailsElement>('.filter-disclosure')!.open = true;
    bindListState(controls, render);
    document.querySelector('#event-clear')!.addEventListener('click', () => clearListState(controls, render));
    render();
  </script>
</BaseLayout>
