---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const configuredSite = import.meta.env.PUBLIC_NOVEL_SITE_URL?.trim();
const privateSite = configuredSite?.startsWith('https://') ? `${configuredSite.replace(/\/+$/, '')}/` : null;
const privateRepo = 'https://github.com/leahthemule/novel-knowledge-base/blob/main/novels/maritime-story/compiled/';
const targets = [
  { title: '小说总入口', description: '从小说进入人物、设定、事件和带段号原文。', href: privateSite ?? `${privateRepo}INDEX.md` },
  { title: '事件目录', description: '每个事件独立一页，按 E-ID 查看事件及对应原文。', href: privateSite ? `${privateSite}events/` : `${privateRepo}events/INDEX.md` },
  { title: '故事时间线', description: '按故事发生顺序回顾，并保留不确定和并行的事件。', href: privateSite ? `${privateSite}CHRONOLOGY/` : `${privateRepo}CHRONOLOGY.md` },
];
---
<BaseLayout title="小离总周报 · Family Hub" description="私人小说知识库入口；小说正文不包含在公开的 FamilyHub 页面中。" pageClass="novel-archive-page">
  <SiteHeader eyebrow="Novel Archivist" title="小离总周报" description="从小说知识库查看人物、事件、时间线、伏笔与原文。" accent="lake" icon="notebook" />
  <main id="main-content" class="shell novel-archive-main">
    <section class="novel-archive-intro">
      <h2>小说知识库</h2>
      <p>一个小说有自己的总入口；每个事件有独立页面。事件中的章节段落引用可以继续打开原文核验。</p>
      <p class="novel-archive-note">小说正文和故事记忆存放在独立私有仓库，不会进入 FamilyHub 的公开网页。当前入口使用{privateSite ? '受限私人站点' : 'GitHub 私有仓库'}登录。</p>
    </section>
    <div class="novel-archive-links">
      {targets.map((target) => <a class="novel-archive-link" href={target.href} target="_blank" rel="noopener noreferrer" data-private-novel-link>
        <span><strong>{target.title}</strong><span>{target.description}</span></span>
        <span aria-hidden="true">↗</span>
      </a>)}
    </div>
    <p class="novel-archive-back"><a href={withBase('/')}>← 返回 Family Hub</a></p>
  </main>
  <style>
    .novel-archive-main { padding-block: 30px 72px; }
    .novel-archive-intro { max-width: 780px; }
    .novel-archive-intro h2 { margin: 0 0 8px; font-size: 31px; }
    .novel-archive-intro p { margin: 0 0 18px; }
    .novel-archive-note { color: var(--muted); }
    .novel-archive-links { display: grid; gap: 13px; max-width: 800px; margin-top: 26px; }
    .novel-archive-link { display: flex; min-height: 100px; align-items: center; justify-content: space-between; gap: 20px; border: 1px solid var(--line); border-radius: 14px; padding: 17px 20px; background: var(--surface); color: var(--ink); text-decoration: none; box-shadow: var(--shadow); }
    .novel-archive-link > span:first-child { display: grid; gap: 4px; }
    .novel-archive-link strong { font-size: 23px; }
    .novel-archive-link span span { color: var(--muted); font-size: 16px; }
    .novel-archive-link > span:last-child { color: var(--lake); font-size: 25px; }
    .novel-archive-link:hover { border-color: var(--lake); }
    .novel-archive-back { margin: 30px 0 0; }
    .novel-archive-back a { display: inline-flex; align-items: center; min-height: 48px; color: var(--lake); font-weight: 700; }
  </style>
</BaseLayout>
