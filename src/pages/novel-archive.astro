---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { novelViews } from '../lib/novelArchiveRoute.ts';
import '../styles/novelTimeline.css';
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---
<BaseLayout title="小离总周报 · Family Hub" description="仅家庭成员可访问的小说故事记忆、人物、事件、时间线与章节原文。" pageClass="novel-archive-page">
  <SiteHeader eyebrow="小离总周报" title="小离总周报" titleId="novel-book-title" description="小说故事记忆 · 人物与关系 · 时间线 · 事件与原文" accent="lake" icon="notebook" />
  <main id="main-content" class="shell novel-shell">
    <section id="novel-auth" class="novel-auth">
      <h2>私人小说知识库</h2>
      <p id="novel-auth-message" aria-live="polite">正在检查家庭登录状态…</p>
      <div class="novel-auth-actions">
        <button id="novel-sign-in" type="button" hidden>使用 Google 登录</button>
        <button id="novel-refresh-access" type="button" hidden>重新检查权限</button>
        <button id="novel-sign-out" type="button" hidden>退出登录</button>
      </div>
      <p class="novel-muted">与 Sami 小本本使用同一组家庭成员权限。小说正文不会出现在公开的页面源码中。</p>
    </section>

    <section id="novel-app" hidden>
      <div class="novel-toolbar">
        <label for="novel-book-select">选择小说</label>
        <select id="novel-book-select" aria-label="选择小说"></select>
        <p id="novel-scope" class="novel-muted"></p>
      </div>

      <nav class="novel-views" id="novel-views" aria-label="视图">
        {novelViews.map((view) => <a href="#" data-novel-view={view.id}>{view.label}</a>)}
      </nav>
      <p id="novel-live" class="novel-muted" role="status" aria-live="polite"></p>

      <div id="novel-reader-view">
        <nav class="novel-section-nav" id="novel-nav" aria-label="小说知识库导航"></nav>

        <form id="novel-search-form" class="novel-search-form">
          <label for="novel-search">搜索小说知识库</label>
          <div class="novel-search-row">
            <input id="novel-search" type="search" placeholder="人物、事件、伏笔、原文…" autocomplete="off" />
            <button type="submit">搜索</button>
          </div>
        </form>
        <div id="novel-results" class="novel-search-results" aria-live="polite"></div>

        <div class="novel-reader">
          <h2 id="novel-page-title"></h2>
          <article id="novel-content" class="novel-content"></article>
        </div>
      </div>
      <div id="novel-timeline-view" hidden></div>
    </section>
    <p class="novel-home"><a href={withBase('/')}>← 返回 Family Hub</a></p>
  </main>
  <script>
    import { mountNovelArchive } from '../lib/novelArchiveUi.ts';
    mountNovelArchive({
      apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
      authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
      projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
      databaseURL: import.meta.env.PUBLIC_FIREBASE_DATABASE_URL,
      storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
      messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
      appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
      householdId: import.meta.env.PUBLIC_FAMILY_HOUSEHOLD_ID,
    });
  </script>
  <style>
    .novel-shell { padding-block: 28px 70px; }
    .novel-auth, .novel-toolbar, .novel-reader { border: 1px solid var(--line); border-radius: 16px; background: var(--surface); padding: 22px; }
    .novel-auth { max-width: 720px; }
    .novel-auth h2 { margin: 0 0 8px; font-size: 28px; }
    .novel-auth p { margin: 7px 0 17px; }
    .novel-auth-actions { display: flex; flex-wrap: wrap; gap: 10px; }
    button { min-height: 48px; border: 0; border-radius: 10px; background: var(--lake); color: white; padding: 10px 17px; font-weight: 700; cursor: pointer; }
    button:hover { filter: brightness(.94); }
    .novel-muted { color: var(--muted); font-size: 16px; }
    .novel-toolbar label, .novel-search-form label { display: block; margin-bottom: 7px; color: var(--muted); font-size: 16px; font-weight: 700; }
    .novel-toolbar select, .novel-search-row input { width: 100%; min-height: 50px; border: 1px solid var(--line); border-radius: 10px; padding: 9px 12px; background: #fff; color: var(--ink); }
    .novel-toolbar select { font-size: 19px; }
    .novel-toolbar p { margin: 8px 0 0; }
    .novel-views { display: flex; gap: 6px; margin-top: 18px; padding: 5px; width: fit-content; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); scroll-margin-top: 8px; }
    .novel-views a { display: inline-flex; align-items: center; min-height: 48px; padding: 7px 20px; border-radius: 9px; color: #23495c; text-decoration: none; font-size: 17px; font-weight: 700; }
    .novel-views a[aria-current='page'] { background: var(--lake); color: white; }
    #novel-live:empty { display: none; }
    #novel-timeline-view { margin-top: 14px; }
    .novel-section-nav { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 18px; }
    .novel-section-nav :global(a) { display: inline-flex; align-items: center; min-height: 48px; padding: 7px 14px; background: var(--lake-soft); color: #23495c; border-radius: 10px; text-decoration: none; font-size: 16px; font-weight: 700; }
    .novel-search-form { max-width: 820px; margin-top: 23px; }
    .novel-search-row { display: flex; gap: 10px; }
    .novel-search-row input { min-width: 0; flex: 1; }
    .novel-search-results { display: grid; gap: 7px; max-width: 900px; margin-top: 12px; }
    .novel-search-results :global(a) { display: block; padding: 9px 12px; border: 1px solid var(--line); border-radius: 9px; background: white; color: var(--lake); text-decoration: none; }
    .novel-search-results :global(small) { display: block; margin-top: 3px; color: var(--muted); line-height: 1.5; }
    .novel-reader { margin-top: 14px; min-width: 0; }
    .novel-reader > h2 { margin: 0 0 14px; overflow-wrap: anywhere; font-size: clamp(27px, 5vw, 38px); line-height: 1.25; }
    .novel-content { overflow-wrap: anywhere; line-height: 1.78; }
    .novel-content :global(h1), .novel-content :global(h2), .novel-content :global(h3), .novel-content :global(h4) { margin: 1.1em 0 .4em; line-height: 1.35; }
    .novel-content :global(h1) { font-size: 27px; }
    .novel-content :global(h2) { font-size: 24px; }
    .novel-content :global(h3) { font-size: 21px; }
    .novel-content :global(p) { margin: 12px 0; }
    .novel-content :global(a) { color: #23627f; text-underline-offset: 3px; }
    .novel-content :global(li) { margin-block: 5px; }
    .novel-content :global(table), .novel-content :global(pre) { display: block; max-width: 100%; overflow-x: auto; }
    .novel-content :global(td), .novel-content :global(th) { padding: 8px; border: 1px solid var(--line); text-align: left; }
    .novel-content :global(blockquote) { margin-inline: 0; padding-left: 15px; border-left: 3px solid var(--line); }
    .novel-content :global([id]) { scroll-margin-top: 18px; }
    .novel-home { margin-top: 25px; }
    .novel-home a { display: inline-flex; min-height: 48px; align-items: center; color: var(--lake); font-weight: 700; }
    @media (max-width: 540px) {
      .novel-auth, .novel-toolbar, .novel-reader { padding: 16px; }
      .novel-search-row button { padding-inline: 12px; }
      .novel-section-nav { gap: 7px; }
      .novel-section-nav :global(a) { font-size: 14px; padding-inline: 10px; }
    }
  </style>
</BaseLayout>
