---
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../styles/global.css';
import MealInventoryImport from '../components/MealInventoryImport.astro';
import MealBuilderNavigationEnhancements from '../components/MealBuilderNavigationEnhancements.astro';
import MealBuilderCompositionEnhancements from '../components/MealBuilderCompositionEnhancements.astro';
import MealBuilderFreshnessEnhancements from '../components/MealBuilderFreshnessEnhancements.astro';
interface Props { title: string; description: string; pageClass?: string; themeColor?: string; }
const { title, description, pageClass = '', themeColor = '#F4F6F1' } = Astro.props;
const showMealInventoryImport = pageClass.split(/\s+/).includes('meal-builder-page');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <slot />
    {showMealInventoryImport && <MealInventoryImport />}
    {showMealInventoryImport && <MealBuilderNavigationEnhancements />}
    {showMealInventoryImport && <MealBuilderCompositionEnhancements />}
    {showMealInventoryImport && <MealBuilderFreshnessEnhancements />}
    <script>
      const mealNext = document.querySelector<HTMLButtonElement>('#meal-next');
      const mealForceNext = document.querySelector<HTMLButtonElement>('#meal-force-next');
      mealNext?.addEventListener('click', (event) => {
        if (mealNext.disabled || !mealForceNext || mealForceNext.disabled) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        mealForceNext.click();
      }, true);
    </script>
  </body>
</html>