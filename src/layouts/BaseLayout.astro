---
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../styles/global.css';
import MealInventoryImport from '../components/MealInventoryImport.astro';
import MealBuilderNavigationEnhancements from '../components/MealBuilderNavigationEnhancements.astro';
import MealBuilderCompositionEnhancements from '../components/MealBuilderCompositionEnhancements.astro';
import MealBuilderRecipeSelectionEnhancements from '../components/MealBuilderRecipeSelectionEnhancements.astro';
import MealBuilderFreshnessEnhancements from '../components/MealBuilderFreshnessEnhancements.astro';
import MealBuilderCheckoutQueueEnhancements from '../components/MealBuilderCheckoutQueueEnhancements.astro';
import MealBuilderInventoryLayoutEnhancements from '../components/MealBuilderInventoryLayoutEnhancements.astro';
interface Props { title: string; description: string; pageClass?: string; themeColor?: string; }
const { title, description, pageClass = '', themeColor = '#F4F6F1' } = Astro.props;
const appBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const appManifest = `${appBase}manifest.webmanifest`;
const showMealInventoryImport = pageClass.split(/\s+/).includes('meal-builder-page');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="FamilyHub" />
    <link rel="manifest" href={appManifest} />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <slot />
    {showMealInventoryImport && <MealInventoryImport />}
    {showMealInventoryImport && <MealBuilderNavigationEnhancements />}
    {showMealInventoryImport && <MealBuilderCompositionEnhancements />}
    {showMealInventoryImport && <MealBuilderRecipeSelectionEnhancements />}
    {showMealInventoryImport && <MealBuilderFreshnessEnhancements />}
    {showMealInventoryImport && <MealBuilderCheckoutQueueEnhancements />}
    {showMealInventoryImport && <MealBuilderInventoryLayoutEnhancements />}
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const appBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
          void navigator.serviceWorker.register(`${appBase}sw.js`, { scope: appBase }).catch(() => {
            // The site stays usable if service workers are unavailable.
          });
        });
      }
    </script>
    <script>
      const mealNext = document.querySelector<HTMLButtonElement>('#meal-next');
      const mealForceNext = document.querySelector<HTMLButtonElement>('#meal-force-next');
      mealNext?.addEventListener('click', (event) => {
        if (mealNext.disabled || !mealForceNext || mealForceNext.disabled) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        mealForceNext.click();
      }, true);

      const mealLive = document.querySelector<HTMLElement>('#meal-live');
      const announceMealGuard = (text: string) => {
        if (!mealLive) return;
        mealLive.textContent = '';
        requestAnimationFrame(() => { mealLive.textContent = text; });
      };
      document.addEventListener('click', (event) => {
        const alert = document.querySelector<HTMLElement>('#meal-queue-alert');
        if (!alert || alert.hidden) return;
        const target = event.target as HTMLElement;
        const reset = target.closest<HTMLButtonElement>('#meal-inventory-reset');
        if (reset) {
          event.preventDefault();
          event.stopImmediatePropagation();
          announceMealGuard('有待结算主料，不能清空库存。请先完成排队结算。');
          return;
        }
        const toggle = target.closest<HTMLButtonElement>('[data-inventory-toggle]');
        if (!toggle) return;
        const row = toggle.closest<HTMLElement>('[data-inventory-item]');
        if (!row?.querySelector('[data-queue-reservation-copy]')) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        announceMealGuard('这份主材料正在等待结算，不能从库存关闭。');
      }, true);
    </script>
  </body>
</html>